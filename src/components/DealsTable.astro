---
import { DIFFICULTY_META, PAYMENT_META, isCnFriendly, type DealCuration } from '../data/deal-curation'

interface Row {
  id: string
  provider: string
  product: string
  price: string
  url?: string | null
  category: string
  curation: DealCuration
}

interface Props {
  items: Row[]
  catLabel: (c: string) => string
  /** 当前排序键：difficulty | price | payment | provider */
  sort: string
  /** 给定排序键生成 URL（会保留 view / cat，并把 page 重置为 1）。 */
  hrefForSort: (sort: string) => string
}

const { items, catLabel, sort, hrefForSort } = Astro.props

const columns = [
  { key: 'provider', label: '厂商', sortable: true },
  { key: 'product', label: '产品', sortable: false },
  { key: 'category', label: '分类', sortable: false },
  { key: 'difficulty', label: '难度', sortable: true },
  { key: 'payment', label: '支付方式', sortable: true },
  { key: 'price', label: '价格', sortable: true },
  { key: 'action', label: '', sortable: false },
]

const payText = (c: DealCuration): string => {
  if (c.freeNoCard) return '🆓 免费 · 无需绑卡'
  if (!c.payments || c.payments.length === 0) return '—'
  return c.payments.map(p => `${PAYMENT_META[p].icon} ${PAYMENT_META[p].label}`).join(' · ')
}
---

<div class="table-wrap">
  <table class="deals-table">
    <thead>
      <tr>
        {columns.map(col => (
          <th class:list={[`col-${col.key}`, col.sortable && 'sortable']}>
            {col.sortable ? (
              <a
                class:list={['th-link', sort === col.key && 'is-active']}
                href={hrefForSort(col.key)}
                rel="nofollow"
              >
                {col.label}
                <span class="th-arrow">{sort === col.key ? '▾' : '↕'}</span>
              </a>
            ) : (
              col.label
            )}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {items.map(deal => (
        <tr class:list={[deal.curation.supplement && 'is-supplement', deal.curation.reference && 'is-reference']}>
          <td class="col-provider">
            <span class="td-provider">{deal.provider}</span>
          </td>
          <td class="col-product">
            {deal.url ? (
              <a href={deal.url} target="_blank" rel="noopener nofollow">{deal.product}</a>
            ) : (
              deal.product
            )}
            {deal.curation.supplement && <span class="mini-chip">🧩 补充</span>}
            {deal.curation.reference && <span class="mini-chip ref">📊 标准价</span>}
          </td>
          <td class="col-category"><span class="mini-chip">{catLabel(deal.category)}</span></td>
          <td class="col-difficulty">
            {deal.curation.reference ? (
              <span class="td-muted">—</span>
            ) : (
              <span class:list={['diff-chip', deal.curation.difficulty]}>
                {DIFFICULTY_META[deal.curation.difficulty].icon}
                {DIFFICULTY_META[deal.curation.difficulty].label}
              </span>
            )}
          </td>
          <td class:list={['col-payment', isCnFriendly(deal.curation.payments) && 'is-cn']}>
            {payText(deal.curation)}
          </td>
          <td class="col-price"><span class="td-price">{deal.price}</span></td>
          <td class="col-action">
            {deal.url && (
              <a class="row-go" href={deal.url} target="_blank" rel="noopener nofollow" title="前往官网">↗</a>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .deals-table {
    width: 100%; border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .deals-table th {
    text-align: left; white-space: nowrap;
    padding: 0.5rem 0.625rem;
    font-size: 0.6875rem; font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    position: sticky; top: 0;
    background: var(--bg, transparent);
  }
  .deals-table th.sortable { padding: 0; }
  .th-link {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.5rem 0.625rem;
    color: var(--text-muted); font-size: 0.6875rem; font-weight: 600;
    transition: color 0.15s;
  }
  .th-link:hover { color: var(--text); }
  .th-link.is-active { color: var(--primary); }
  .th-arrow { opacity: 0.5; font-size: 0.625rem; }
  .th-link.is-active .th-arrow { opacity: 1; }

  .deals-table td {
    padding: 0.5rem 0.625rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .deals-table tbody tr:hover { background: var(--surface); }
  .deals-table tbody tr.is-supplement { background: rgba(255,159,10,0.04); }
  .deals-table tbody tr.is-reference { background: rgba(120,120,128,0.05); }

  .td-provider { font-weight: 600; color: var(--text); }
  .col-product a { color: var(--text); }
  .col-product a:hover { color: var(--primary); }
  .td-price { font-weight: 600; color: var(--text); white-space: nowrap; }
  .td-muted { color: var(--text-muted); }

  .col-payment { color: var(--text-muted); white-space: nowrap; font-size: 0.75rem; }
  .col-payment.is-cn { color: #1a8f3c; }
  .col-price { white-space: nowrap; }

  .mini-chip {
    display: inline-block; margin-left: 0.375rem;
    padding: 0.0625rem 0.375rem; border-radius: 999px;
    font-size: 0.625rem; color: var(--text-muted);
    background: var(--surface); border: 1px solid var(--glass-border);
    white-space: nowrap;
  }
  .mini-chip.ref { color: var(--text-secondary); }

  .diff-chip {
    display: inline-flex; align-items: center; gap: 0.1875rem;
    padding: 0.0625rem 0.375rem; border-radius: 999px;
    font-size: 0.625rem; white-space: nowrap;
  }
  .diff-chip.easy { color: #1a8f3c; background: rgba(48,209,88,0.1); }
  .diff-chip.medium { color: #b26a00; background: rgba(255,159,10,0.12); }
  .diff-chip.hard { color: #c0392b; background: rgba(255,69,58,0.1); }

  .col-action { width: 2.25rem; text-align: center; }
  .row-go {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.5rem; height: 1.5rem; border-radius: var(--radius-sm);
    color: var(--text-muted); border: 1px solid var(--glass-border);
    transition: all 0.15s;
  }
  .row-go:hover { color: var(--primary); border-color: var(--primary); }

  @media (max-width: 768px) {
    .deals-table { font-size: 0.75rem; }
    .col-category, .col-difficulty { display: none; }
    .deals-table th, .deals-table td { padding: 0.4375rem 0.5rem; }
  }
</style>
