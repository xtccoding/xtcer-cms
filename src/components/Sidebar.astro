---
const { active } = Astro.props
---

<button class="sidebar-toggle" id="sidebar-toggle" aria-label="菜单">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
</button>
<aside class="sidebar glass-card" id="sidebar">
  <div class="sidebar-brand"><a href="/" class="nav-logo">XTCer</a></div>
  <nav class="sidebar-nav">
    <a href="/admin/dashboard" class={`sidebar-link ${active === 'posts' ? 'active' : ''}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      文章
    </a>
    <a href="/admin/links" class={`sidebar-link ${active === 'links' ? 'active' : ''}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
      导航
    </a>
    <a href="/admin/visitors" class={`sidebar-link ${active === 'visitors' ? 'active' : ''}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      访客
    </a>
    <a href="/admin/deals" class={`sidebar-link ${active === 'deals' ? 'active' : ''}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      优惠
    </a>
    <a href="/admin/feeds" class={`sidebar-link ${active === 'feeds' ? 'active' : ''}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 11a9 9 0 019 9M4 4a16 16 0 0116 16"/><circle cx="5" cy="19" r="1"/></svg>
      情报
    </a>
    <div class="sidebar-divider"></div>
    <a href="/admin/new" class="sidebar-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14m-7-7h14"/></svg>
      新建文章
    </a>
    <a href="/admin" class="sidebar-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      设置
    </a>
    <a href="/admin/logout" class="sidebar-link logout">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4m7 14l5-5-5-5m5 5H9"/></svg>
      退出
    </a>
  </nav>
</aside>

<script>
  const toggle = document.getElementById('sidebar-toggle')
  const sidebar = document.getElementById('sidebar')
  
  toggle?.addEventListener('click', () => {
    sidebar?.classList.toggle('open')
    toggle.classList.toggle('active')
  })

  document.addEventListener('click', (e) => {
    if (sidebar?.classList.contains('open') && !sidebar.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
      sidebar.classList.remove('open')
      toggle?.classList.remove('active')
    }
  })
</script>

<style>
  .sidebar {
    width: 200px; flex-shrink: 0; padding: 1.5rem 0.75rem;
    position: fixed; top: 0; bottom: 0; left: 0;
    border-radius: 0; border-left: none; border-top: none; border-bottom: none;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px);
    display: flex; flex-direction: column;
    z-index: 100;
  }
  .sidebar-brand { padding: 0 0.375rem; margin-bottom: 2rem; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 0.125rem; flex: 1; }
  .sidebar-link { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.625rem; border-radius: var(--radius-sm); color: var(--text-muted); font-size: 0.8125rem; transition: all 0.15s; }
  .sidebar-link:hover { color: var(--text); background: var(--surface); }
  .sidebar-link.active { color: var(--primary); background: rgba(41,151,255,0.08); }
  .sidebar-divider { height: 1px; background: var(--border); margin: 0.5rem 0; }
  .sidebar-link.logout { color: var(--red); margin-top: auto; }
  .sidebar-link.logout:hover { background: rgba(255,69,58,0.08); }
  
  .sidebar-toggle {
    display: none;
    position: fixed; top: 0.75rem; left: 0.75rem; z-index: 101;
    width: 40px; height: 40px; border-radius: var(--radius-sm);
    background: var(--surface); border: 1px solid var(--glass-border);
    color: var(--text-muted); cursor: pointer;
    align-items: center; justify-content: center;
    transition: all 0.2s;
  }
  .sidebar-toggle:hover { color: var(--text); background: var(--surface-hover); }
  .sidebar-toggle.active { color: var(--primary); background: rgba(41,151,255,0.08); border-color: rgba(41,151,255,0.2); }

  :root.light .sidebar {
    background: rgba(255,255,255,0.8);
  }

  @media (max-width: 768px) {
    .sidebar { 
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .sidebar-toggle { display: flex; }
  }
</style>
