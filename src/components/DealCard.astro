---
import {
  DIFFICULTY_META,
  TLD_TAG_META,
  PAYMENT_META,
  isCnFriendly,
  type DealCuration,
} from '../data/deal-curation'

interface Deal {
  provider: string
  product: string
  price: string
  price_cny?: number | null
  config?: string | null
  bandwidth?: string | null
  region?: string | null
  url?: string | null
  notes?: string | null
  type?: string | null
  expiry?: string | null
  category: string
  curation: DealCuration
}

interface Props {
  deal: Deal
  categoryLabel: string
}

const { deal, categoryLabel } = Astro.props
---

<div class="deal-card glass-card" data-cat={deal.category} data-diff={deal.curation.difficulty}>
  <div class="deal-header">
    <span class="deal-provider">{deal.provider}</span>
    <span class="deal-badges">
      {deal.curation.difficulty !== 'easy' && (
        <span class:list={['diff-chip', deal.curation.difficulty]}>
          {DIFFICULTY_META[deal.curation.difficulty].icon}
          {DIFFICULTY_META[deal.curation.difficulty].label}
        </span>
      )}
      <span class="deal-badge">{categoryLabel}</span>
    </span>
  </div>
  <h3 class="deal-product">
    {deal.url ? <a href={deal.url} target="_blank" rel="noopener">{deal.product}</a> : deal.product}
  </h3>
  <div class="deal-price">
    <span class="price-value">{deal.price}</span>
    {deal.price_cny ? <span class="price-cny">≈ ¥{deal.price_cny}</span> : null}
  </div>
  <div class="deal-specs">
    {deal.config && <span class="spec">🖥 {deal.config}</span>}
    {deal.bandwidth && <span class="spec">📡 {deal.bandwidth}</span>}
    {deal.region && <span class="spec">🌍 {deal.region}</span>}
  </div>

  {deal.curation.payments && deal.curation.payments.length > 0 && (
    <div class="pay-row">
      {isCnFriendly(deal.curation.payments) && <span class="pay-cn">国内友好</span>}
      {deal.curation.payments.map(p => (
        <span class:list={['pay-chip', isCnFriendly([p]) ? 'cn' : 'intl']}>
          <span class="pay-icon">{PAYMENT_META[p].icon}</span>
          {PAYMENT_META[p].label}
        </span>
      ))}
    </div>
  )}

  {deal.curation.tlds && deal.curation.tlds.length > 0 && (
    <div class="tld-block">
      <div class="tld-hot">
        {deal.curation.tlds
          .filter(t => t.tag === 'hot')
          .slice(0, 4)
          .map(t => (
            <span class="tld-chip">
              <code>{t.tld}</code>
              <span class="tld-chip-price">{t.price}</span>
            </span>
          ))}
      </div>
      <details class="tld-details">
        <summary>
          查看全部 {deal.curation.tlds.length} 个后缀价格
          （含 {deal.curation.tlds.filter(t => t.tag === 'promo' || t.tag === 'cheap').length} 个首年低价）
        </summary>
        <table class="tld-table">
          <tbody>
            {deal.curation.tlds.map(t => (
              <tr>
                <td class="tld-name"><code>{t.tld}</code></td>
                <td class="tld-tag">
                  {t.tag && (
                    <span class:list={['tag', TLD_TAG_META[t.tag].cls]}>
                      {TLD_TAG_META[t.tag].label}
                    </span>
                  )}
                </td>
                <td class="tld-price-cell">
                  <span>{t.price}</span>
                  {t.note && <span class="tld-note">{t.note}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {deal.curation.tldNote && <p class="tld-foot">{deal.curation.tldNote}</p>}
      </details>
    </div>
  )}

  {deal.curation.promo && (
    <button class="promo-chip" data-code={deal.curation.promo} title="点击复制优惠码">
      🎁 优惠码 <code>{deal.curation.promo}</code>
      <span class="promo-copy">复制</span>
    </button>
  )}
  {deal.curation.promoNote && <p class="promo-note">{deal.curation.promoNote}</p>}

  {deal.curation.warning && <p class="deal-warning">⚠️ {deal.curation.warning}</p>}

  {deal.curation.limits && deal.curation.limits.length > 0 && (
    <div class="deal-limits">
      <div class="limits-head">⛔ 限制 / 雷点</div>
      <ul>
        {deal.curation.limits.map(l => <li>{l}</li>)}
      </ul>
    </div>
  )}

  {deal.notes && <p class="deal-notes">{deal.notes}</p>}

  {deal.curation.tips && deal.curation.tips.length > 0 && (
    <ul class="deal-tips">
      {deal.curation.tips.map(tip => <li>{tip}</li>)}
    </ul>
  )}

  <div class="deal-footer">
    <div class="deal-footer-left">
      {deal.type && <span class="deal-type">{deal.type}</span>}
      {deal.expiry && <span class="deal-expiry">截止: {deal.expiry}</span>}
    </div>
    {deal.curation.tutorialUrl && (
      <a class="tutorial-link" href={deal.curation.tutorialUrl}>注册教程 →</a>
    )}
  </div>
</div>

<style>
  .deal-card {
    padding: 0.875rem 1rem; display: flex; flex-direction: column; gap: 0.4375rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .deal-card:hover { transform: translateY(-2px); }
  .deal-card[data-diff='hard'] { border-left: 3px solid var(--orange); }

  .deal-header { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .deal-provider { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .deal-badges { display: flex; align-items: center; gap: 0.375rem; flex-shrink: 0; }
  .diff-chip {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 600; white-space: nowrap;
  }
  .diff-chip.medium { background: rgba(255,204,0,0.12); color: #b8860b; border: 1px solid rgba(255,204,0,0.3); }
  .diff-chip.hard { background: rgba(255,90,60,0.1); color: #d94a2b; border: 1px solid rgba(255,90,60,0.28); }
  .deal-badge {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 500;
    background: rgba(41,151,255,0.08); color: var(--primary);
    border: 1px solid rgba(41,151,255,0.15);
  }

  .deal-product { font-size: 0.9375rem; font-weight: 600; line-height: 1.35; }
  .deal-product a { color: var(--text); }
  .deal-product a:hover { color: var(--primary); }

  .deal-price { display: flex; align-items: baseline; gap: 0.4375rem; }
  .price-value { font-size: 1.125rem; font-weight: 700; color: var(--green); }
  .price-cny { font-size: 0.75rem; color: var(--text-muted); }

  .deal-specs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .spec { font-size: 0.75rem; color: var(--text-secondary); }

  /* ---- 支付方式徽标 ---- */
  .pay-row { display: flex; flex-wrap: wrap; gap: 0.3125rem; align-items: center; }
  .pay-cn {
    padding: 0.125rem 0.4375rem; border-radius: 999px;
    font-size: 0.625rem; font-weight: 700; letter-spacing: 0.02em;
    background: rgba(52,199,89,0.14); color: #1a8f3c;
    border: 1px solid rgba(52,199,89,0.32);
  }
  .pay-chip {
    display: inline-flex; align-items: center; gap: 0.1875rem;
    padding: 0.125rem 0.4375rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 500;
    border: 1px solid var(--glass-border);
    background: var(--surface); color: var(--text-secondary);
  }
  .pay-chip.cn { border-color: rgba(52,199,89,0.3); color: #1a8f3c; background: rgba(52,199,89,0.06); }
  .pay-chip.intl { color: var(--text-muted); }
  .pay-icon { font-size: 0.625rem; line-height: 1; }

  /* ---- 限制 / 雷点 ---- */
  .deal-limits {
    padding: 0.375rem 0.625rem; border-radius: var(--radius-sm);
    background: rgba(255,90,60,0.06); border-left: 2px solid #d94a2b;
  }
  .limits-head { font-size: 0.6875rem; font-weight: 700; color: #d94a2b; margin-bottom: 0.25rem; }
  .deal-limits ul {
    margin: 0; padding-left: 0.9375rem;
    display: flex; flex-direction: column; gap: 0.1875rem;
  }
  .deal-limits li { font-size: 0.6875rem; color: var(--text-secondary); line-height: 1.45; }

  /* ---- TLD pricing ---- */
  .tld-block { display: flex; flex-direction: column; gap: 0.5rem; }
  .tld-hot { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .tld-chip {
    display: inline-flex; align-items: baseline; gap: 0.3125rem;
    padding: 0.1875rem 0.5rem; border-radius: var(--radius-sm);
    background: rgba(41,151,255,0.05); border: 1px solid var(--glass-border);
    font-size: 0.6875rem;
  }
  .tld-chip code { font-weight: 700; color: var(--text); }
  .tld-chip-price { color: var(--text-muted); }

  .tld-details { border-top: 1px dashed var(--border); padding-top: 0.5rem; }
  .tld-details > summary {
    cursor: pointer; font-size: 0.75rem; font-weight: 600; color: var(--primary);
    list-style: none; user-select: none;
  }
  .tld-details > summary::-webkit-details-marker { display: none; }
  .tld-details > summary::before { content: '▸ '; }
  .tld-details[open] > summary::before { content: '▾ '; }
  .tld-details > summary:hover { text-decoration: underline; }

  .tld-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
  .tld-table tr { border-bottom: 1px solid var(--border); }
  .tld-table tr:last-child { border-bottom: none; }
  .tld-table td { padding: 0.3125rem 0; vertical-align: middle; font-size: 0.6875rem; }
  .tld-name code { font-weight: 700; color: var(--text); }
  .tld-tag { width: 2.75rem; }
  .tld-price-cell { text-align: right; color: var(--text-secondary); }
  .tld-price-cell > span:first-child { display: block; }
  .tld-note { display: block; color: var(--text-muted); font-size: 0.625rem; margin-top: 0.0625rem; }

  .tag {
    display: inline-block; padding: 0.0625rem 0.375rem; border-radius: 999px;
    font-size: 0.5625rem; font-weight: 600; white-space: nowrap;
  }
  .tag.hot { background: rgba(255,90,60,0.1); color: #d94a2b; }
  .tag.promo { background: rgba(41,151,255,0.1); color: var(--primary); }
  .tag.cheap { background: rgba(52,199,89,0.12); color: #1a8f3c; }

  .tld-foot {
    margin-top: 0.5rem; font-size: 0.625rem; line-height: 1.5; color: var(--text-muted);
    padding: 0.4375rem 0.625rem; background: rgba(255,255,255,0.02);
    border-radius: var(--radius-sm);
  }

  .promo-chip {
    display: flex; align-items: center; gap: 0.5rem; width: 100%;
    padding: 0.375rem 0.625rem; border-radius: var(--radius-sm);
    background: rgba(41,151,255,0.06); border: 1px dashed rgba(41,151,255,0.35);
    color: var(--text); font-size: 0.75rem; cursor: pointer; text-align: left;
    transition: background 0.15s, border-color 0.15s;
  }
  .promo-chip:hover { background: rgba(41,151,255,0.12); border-color: var(--primary); }
  .promo-chip code { font-weight: 700; color: var(--primary); letter-spacing: 0.03em; }
  .promo-copy { margin-left: auto; font-size: 0.6875rem; color: var(--text-muted); }
  .promo-note { font-size: 0.6875rem; color: var(--text-muted); line-height: 1.5; }

  .deal-warning {
    font-size: 0.75rem; color: var(--text-secondary); line-height: 1.5;
    padding: 0.375rem 0.625rem; background: rgba(255,159,10,0.06);
    border-radius: var(--radius-sm); border-left: 2px solid var(--orange);
  }

  .deal-notes {
    font-size: 0.75rem; color: var(--text-muted); line-height: 1.5;
    padding: 0.375rem 0.625rem; background: rgba(255,255,255,0.02);
    border-radius: var(--radius-sm); border-left: 2px solid var(--primary);
  }

  .deal-tips { margin: 0; padding-left: 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .deal-tips li { font-size: 0.6875rem; color: var(--text-muted); line-height: 1.4; }

  .deal-footer {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    margin-top: auto; padding-top: 0.5rem; border-top: 1px solid var(--border);
  }
  .deal-footer-left { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .deal-type { font-size: 0.6875rem; color: var(--text-muted); }
  .deal-expiry { font-size: 0.6875rem; color: var(--orange); }
  .tutorial-link { font-size: 0.75rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
  .tutorial-link:hover { text-decoration: underline; }
</style>
