---
import {
  DIFFICULTY_META,
  TLD_TAG_META,
  PAYMENT_META,
  isCnFriendly,
  type DealCuration,
} from '../data/deal-curation'
import { FREEBIE_META, type FreebieInfo } from '../lib/freebie'

interface Deal {
  id: string
  provider: string
  product: string
  price: string
  price_cny?: number | null
  config?: string | null
  bandwidth?: string | null
  region?: string | null
  url?: string | null
  notes?: string | null
  type?: string | null
  expiry?: string | null
  category: string
  curation: DealCuration
}

interface Props {
  deal: Deal
  categoryLabel: string
  /** 免费判定结果（由页面统一算好传入）；不传则按付费卡渲染。 */
  freebie?: FreebieInfo
  /** 该卡片的点赞数，由 deals.astro 一次性拉取后传入，避免每张卡各发一次请求。 */
  likeCount?: number
  /**
   * 点赞功能是否就绪（表已建 + 盐已配置）。默认 false ——
   * 宁可少渲染，也不渲染一个点了没反应的「死按钮」。
   */
  likesEnabled?: boolean
  /**
   * 是否渲染「收藏 / 标记已领」按钮。
   * 按钮只是静态标记，真实登录态由客户端向 /api/user/summary 水合 ——
   * 这样 /deals 的公共边缘缓存不会被某个用户的收藏状态污染。
   */
  userActions?: boolean
}

const { deal, categoryLabel, freebie, likeCount = 0, likesEnabled = false, userActions = false } = Astro.props
---

<div class="deal-card glass-card" data-cat={deal.category} data-diff={deal.curation.difficulty} data-free={freebie?.kind} data-ref={deal.curation.reference ? 'true' : undefined} data-supplement={deal.curation.supplement ? 'true' : undefined}>
  <div class="deal-header">
    <span class="deal-provider">{deal.provider}</span>
    <span class="deal-badges">
      {freebie?.isFree && freebie.kind && (
        <span class:list={['free-chip', FREEBIE_META[freebie.kind].cls]}>
          {FREEBIE_META[freebie.kind].icon} {FREEBIE_META[freebie.kind].label}
        </span>
      )}
      {deal.curation.reference && <span class="ref-chip">📊 标准价</span>}
      {deal.curation.supplement && <span class="supp-chip">🧩 补充 · 买赠</span>}
      {deal.curation.difficulty !== 'easy' && !deal.curation.reference && (
        <span class:list={['diff-chip', deal.curation.difficulty]}>
          {DIFFICULTY_META[deal.curation.difficulty].icon}
          {DIFFICULTY_META[deal.curation.difficulty].label}
        </span>
      )}
      <span class="deal-badge">{categoryLabel}</span>
    </span>
  </div>
  <h3 class="deal-product">
    {deal.url ? <a href={deal.url} target="_blank" rel="noopener">{deal.product}</a> : deal.product}
  </h3>
  <div class="deal-price">
    {freebie?.kind === 'full' ? (
      <>
        <span class="price-free">¥0</span>
        {deal.price !== '免费' && <span class="price-orig">{deal.price}</span>}
      </>
    ) : (
      <>
        <span class="price-value">{deal.price}</span>
        {deal.price_cny ? <span class="price-cny">≈ ¥{deal.price_cny}</span> : null}
      </>
    )}
  </div>
  <div class="deal-specs">
    {deal.config && <span class="spec">🖥 {deal.config}</span>}
    {deal.bandwidth && <span class="spec">📡 {deal.bandwidth}</span>}
    {deal.region && <span class="spec">🌍 {deal.region}</span>}
  </div>

  {deal.curation.perf && (
    <p class="deal-perf">⚡ <strong>性能机型</strong>{deal.curation.perf}</p>
  )}

  {deal.curation.pros && deal.curation.pros.length > 0 && (
    <div class="pros-row">
      {deal.curation.pros.map(p => <span class="pro-chip">✓ {p}</span>)}
    </div>
  )}

  {deal.curation.compare && deal.curation.compare.length > 0 && (
    <div class="compare-block">
      <div class="compare-head">
        📊 同规格大厂价
        {deal.curation.compareNote && <span class="compare-note">{deal.curation.compareNote}</span>}
      </div>
      <ul>
        {deal.curation.compare.map(c => (
          <li>
            <span class="compare-vendor">{c.vendor}</span>
            <span class="compare-config">{c.config}</span>
            <span class="compare-price">{c.price}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {deal.curation.freeNoCard ? (
    <div class="pay-row">
      <span class="pay-free">🆓 完全免费 · 无需绑卡</span>
    </div>
  ) : (
    deal.curation.payments &&
    deal.curation.payments.length > 0 && (
      <div class="pay-row">
        {isCnFriendly(deal.curation.payments) && <span class="pay-cn">国内友好</span>}
        {deal.curation.payments.map(p => (
          <span class:list={['pay-chip', isCnFriendly([p]) ? 'cn' : 'intl']}>
            <span class="pay-icon">{PAYMENT_META[p].icon}</span>
            {PAYMENT_META[p].label}
          </span>
        ))}
      </div>
    )
  )}

  {deal.curation.tlds && deal.curation.tlds.length > 0 && (
    <div class="tld-block">
      <div class="tld-hot">
        {deal.curation.tlds
          .filter(t => t.tag === 'hot')
          .slice(0, 4)
          .map(t => (
            <span class="tld-chip">
              <code>{t.tld}</code>
              <span class="tld-chip-price">{t.price}</span>
            </span>
          ))}
      </div>
      <details class="tld-details">
        <summary>
          查看全部 {deal.curation.tlds.length} 个后缀价格
          （含 {deal.curation.tlds.filter(t => t.tag === 'promo' || t.tag === 'cheap').length} 个首年低价）
        </summary>
        <table class="tld-table">
          <tbody>
            {deal.curation.tlds.map(t => (
              <tr>
                <td class="tld-name"><code>{t.tld}</code></td>
                <td class="tld-tag">
                  {t.tag && (
                    <span class:list={['tag', TLD_TAG_META[t.tag].cls]}>
                      {TLD_TAG_META[t.tag].label}
                    </span>
                  )}
                </td>
                <td class="tld-price-cell">
                  <span>{t.price}</span>
                  {t.note && <span class="tld-note">{t.note}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {deal.curation.tldNote && <p class="tld-foot">{deal.curation.tldNote}</p>}
      </details>
    </div>
  )}

  {deal.curation.promo && (
    <button class="promo-chip" data-code={deal.curation.promo} title="点击复制优惠码">
      🎁 优惠码 <code>{deal.curation.promo}</code>
      <span class="promo-copy">复制</span>
    </button>
  )}
  {deal.curation.promoNote && <p class="promo-note">{deal.curation.promoNote}</p>}

  {deal.curation.warning && <p class="deal-warning">⚠️ {deal.curation.warning}</p>}

  {deal.curation.limits && deal.curation.limits.length > 0 && (
    <div class="deal-limits">
      <div class="limits-head">⛔ 限制 / 雷点</div>
      <ul>
        {deal.curation.limits.map(l => <li>{l}</li>)}
      </ul>
    </div>
  )}

  {deal.notes && <p class="deal-notes">{deal.notes}</p>}

  {deal.curation.tips && deal.curation.tips.length > 0 && (
    <ul class="deal-tips">
      {deal.curation.tips.map(tip => <li>{tip}</li>)}
    </ul>
  )}

  <div class="deal-footer">
    <div class="deal-footer-left">
      {deal.type && <span class="deal-type">{deal.type}</span>}
      {deal.expiry && <span class="deal-expiry">截止: {deal.expiry}</span>}
    </div>
    <div class="deal-footer-right">
      {freebie?.isFree && deal.url && (
        <a class="claim-btn" href={deal.url} target="_blank" rel="noopener">去领取 →</a>
      )}
      {deal.curation.tutorialUrl && (
        <a class="tutorial-link" href={deal.curation.tutorialUrl}>注册教程 →</a>
      )}
      {userActions && deal.id && (
        <>
          <button
            type="button"
            class="fav-btn"
            data-fav-id={deal.id}
            data-fav="false"
            aria-pressed="false"
            title="收藏这个福利">☆ 收藏</button>
          <button
            type="button"
            class="claim-mark-btn"
            data-claim-id={deal.id}
            data-claimed="false"
            title="领过之后点一下，方便以后核对续期">标记已领</button>
        </>
      )}
      {likesEnabled && deal.id && (
        <button
          type="button"
          class="like-btn"
          data-target={deal.id}
          data-liked="false"
          title="这条优惠有用吗？">
          <span class="like-icon" aria-hidden="true">👍</span>
          <span class="like-label">有用</span>
          <span class="like-count" data-count>{likeCount}</span>
        </button>
      )}
    </div>
  </div>
</div>

<script>
  // 点赞：事件委托，一次性处理页面内所有卡片。
  // 数字更新只用 textContent（不用 innerHTML），杜绝 XSS。
  // 表不存在时后端返回 { disabled: true }，此处静默隐藏按钮，不报错、不白屏。
  document.addEventListener('click', async (event) => {
    const el = event.target as HTMLElement | null
    const btn = el?.closest?.('.like-btn') as HTMLButtonElement | null
    if (!btn) return
    if (btn.dataset.busy === 'true' || btn.dataset.liked === 'true') return

    const target = btn.dataset.target
    if (!target) return

    btn.dataset.busy = 'true'
    btn.disabled = true
    try {
      const res = await fetch('/api/likes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ target }),
      })
      if (!res.ok) throw new Error('request failed')

      const data = await res.json()
      if (data?.disabled) {
        btn.style.display = 'none'
        return
      }

      const countEl = btn.querySelector('.like-count')
      if (countEl) {
        countEl.textContent = String(typeof data.count === 'number' ? data.count : 0)
      }
      btn.dataset.liked = 'true'
      btn.classList.add('liked')
    } catch {
      // 静默失败：保持原状，不弹错、不破坏页面。
    } finally {
      btn.dataset.busy = 'false'
      if (btn.dataset.liked !== 'true') btn.disabled = false
    }
  })
</script>

<script>
  // 收藏 / 标记已领：状态由 /api/user/summary 水合（页面本身是公共缓存的）。
  // 所有文案更新只用 textContent，用户输入不参与 HTML 拼接。
  type AccountState = 'unknown' | 'guest' | 'user'

  let accountState: AccountState = 'unknown'
  let accountLoading: Promise<void> | null = null
  const favorited = new Set<string>()
  const claimed = new Set<string>()

  const toast = (message: string, type: 'success' | 'error' | 'info' = 'success') => {
    ;(window as any).showToast?.(message, type)
  }

  function paintAccountButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-fav-id]').forEach((btn) => {
      const id = btn.dataset.favId || ''
      const on = favorited.has(id)
      btn.dataset.fav = on ? 'true' : 'false'
      btn.setAttribute('aria-pressed', on ? 'true' : 'false')
      btn.classList.toggle('active', on)
      btn.textContent = on ? '★ 已收藏' : '☆ 收藏'
    })
    document.querySelectorAll<HTMLButtonElement>('[data-claim-id]').forEach((btn) => {
      const id = btn.dataset.claimId || ''
      const on = claimed.has(id)
      btn.dataset.claimed = on ? 'true' : 'false'
      btn.classList.toggle('active', on)
      btn.textContent = on ? '已领 ✓' : '标记已领'
      btn.disabled = on
    })
  }

  async function hydrateAccount() {
    if (accountState !== 'unknown') return
    if (accountLoading) return accountLoading

    accountLoading = (async () => {
      if (!document.querySelector('[data-fav-id]')) {
        accountState = 'guest'
        return
      }
      try {
        const res = await fetch('/api/user/summary')
        if (!res.ok) {
          accountState = 'guest'
          return
        }
        const data = await res.json()
        for (const id of data?.favoriteIds || []) favorited.add(String(id))
        for (const id of data?.claimIds || []) claimed.add(String(id))
        accountState = 'user'
        paintAccountButtons()
      } catch {
        accountState = 'guest'
      }
    })()

    return accountLoading
  }

  function gotoLogin() {
    const next = location.pathname + location.search
    location.href = `/login?next=${encodeURIComponent(next)}`
  }

  document.addEventListener('click', async (event) => {
    const el = event.target as HTMLElement | null
    const favBtn = el?.closest?.('.fav-btn') as HTMLButtonElement | null
    const claimBtn = el?.closest?.('.claim-mark-btn') as HTMLButtonElement | null
    if (!favBtn && !claimBtn) return

    if (accountState === 'unknown') await hydrateAccount()
    if (accountState === 'guest') return gotoLogin()

    if (favBtn) {
      const dealId = favBtn.dataset.favId
      if (!dealId || favBtn.dataset.busy === 'true') return
      favBtn.dataset.busy = 'true'
      const next = !favorited.has(dealId)
      try {
        const res = await fetch('/api/user/favorite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dealId, favorited: next }),
        })
        const data = await res.json().catch(() => ({}))
        if (!res.ok) {
          toast(typeof data?.error === 'string' ? data.error : '收藏失败', 'error')
          return
        }
        if (next) favorited.add(dealId)
        else favorited.delete(dealId)
        paintAccountButtons()
        toast(next ? '已加入收藏，可在「我的」查看' : '已取消收藏', 'info')
        const badges = Array.isArray(data?.newBadges) ? data.newBadges : []
        if (badges.length) toast(`解锁徽章 ${badges[0].icon}${badges[0].name}`, 'success')
      } catch {
        toast('网络异常，稍后再试', 'error')
      } finally {
        favBtn.dataset.busy = 'false'
      }
      return
    }

    if (claimBtn) {
      const dealId = claimBtn.dataset.claimId
      if (!dealId || claimBtn.dataset.claimed === 'true' || claimBtn.dataset.busy === 'true') return
      claimBtn.dataset.busy = 'true'
      try {
        const res = await fetch('/api/user/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dealId }),
        })
        const data = await res.json().catch(() => ({}))
        if (!res.ok) {
          toast(typeof data?.error === 'string' ? data.error : '操作失败', 'error')
          return
        }
        claimed.add(dealId)
        paintAccountButtons()
        toast(
          data?.awarded ? `已标记 · +${data.awarded} 积分` : '已标记为领取过',
          'success',
        )
        const badges = Array.isArray(data?.newBadges) ? data.newBadges : []
        if (badges.length) toast(`解锁徽章 ${badges[0].icon}${badges[0].name}`, 'success')
      } catch {
        toast('网络异常，稍后再试', 'error')
      } finally {
        claimBtn.dataset.busy = 'false'
      }
    }
  })

  hydrateAccount()
</script>

<style>
  .deal-card {
    padding: 0.875rem 1rem; display: flex; flex-direction: column; gap: 0.4375rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .deal-card:hover { transform: translateY(-2px); }
  .deal-card[data-diff='hard'] { border-left: 3px solid var(--orange); }

  .deal-header { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .deal-provider { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .deal-badges { display: flex; align-items: center; gap: 0.375rem; flex-shrink: 0; }
  .diff-chip {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 600; white-space: nowrap;
  }
  .diff-chip.medium { background: rgba(255,204,0,0.12); color: #b8860b; border: 1px solid rgba(255,204,0,0.3); }
  .diff-chip.hard { background: rgba(255,90,60,0.1); color: #d94a2b; border: 1px solid rgba(255,90,60,0.28); }
  .deal-badge {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 500;
    background: color-mix(in srgb, var(--primary) 8%, transparent);
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent);
  }

  /* ---- 免费徽标：完全免费用绿色、额度用主色、试用用橙色 ---- */
  .free-chip {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 700; white-space: nowrap;
    color: var(--green);
    background: color-mix(in srgb, var(--green) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--green) 38%, transparent);
  }
  .free-chip.quota {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    border-color: color-mix(in srgb, var(--primary) 32%, transparent);
  }
  .free-chip.trial {
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 12%, transparent);
    border-color: color-mix(in srgb, var(--orange) 34%, transparent);
  }

  .deal-product { font-size: 0.9375rem; font-weight: 600; line-height: 1.35; }
  .deal-product a { color: var(--text); }
  .deal-product a:hover { color: var(--primary); }

  .deal-price { display: flex; align-items: baseline; gap: 0.4375rem; }
  .price-value { font-size: 1.125rem; font-weight: 700; color: var(--green); }
  .price-cny { font-size: 0.75rem; color: var(--text-muted); }
  /* 完全免费：¥0 放大，原价文案作注脚 */
  .price-free { font-size: 1.375rem; font-weight: 800; color: var(--green); line-height: 1; }
  .price-orig { font-size: 0.75rem; color: var(--text-muted); }

  .deal-specs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .spec { font-size: 0.75rem; color: var(--text-secondary); }

  /* ---- 标准价参考卡 ---- */
  .ref-chip {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 600; white-space: nowrap;
    background: rgba(120,120,128,0.12); color: var(--text-secondary);
    border: 1px solid var(--glass-border);
  }
  /* 补充权益卡（买其他送域名）：现在混在主列表里分页，靠这枚徽标自证身份 */
  .supp-chip {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 600; white-space: nowrap;
    background: rgba(255,159,10,0.12); color: #b26a00;
    border: 1px solid rgba(255,159,10,0.3);
  }
  .deal-card[data-supplement='true'] { border-left: 3px solid rgba(255,159,10,0.5); }
  /* 参考卡不是优惠，价格不用「便宜绿」，避免误读成好价 */
  .deal-card[data-ref='true'] { border-left: 3px solid var(--border); }
  .deal-card[data-ref='true'] .price-value { color: var(--text-secondary); }

  /* ---- 性能机型 ---- */
  .deal-perf {
    font-size: 0.6875rem; line-height: 1.45; color: var(--text-secondary);
    padding: 0.3125rem 0.625rem; border-radius: var(--radius-sm);
    background: rgba(41,151,255,0.05); border-left: 2px solid var(--primary);
  }
  .deal-perf strong { color: var(--primary); font-weight: 700; margin-right: 0.3125rem; }

  /* ---- 优势 ---- */
  .pros-row { display: flex; flex-wrap: wrap; gap: 0.3125rem; }
  .pro-chip {
    padding: 0.125rem 0.4375rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 500;
    background: rgba(52,199,89,0.08); color: #1a8f3c;
    border: 1px solid rgba(52,199,89,0.22);
  }

  /* ---- 同规格大厂价对比 ---- */
  .compare-block {
    padding: 0.375rem 0.625rem; border-radius: var(--radius-sm);
    background: rgba(120,120,128,0.06); border-left: 2px solid var(--border);
  }
  .compare-head {
    font-size: 0.6875rem; font-weight: 700; color: var(--text-secondary);
    margin-bottom: 0.25rem; display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;
  }
  .compare-note { font-weight: 400; font-size: 0.625rem; color: var(--text-muted); }
  .compare-block ul {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 0.1875rem;
  }
  .compare-block li {
    display: flex; align-items: baseline; gap: 0.4375rem;
    font-size: 0.6875rem; color: var(--text-muted);
  }
  .compare-vendor { font-weight: 600; color: var(--text-secondary); flex-shrink: 0; }
  .compare-config { flex: 1; min-width: 0; }
  .compare-price { font-weight: 700; color: var(--text-secondary); flex-shrink: 0; }

  /* ---- 支付方式徽标 ---- */
  .pay-row { display: flex; flex-wrap: wrap; gap: 0.3125rem; align-items: center; }
  .pay-cn {
    padding: 0.125rem 0.4375rem; border-radius: 999px;
    font-size: 0.625rem; font-weight: 700; letter-spacing: 0.02em;
    background: rgba(52,199,89,0.14); color: #1a8f3c;
    border: 1px solid rgba(52,199,89,0.32);
  }
  .pay-chip {
    display: inline-flex; align-items: center; gap: 0.1875rem;
    padding: 0.125rem 0.4375rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 500;
    border: 1px solid var(--glass-border);
    background: var(--surface); color: var(--text-secondary);
  }
  .pay-chip.cn { border-color: rgba(52,199,89,0.3); color: #1a8f3c; background: rgba(52,199,89,0.06); }
