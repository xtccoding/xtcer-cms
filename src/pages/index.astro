---
import Layout from '../layouts/Layout.astro'
import DealCard from '../components/DealCard.astro'
import { listRecentPosts, listLinks, listRecentFeeds, getSetting, countPosts, listDeals } from '../lib/store'
import { resolveFreebie } from '../lib/freebie'
import { resolveCuration } from '../data/deal-curation'
import { catLabel } from '../lib/deal-categories'

// 首页只展示最近的文章。
// ⚠️ 不能全量拉：PostgREST max-rows=1000 会把结果静默截断（文章已 1041 篇），
// 且 posts 正文约 11.8MB，全量拉会拖慢首屏。总数用 countRows 单独取。
//
// ⚡ 性能：以下查询彼此独立，必须用 Promise.all 并发执行。
// 之前是串行 await，每个查询都要等上一个返回（含 Supabase 冷启动），
// 实测 TTFB 1.5–3.5s 且波动大。并发后冷启动 TTFB 可砍掉一半以上。
const [posts, postCount, links, recentFeeds, particlesValue, dealsRaw] = await Promise.all([
  listRecentPosts(6),
  countPosts(),
  listLinks(),
  listRecentFeeds(6),
  getSetting<any>('particles'),
  listDeals({ includeExpired: false }),
])

// ---- 今日可领福利：免费可领的 deal，按「完全免费 → 额度 → 试用」排 ----
const KIND_RANK: Record<string, number> = { full: 0, quota: 1, trial: 2 }
const freebieDeals = (dealsRaw || [])
  .map((d: any) => {
    const curation = resolveCuration(d.provider, d.product)
    return { ...d, curation, freebie: resolveFreebie(d, curation) }
  })
  .filter((d: any) => d.freebie.isFree && !d.curation.reference)
  .sort(
    (a: any, b: any) =>
      (KIND_RANK[a.freebie.kind] ?? 3) - (KIND_RANK[b.freebie.kind] ?? 3) ||
      a.provider.localeCompare(b.provider, 'zh-Hans-CN'),
  )
const todayFreebies = freebieDeals.slice(0, 9)
const freebieTotal = freebieDeals.length
// 首屏统计直接告诉访客「有多少能领」，按免费类型拆开
const countKind = (kind: string) => freebieDeals.filter((d: any) => d.freebie.kind === kind).length
const fullFreeCount = countKind('full')
const quotaFreeCount = countKind('quota')
const trialFreeCount = countKind('trial')

const particlesData = { value: particlesValue }

const particlesConfig = particlesData?.value || {
  mode: 'siri',
  background_particles: { count: 120, size_min: 0.5, size_max: 2, opacity_min: 0.05, opacity_max: 0.35, speed: 0.3, color: '41, 151, 255' },
  siri_wave: { layers: 5, base_radius: 80, layer_spacing: 15, wave_amplitude: 8, wave_frequency: 3, speed: 0.02 },
  single_ring: { radius: 100, wave_amplitude: 12, speed: 0.015, color: '41, 151, 255' },
  double_ring: { radius1: 80, radius2: 120, wave_amplitude: 10, speed: 0.02, color1: '41, 151, 255', color2: '191, 90, 242' },
  mouse_effect: { enabled: true, radius: 40, pulse_speed: 0.03 }
}

const linkCategories = [...new Set(links?.map(l => l.category) || [])]

const typeLabels: Record<string, string> = {
  security: '安全', github_trending: 'GitHub', ai_monetization: 'AI',
  crypto_alpha: '加密', deal_hunt: '捡漏', industry_move: '行业',
  devtool_launch: '工具', learn_alpha: '学习',
}

function stripMarkdown(text: string) {
  return (text || '')
    .replace(/#{1,6}\s/g, '')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\*(.*?)\*/g, '$1')
    .replace(/`{1,3}[^`]*`{1,3}/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[>\-|]/g, '')
    .replace(/\n+/g, ' ')
    .trim()
}
---

<Layout title="XTcer - 技术探索者 | AI情报·安全漏洞·云服务优惠" description="XTcer - 技术探索者，专注前沿技术洞察。AI情报、安全漏洞、云服务优惠、技术深度文章实时推送。Astro + Supabase 构建，极速加载。">
  <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">XTcer</a>
        <div class="nav-links">
          <a href="/deals" class="nav-link">福利</a>
          <a href="/account" class="nav-link">签到</a>
          <a href="/posts" class="nav-link">文章</a>
          <a href="/feeds" class="nav-link">情报</a>
          <button class="nav-search-btn" id="nav-search" title="搜索 (⌘K)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </div>
      </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <!-- Particle Canvas -->
      <canvas id="particles" class="particles-canvas"></canvas>
      <script type="application/json" id="particles-config" set:html={JSON.stringify(particlesConfig)} />
      
      <div class="container">
        <div class="hero-content">
          <!-- Brand Logo -->
          <div class="brand-logo">
            <div class="logo-wrapper">
              <span class="logo-xt">XT</span>
              <span class="logo-cer">cer</span>
            </div>
            <div class="logo-underline"></div>
          </div>
          
          <!-- Tagline -->
          <div class="hero-tagline">
            <span class="tagline-en">Freebies</span>
            <span class="tagline-divider"></span>
            <span class="tagline-cn">免费福利站</span>
          </div>
          
          <!-- Slogan -->
          <h1 class="hero-slogan">
            <span class="slogan-line">免费福利</span>
            <span class="slogan-dot">·</span>
            <span class="slogan-line slogan-gradient">能领先领</span>
          </h1>
          
          <!-- Description -->
          <p class="hero-sub">
            0 元的云服务器、免费额度、AI Token 与限时试用 —— 能领的先领，别急着花钱。
          </p>
          
          <!-- Stats：按「能领的类型」给数字，点进去就是对应筛选 -->
          <div class="hero-stats">
            <a href="/deals?f=full" class="stat-item glass-card">
              <span class="stat-number">{fullFreeCount}</span>
              <span class="stat-label">完全免费</span>
            </a>
            <a href="/deals?f=quota" class="stat-item glass-card">
              <span class="stat-number">{quotaFreeCount}</span>
              <span class="stat-label">免费额度</span>
            </a>
            <a href="/deals?f=trial" class="stat-item glass-card">
              <span class="stat-number">{trialFreeCount}</span>
              <span class="stat-label">限时试用</span>
            </a>
          </div>

          <!-- Actions -->
          <div class="hero-actions">
            <a href="/deals" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              全部 {freebieTotal} 个福利
            </a>
            <a href="/account" class="btn-ghost">
              每日签到
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>

          <!-- 每日开蛋：首屏互动入口。
               用户态由 /api/user/summary 在客户端水合，页面 HTML 保持公共边缘缓存，
               绝不把用户名 / 积分写进会被所有人共享的缓存里。 -->
          <div class="egg-widget" id="egg-widget">
            <button type="button" class="egg-btn" id="egg-btn" aria-label="每日开蛋">
              <span class="egg-emoji" id="egg-emoji">🥚</span>
            </button>
            <div class="egg-body">
              <div class="egg-title" id="egg-title">每日开蛋</div>
              <div class="egg-sub" id="egg-sub">登录后每天敲一颗蛋，连签越多积分越多</div>
            </div>
            <div class="egg-meta">
              <span>积分 <b id="egg-points">—</b></span>
              <span>连签 <b id="egg-streak">—</b></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {todayFreebies.length > 0 && (
      <section class="freebies-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>今天能领的</h2>
            <a href="/deals" class="see-all">全部 {freebieTotal} 个免费福利 →</a>
          </div>
          <p class="freebies-sub">
            按「完全免费 → 免费额度 → 限时试用」排序，先领不花钱的。
          </p>
          <div class="freebies-grid">
            {todayFreebies.map((deal: any) => (
              <DealCard
                deal={deal}
                freebie={deal.freebie}
                categoryLabel={catLabel(deal.category)}
                likeCount={0}
                likesEnabled={false}
                userActions={true}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    {recentFeeds && recentFeeds.length > 0 && (
      <section class="feeds-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>情报流</h2>
            <a href="/feeds" class="see-all">查看全部 →</a>
          </div>
          <div class="feeds-list">
            {recentFeeds.map(feed => (
              <a href={feed.url || '#'} class="feed-row glass-card hover-lift" target={feed.url ? '_blank' : undefined} rel="noopener">
                <span class={`feed-priority ${feed.priority === 'critical' ? 'critical' : 'normal'}`}>
                  {feed.priority === 'critical' ? '🔴' : '🟢'}
                </span>
                <span class="feed-type-badge">{typeLabels[feed.feed_type] || feed.feed_type}</span>
                <span class="feed-title">{feed.title}</span>
                {feed.summary && <span class="feed-summary">{feed.summary}</span>}
                <time class="feed-time">{new Date(feed.published_at || feed.created_at).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</time>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {posts && posts.length > 0 && (
      <section class="posts-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>最新文章</h2>
            <a href="/posts" class="see-all">全部 {postCount} 篇 →</a>
          </div>
          <div class="posts-grid">
            {posts.map((post) => (
              <a href={`/posts/${post.id}`} class="post-card glass-card hover-lift">
                <div class="post-body">
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.summary || stripMarkdown(post.content || '').substring(0, 120)}</p>
                </div>
                <div class="post-footer">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  <span>·</span>
                  <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟</span>
                  {post.views > 0 && <><span>·</span><span>{post.views} 次浏览</span></>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {links && links.length > 0 && (
      <section class="links-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>常用导航</h2>
            <span class="count">{links.length} 个</span>
          </div>
          {linkCategories.map(cat => (
            <div class="link-category">
              <h3 class="cat-label">{cat}</h3>
              <div class="links-grid">
                {links.filter(l => l.category === cat).map(link => (
                  <a href={link.url} target="_blank" rel="noopener" class="link-card glass-card hover-lift">
                    <span class="link-icon">{link.icon || '🔗'}</span>
                    <div>
                      <h4>{link.title}</h4>
                      {link.description && <p>{link.description}</p>}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <span class="logo-xt">XT</span><span class="logo-cer">cer</span>
          </div>
          <span class="footer-slogan">探索前沿，洞见未来</span>
        </div>
        <div class="footer-links">
          <a href="/rss.xml" target="_blank">RSS</a>
          <a href="/tags">标签索引</a>
          <a href="/topics/ai">AI 专区</a>
          <a href="/topics/security">漏洞预警</a>
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
          <a href="/about">关于</a>
          <a href="/contact">联系</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 XTcer - eXploring Tech</span>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Hero Section */
  .hero { 
    padding: clamp(2.5rem, 7vh, 6rem) 0 clamp(2.5rem, 5vh, 4rem); 
    text-align: center; 
    position: relative;
    overflow: hidden;
    /* 长屏下不再无限拉高首屏，避免屏幕越高留白越大 */
    min-height: clamp(420px, 85vh, 760px);
    display: flex;
    align-items: center;
  }
  
  .particles-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  
  /* Brand Logo */
  .brand-logo {
    position: relative;
    display: inline-block;
    margin-bottom: clamp(1.25rem, 3vh, 2.5rem);
    animation: fadeIn 0.8s ease-out;
  }
  
  .logo-wrapper {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0;
    font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
    font-size: clamp(3.25rem, 9vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  
  .logo-xt {
    background: linear-gradient(135deg, #2997ff 0%, #00d4ff 40%, #bf5af2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 4s ease infinite;
  }
  
  .logo-cer {
    color: var(--text);
    opacity: 0.95;
    font-weight: 300;
  }
  
  .logo-underline {
    height: 3px;
    margin-top: 0.75rem;
    background: linear-gradient(90deg, transparent, #2997ff, #bf5af2, #00ffff, transparent);
    border-radius: 2px;
    animation: shimmer 3s ease-in-out infinite;
  }
  
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  @keyframes shimmer {
    0%, 100% { opacity: 0.5; transform: scaleX(0.8); }
    50% { opacity: 1; transform: scaleX(1); }
  }
  
  /* Tagline */
  .hero-tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: clamp(1rem, 2.5vh, 2rem);
    animation: slideUp 0.6s ease-out;
  }
  
  .tagline-en {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 1.25rem;
    font-weight: 550;
    color: var(--text);
    letter-spacing: 0.04em;
    font-variant-ligatures: no-common-ligatures;
  }
  
  .tagline-divider {
    width: 32px;
    height: 1.5px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 1px;
  }
  
  .tagline-cn {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--text-secondary);
    letter-spacing: 0.1em;
  }
  
  /* Slogan */
  .hero-slogan {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: clamp(1rem, 2.5vh, 2rem);
    animation: slideUp 0.7s ease-out;
  }
  
  .slogan-line {
    display: inline;
    color: var(--text);
  }
  
  .slogan-dot {
    display: inline;
    color: var(--primary);
    margin: 0 0.75rem;
    font-weight: 200;
    opacity: 0.8;
  }
  
  .slogan-gradient {
    background: linear-gradient(135deg, #2997ff 0%, #bf5af2 50%, #00ffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 3s ease infinite;
  }
  
  :root.light .slogan-line {
    color: #1d1d1f;
  }
  
  /* Description */
  .hero-sub {
    max-width: 620px;
    margin: 0 auto clamp(1.25rem, 3.5vh, 2.25rem);
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-secondary);
    animation: slideUp 0.8s ease-out;
  }
  
  /* Stats */
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 3.5vh, 3.5rem);
    animation: slideUp 0.9s ease-out;
  }
  
  .stat-item {
    padding: 1.5rem 2rem;
    text-align: center;
    min-width: 140px;
    transition: all 0.3s ease;
    border-radius: 16px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }
  
  .stat-item:hover {
    transform: translateY(-3px);
    border-color: rgba(41,151,255,0.2);
    box-shadow: 0 8px 32px rgba(41,151,255,0.1);
  }
  
  .stat-number {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #2997ff, #bf5af2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }
  
  .stat-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 450;
    letter-spacing: 0.02em;
  }
  
  /* Actions */
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    animation: slideUp 1s ease-out;
  }
  
  .btn-primary, .btn-ghost {
    font-family: 'Inter', sans-serif;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.25rem;
    border-radius: 14px;
    font-size: 0.9375rem;
    font-weight: 550;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #2997ff 0%, #0077ed 100%);
    color: white;
    border: none;
    box-shadow: 0 4px 20px rgba(41,151,255,0.25);
    position: relative;
    overflow: hidden;
  }
  
  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transition: left 0.6s ease;
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(41,151,255,0.35);
    color: white;
  }
  
  .btn-primary:hover::before {
    left: 100%;
  }
  
  .btn-ghost {
    background: rgba(255,255,255,0.02);
    color: var(--text);
    border: 1px solid rgba(255,255,255,0.06);
  }
  
  .btn-ghost:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.12);
    color: var(--text);
    transform: translateY(-2px);
  }
  
  :root.light .btn-ghost {
    background: rgba(0,0,0,0.02);
    border-color: rgba(0,0,0,0.06);
  }
  
  :root.light .btn-ghost:hover {
    background: rgba(0,0,0,0.04);
    border-color: rgba(0,0,0,0.12);
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Section Headers */
  .section-header { 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    margin-bottom: 1.5rem; 
  }
  
  .section-header h2 { 
    font-family: 'Inter', sans-serif;
    font-size: 1.375rem; 
    font-weight: 650; 
    letter-spacing: -0.015em;
  }
  
  .count { 
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem; 
    color: var(--text-muted); 
    padding: 0.375rem 1rem;
    background: rgba(255,255,255,0.02);
    border-radius: 100px;
    border: 1px solid rgba(255,255,255,0.05);
    font-weight: 450;
  }
  
  :root.light .count {
    background: rgba(0,0,0,0.02);
    border-color: rgba(0,0,0,0.05);
  }

  /* Freebies Section —— 首屏第一块：免费可领的福利 */
  .freebies-section { padding: 2.5rem 0 3.5rem; }
  .freebies-sub {
    color: var(--text-muted); font-size: 0.875rem;
    margin: -1rem 0 1.5rem;
  }
  .freebies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(292px, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  /* Links Section */
