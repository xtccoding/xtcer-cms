---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase'

const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false })

const { data: links } = await supabase
  .from('links')
  .select('*')
  .order('sort_order', { ascending: true })

const { data: recentFeeds } = await supabase
  .from('feeds')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(12)

const linkCategories = [...new Set(links?.map(l => l.category) || [])]

const typeLabels: Record<string, string> = {
  security: '安全', github_trending: 'GitHub', ai_monetization: 'AI',
  crypto_alpha: '加密', deal_hunt: '捡漏', industry_move: '行业',
  devtool_launch: '工具', learn_alpha: '学习',
}

function stripMarkdown(text: string) {
  return (text || '')
    .replace(/#{1,6}\s/g, '')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\*(.*?)\*/g, '$1')
    .replace(/`{1,3}[^`]*`{1,3}/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[>\-|]/g, '')
    .replace(/\n+/g, ' ')
    .trim()
}
---

<Layout title="XTCer - 技术内容与云服务情报" description="XTCer - 技术文章、云服务优惠、AI情报、安全漏洞实时推送。Astro + Supabase 构建，极速加载。">
  <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">XTCer</a>
        <div class="nav-links">
          <a href="/deals" class="nav-link">优惠</a>
          <a href="/feeds" class="nav-link">情报</a>
          <button class="nav-search-btn" id="nav-search" title="搜索 (⌘K)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </div>
      </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            轻量级内容管理
          </div>
          <h1 class="hero-title">
            <span class="title-line">用简单的工具，</span>
            <span class="title-line title-gradient">写有价值的内容</span>
          </h1>
          <p class="hero-desc">Astro + Supabase + Cloudflare · 极速加载 · 免费部署</p>
          
          <div class="hero-stats">
            <div class="stat-item glass-card">
              <span class="stat-number">{posts?.length || 0}</span>
              <span class="stat-label">篇文章</span>
            </div>
            <div class="stat-item glass-card">
              <span class="stat-number">{recentFeeds?.length || 0}</span>
              <span class="stat-label">条情报</span>
            </div>
            <div class="stat-item glass-card">
              <span class="stat-number">{links?.length || 0}</span>
              <span class="stat-label">个导航</span>
            </div>
          </div>

          <div class="hero-actions">
            <a href="/feeds" class="btn-primary glass-btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 019 9M4 4a16 16 0 0116 16"/><circle cx="5" cy="19" r="1"/></svg>
              查看情报
            </a>
            <a href="/about" class="btn-ghost glass-btn-ghost">
              了解更多
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>

        <!-- Floating Cards -->
        <div class="hero-cards">
          <div class="floating-card card-1 glass-card">
            <div class="card-icon">🔒</div>
            <div class="card-text">安全漏洞</div>
          </div>
          <div class="floating-card card-2 glass-card">
            <div class="card-icon">🤖</div>
            <div class="card-text">AI 情报</div>
          </div>
          <div class="floating-card card-3 glass-card">
            <div class="card-icon">💰</div>
            <div class="card-text">云服务优惠</div>
          </div>
        </div>
      </div>
    </section>

    {links && links.length > 0 && (
      <section class="links-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>常用导航</h2>
            <span class="count">{links.length} 个</span>
          </div>
          {linkCategories.map(cat => (
            <div class="link-category">
              <h3 class="cat-label">{cat}</h3>
              <div class="links-grid">
                {links.filter(l => l.category === cat).map(link => (
                  <a href={link.url} target="_blank" rel="noopener" class="link-card glass-card hover-lift">
                    <span class="link-icon">{link.icon || '🔗'}</span>
                    <div>
                      <h4>{link.title}</h4>
                      {link.description && <p>{link.description}</p>}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {recentFeeds && recentFeeds.length > 0 && (
      <section class="feeds-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>情报流</h2>
            <a href="/feeds" class="see-all">查看全部 →</a>
          </div>
          <div class="feeds-list">
            {recentFeeds.map(feed => (
              <a href={feed.url || '#'} class="feed-row glass-card hover-lift" target={feed.url ? '_blank' : undefined} rel="noopener">
                <span class={`feed-priority ${feed.priority === 'critical' ? 'critical' : 'normal'}`}>
                  {feed.priority === 'critical' ? '🔴' : '🟢'}
                </span>
                <span class="feed-type-badge">{typeLabels[feed.feed_type] || feed.feed_type}</span>
                <span class="feed-title">{feed.title}</span>
                {feed.summary && <span class="feed-summary">{feed.summary}</span>}
                <time class="feed-time">{new Date(feed.published_at || feed.created_at).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</time>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {posts && posts.length > 0 && (
      <section class="posts-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>最新文章</h2>
            <span class="count">{posts.length} 篇</span>
          </div>
          <div class="posts-grid">
            {posts.map((post) => (
              <a href={`/posts/${post.id}`} class="post-card glass-card hover-lift">
                <div class="post-body">
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.summary || stripMarkdown(post.content || '').substring(0, 120)}</p>
                </div>
                <div class="post-footer">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  <span>·</span>
                  <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟</span>
                  {post.views > 0 && <><span>·</span><span>{post.views} 次浏览</span></>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <span>© 2026 XTCer</span>
        <div class="footer-links">
          <a href="/rss.xml" target="_blank">RSS</a>
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
          <a href="/about">关于</a>
          <a href="/contact">联系</a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Hero Section */
  .hero { 
    padding: 8rem 0 4rem; 
    text-align: center; 
    position: relative;
    overflow: hidden;
  }
  
  .hero-content {
    position: relative;
    z-index: 2;
  }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1rem;
    background: rgba(41,151,255,0.08);
    border: 1px solid rgba(41,151,255,0.15);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--primary);
    margin-bottom: 2rem;
    font-weight: 500;
    animation: fadeIn 0.5s ease-out;
  }
  
  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .title-line {
    display: block;
    background: linear-gradient(135deg, #fff 20%, rgba(255,255,255,0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  :root.light .title-line {
    background: linear-gradient(135deg, #1d1d1f 20%, rgba(29,29,31,0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .title-gradient {
    background: linear-gradient(135deg, #2997ff 0%, #bf5af2 50%, #00ffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 3s ease infinite;
  }
  
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .hero-desc {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    animation: slideUp 0.7s ease-out;
  }
  
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
    animation: slideUp 0.8s ease-out;
  }
  
  .stat-item {
    padding: 1rem 1.5rem;
    text-align: center;
    min-width: 120px;
  }
  
  .stat-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.25rem;
  }
  
  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    animation: slideUp 0.9s ease-out;
  }
  
  .btn-primary, .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #2997ff 0%, #0077ed 100%);
    color: white;
    border: none;
    box-shadow: 0 4px 12px rgba(41, 151, 255, 0.3);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(41, 151, 255, 0.4);
    color: white;
  }
  
  .btn-ghost {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--text);
  }
  
  :root.light .btn-ghost {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(0, 0, 0, 0.08);
  }
  
  :root.light .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(0, 0, 0, 0.15);
  }
  
  /* Floating Cards */
  .hero-cards {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  
  .floating-card {
    position: absolute;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    pointer-events: auto;
    cursor: default;
    animation: float 6s ease-in-out infinite;
  }
  
  .card-1 {
    top: 20%;
    left: 10%;
    animation-delay: 0s;
  }
  
  .card-2 {
    top: 30%;
    right: 10%;
    animation-delay: -2s;
  }
  
  .card-3 {
    bottom: 25%;
    left: 15%;
    animation-delay: -4s;
  }
  
  .card-icon {
    font-size: 1.5rem;
  }
  
  .card-text {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  /* Section Headers */
  .section-header { 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    margin-bottom: 1.5rem; 
  }
  
  .section-header h2 { 
    font-size: 1.375rem; 
    font-weight: 600; 
    letter-spacing: -0.01em;
  }
  
  .count { 
    font-size: 0.8125rem; 
    color: var(--text-muted); 
    padding: 0.25rem 0.75rem;
    background: rgba(255,255,255,0.03);
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.06);
  }
  
  :root.light .count {
    background: rgba(0,0,0,0.03);
    border-color: rgba(0,0,0,0.06);
  }

  /* Links Section */
  .links-section { padding: 0 0 4rem; }
  
  .link-category { margin-bottom: 2rem; }
  
  .cat-label { 
    font-size: 0.75rem; 
    color: var(--text-muted); 
    text-transform: uppercase; 
    letter-spacing: 0.08em; 
    margin-bottom: 1rem; 
    font-weight: 600; 
  }
  
  .links-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); 
    gap: 0.75rem; 
  }
  
  .link-card { 
    display: flex; 
    align-items: center; 
    gap: 0.875rem; 
    padding: 1rem 1.125rem; 
    cursor: pointer; 
    transition: all 0.2s ease;
  }
  
  .link-card:hover { 
    color: var(--text); 
    transform: translateY(-2px);
  }
  
  .link-icon { 
    font-size: 1.375rem; 
    flex-shrink: 0; 
  }
  
  .link-card h4 { 
    font-size: 0.875rem; 
    font-weight: 600; 
    margin-bottom: 0.125rem; 
  }
  
  .link-card p { 
    font-size: 0.75rem; 
    color: var(--text-muted); 
    line-height: 1.4;
  }

  /* Feeds Section */
  .feeds-section { padding: 0 0 4rem; }
  
  .see-all { 
    font-size: 0.8125rem; 
    color: var(--text-muted); 
    transition: color 0.2s;
  }
  
  .see-all:hover { color: var(--text); }
  
  .feeds-list { 
    display: flex; 
    flex-direction: column; 
    gap: 0.5rem; 
  }
  
  .feed-row {
    display: flex; 
    align-items: center; 
    gap: 0.75rem;
    padding: 0.75rem 1rem; 
    cursor: pointer;
    text-decoration: none; 
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }
  
  .feed-row:hover { 
    color: var(--text); 
    transform: translateX(4px);
  }
  
  .feed-priority { 
    font-size: 0.625rem; 
    flex-shrink: 0; 
  }
  
  .feed-priority.critical { 
    animation: pulse 2s infinite; 
  }
  
  .feed-type-badge {
    padding: 0.125rem 0.5rem; 
    border-radius: 999px;
    font-size: 0.6875rem; 
    font-weight: 500; 
    flex-shrink: 0;
    background: rgba(41,151,255,0.08); 
    color: var(--primary);
    border: 1px solid rgba(41,151,255,0.12);
  }
  
  .feed-title { 
    font-size: 0.875rem; 
    font-weight: 500; 
    flex: 1; 
    min-width: 0; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
  }
  
  .feed-summary { 
    font-size: 0.75rem; 
    color: var(--text-muted); 
    max-width: 200px; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
    flex-shrink: 2; 
  }
  
  .feed-time { 
    font-size: 0.6875rem; 
    color: var(--text-muted); 
    flex-shrink: 0; 
    margin-left: auto; 
  }

  /* Posts Section */
  .posts-section { padding: 0 0 5rem; }
  
  .posts-grid { 
    display: grid; 
    grid-template-columns: repeat(3, 1fr); 
    gap: 1rem; 
  }
  
  .post-card { 
    display: flex; 
    flex-direction: column; 
    justify-content: space-between; 
    padding: 1.5rem; 
    cursor: pointer; 
    transition: all 0.2s ease;
  }
  
  .post-card:hover { 
    color: var(--text); 
    transform: translateY(-4px);
  }
  
  .post-card h3 { 
    font-size: 1.0625rem; 
    font-weight: 600; 
    line-height: 1.4; 
    margin-bottom: 0.75rem; 
    letter-spacing: -0.01em;
  }
  
  .excerpt { 
    color: var(--text-secondary); 
    font-size: 0.875rem; 
    line-height: 1.7; 
    display: -webkit-box; 
    -webkit-line-clamp: 3; 
    -webkit-box-orient: vertical; 
    overflow: hidden; 
  }
  
  .post-footer { 
    display: flex; 
    gap: 0.5rem; 
    margin-top: 1.25rem; 
    font-size: 0.75rem; 
    color: var(--text-muted); 
  }

  /* Footer */
  .footer { 
    border-top: 1px solid var(--border); 
    padding: 2.5rem 0; 
    margin-top: 2rem; 
  }
  
  .footer-inner { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    font-size: 0.8125rem; 
    color: var(--text-muted); 
  }
  
  .footer-links { 
    display: flex; 
    gap: 2rem; 
  }
  
  .footer-links a { 
    color: var(--text-muted); 
    transition: color 0.2s;
  }
  
  .footer-links a:hover { color: var(--text); }

  /* Navigation Overrides */
  .nav-links { display: flex; gap: 1.25rem; align-items: center; }
  .nav-search-btn {
    background: none; border: none; color: var(--text-muted); cursor: pointer;
    padding: 0.375rem; border-radius: var(--radius-sm); transition: all 0.15s;
    display: flex; align-items: center; justify-content: center;
  }
  .nav-search-btn:hover { color: var(--text); background: var(--surface); }

  /* Responsive */
  @media (max-width: 1024px) { 
    .posts-grid { grid-template-columns: repeat(2, 1fr); } 
    .floating-card { display: none; }
  }
  
  @media (max-width: 640px) {
    .hero { padding: 4rem 0 2rem; }
    .hero-title { font-size: 2rem; }
    .hero-desc { font-size: 1rem; margin-bottom: 2rem; }
    .hero-stats { flex-direction: column; align-items: center; gap: 0.75rem; }
    .stat-item { width: 100%; max-width: 200px; }
    .hero-actions { flex-direction: column; align-items: center; }
    .btn-primary, .btn-ghost { width: 100%; max-width: 280px; justify-content: center; }
    .posts-grid { grid-template-columns: 1fr; }
    .post-card { padding: 1.25rem; }
    .links-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
    .link-card { padding: 0.875rem; }
    .feed-row { padding: 0.625rem 0.875rem; }
    .feed-summary { display: none; }
    .footer-inner { flex-direction: column; gap: 1.25rem; text-align: center; }
    .footer-links { gap: 1.5rem; }
    .section-header h2 { font-size: 1.25rem; }
  }
</style>

<script>
  document.getElementById('nav-search')?.addEventListener('click', () => {
    document.getElementById('search-modal')!.style.display = 'flex'
    setTimeout(() => (document.getElementById('search-input') as HTMLInputElement)?.focus(), 50)
  })
</script>
