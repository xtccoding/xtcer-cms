---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase'

const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false })

const { data: links } = await supabase
  .from('links')
  .select('*')
  .order('sort_order', { ascending: true })

const { data: recentFeeds } = await supabase
  .from('feeds')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(12)

const linkCategories = [...new Set(links?.map(l => l.category) || [])]

const typeLabels: Record<string, string> = {
  security: '安全', github_trending: 'GitHub', ai_monetization: 'AI',
  crypto_alpha: '加密', deal_hunt: '捡漏', industry_move: '行业',
  devtool_launch: '工具', learn_alpha: '学习',
}

function stripMarkdown(text: string) {
  return (text || '')
    .replace(/#{1,6}\s/g, '')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\*(.*?)\*/g, '$1')
    .replace(/`{1,3}[^`]*`{1,3}/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[>\-|]/g, '')
    .replace(/\n+/g, ' ')
    .trim()
}
---

<Layout title="XTcer - 技术探索者 | AI情报·安全漏洞·云服务优惠" description="XTcer - 技术探索者，专注前沿技术洞察。AI情报、安全漏洞、云服务优惠、技术深度文章实时推送。Astro + Supabase 构建，极速加载。">
  <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">XTcer</a>
        <div class="nav-links">
          <a href="/deals" class="nav-link">优惠</a>
          <a href="/feeds" class="nav-link">情报</a>
          <button class="nav-search-btn" id="nav-search" title="搜索 (⌘K)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </div>
      </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <!-- Brand Logo -->
          <div class="brand-logo">
            <div class="logo-wrapper">
              <span class="logo-xt">XT</span>
              <span class="logo-cer">cer</span>
            </div>
            <div class="logo-glow"></div>
          </div>
          
          <!-- Tagline -->
          <div class="hero-tagline">
            <span class="tagline-en">eXploring Tech</span>
            <span class="tagline-divider"></span>
            <span class="tagline-cn">技术探索者</span>
          </div>
          
          <!-- Slogan -->
          <h1 class="hero-slogan">
            <span class="slogan-line">探索前沿</span>
            <span class="slogan-dot">·</span>
            <span class="slogan-line slogan-gradient">洞见未来</span>
          </h1>
          
          <!-- Description -->
          <p class="hero-desc">
            <span class="desc-item">AI 情报</span>
            <span class="desc-dot">·</span>
            <span class="desc-item">安全漏洞</span>
            <span class="desc-dot">·</span>
            <span class="desc-item">云服务优惠</span>
            <span class="desc-dot">·</span>
            <span class="desc-item">技术深度</span>
          </p>
          
          <!-- Stats -->
          <div class="hero-stats">
            <div class="stat-item glass-card">
              <span class="stat-number">{posts?.length || 0}</span>
              <span class="stat-label">技术文章</span>
            </div>
            <div class="stat-item glass-card">
              <span class="stat-number">{recentFeeds?.length || 0}</span>
              <span class="stat-label">实时情报</span>
            </div>
            <div class="stat-item glass-card">
              <span class="stat-number">{links?.length || 0}</span>
              <span class="stat-label">精选导航</span>
            </div>
          </div>

          <!-- Actions -->
          <div class="hero-actions">
            <a href="/feeds" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 019 9M4 4a16 16 0 0116 16"/><circle cx="5" cy="19" r="1"/></svg>
              查看情报
            </a>
            <a href="/about" class="btn-ghost">
              了解更多
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>

        <!-- Floating Elements -->
        <div class="hero-float">
          <div class="float-orb orb-1"></div>
          <div class="float-orb orb-2"></div>
          <div class="float-orb orb-3"></div>
          <div class="float-ring ring-1"></div>
          <div class="float-ring ring-2"></div>
        </div>
      </div>
    </section>

    {links && links.length > 0 && (
      <section class="links-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>常用导航</h2>
            <span class="count">{links.length} 个</span>
          </div>
          {linkCategories.map(cat => (
            <div class="link-category">
              <h3 class="cat-label">{cat}</h3>
              <div class="links-grid">
                {links.filter(l => l.category === cat).map(link => (
                  <a href={link.url} target="_blank" rel="noopener" class="link-card glass-card hover-lift">
                    <span class="link-icon">{link.icon || '🔗'}</span>
                    <div>
                      <h4>{link.title}</h4>
                      {link.description && <p>{link.description}</p>}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {recentFeeds && recentFeeds.length > 0 && (
      <section class="feeds-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>情报流</h2>
            <a href="/feeds" class="see-all">查看全部 →</a>
          </div>
          <div class="feeds-list">
            {recentFeeds.map(feed => (
              <a href={feed.url || '#'} class="feed-row glass-card hover-lift" target={feed.url ? '_blank' : undefined} rel="noopener">
                <span class={`feed-priority ${feed.priority === 'critical' ? 'critical' : 'normal'}`}>
                  {feed.priority === 'critical' ? '🔴' : '🟢'}
                </span>
                <span class="feed-type-badge">{typeLabels[feed.feed_type] || feed.feed_type}</span>
                <span class="feed-title">{feed.title}</span>
                {feed.summary && <span class="feed-summary">{feed.summary}</span>}
                <time class="feed-time">{new Date(feed.published_at || feed.created_at).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</time>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {posts && posts.length > 0 && (
      <section class="posts-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>最新文章</h2>
            <span class="count">{posts.length} 篇</span>
          </div>
          <div class="posts-grid">
            {posts.map((post) => (
              <a href={`/posts/${post.id}`} class="post-card glass-card hover-lift">
                <div class="post-body">
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.summary || stripMarkdown(post.content || '').substring(0, 120)}</p>
                </div>
                <div class="post-footer">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  <span>·</span>
                  <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟</span>
                  {post.views > 0 && <><span>·</span><span>{post.views} 次浏览</span></>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <span class="logo-xt">XT</span><span class="logo-cer">cer</span>
          </div>
          <span class="footer-slogan">探索前沿，洞见未来</span>
        </div>
        <div class="footer-links">
          <a href="/rss.xml" target="_blank">RSS</a>
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
          <a href="/about">关于</a>
          <a href="/contact">联系</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 XTcer - eXploring Tech</span>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Hero Section */
  .hero { 
    padding: 6rem 0 4rem; 
    text-align: center; 
    position: relative;
    overflow: hidden;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }
  
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  
  /* Brand Logo */
  .brand-logo {
    position: relative;
    display: inline-block;
    margin-bottom: 2rem;
    animation: fadeIn 0.8s ease-out;
  }
  
  .logo-wrapper {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0;
    font-size: 5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  
  .logo-xt {
    background: linear-gradient(135deg, #2997ff 0%, #00d4ff 50%, #bf5af2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 4s ease infinite;
    position: relative;
  }
  
  .logo-xt::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #2997ff, #bf5af2, #00ffff);
    border-radius: 2px;
    animation: glowPulse 2s ease-in-out infinite;
  }
  
  .logo-cer {
    color: var(--text);
    opacity: 0.9;
  }
  
  .logo-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(41,151,255,0.15) 0%, transparent 50%);
    pointer-events: none;
    animation: glowBreath 3s ease-in-out infinite;
  }
  
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  @keyframes glowPulse {
    0%, 100% { opacity: 0.5; transform: scaleX(0.8); }
    50% { opacity: 1; transform: scaleX(1); }
  }
  
  @keyframes glowBreath {
    0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(0.8); }
    50% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
  }
  
  /* Tagline */
  .hero-tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .tagline-en {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  
  .tagline-divider {
    width: 24px;
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 1px;
  }
  
  .tagline-cn {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  
  /* Slogan */
  .hero-slogan {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    animation: slideUp 0.7s ease-out;
  }
  
  .slogan-line {
    display: inline;
    color: var(--text);
  }
  
  .slogan-dot {
    display: inline;
    color: var(--primary);
    margin: 0 0.5rem;
    font-weight: 300;
  }
  
  .slogan-gradient {
    background: linear-gradient(135deg, #2997ff 0%, #bf5af2 50%, #00ffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 3s ease infinite;
  }
  
  :root.light .slogan-line {
    color: #1d1d1f;
  }
  
  /* Description */
  .hero-desc {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    animation: slideUp 0.8s ease-out;
  }
  
  .desc-item {
    padding: 0.375rem 1rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 999px;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }
  
  .desc-item:hover {
    background: rgba(41,151,255,0.1);
    border-color: rgba(41,151,255,0.2);
    color: var(--primary);
  }
  
  :root.light .desc-item {
    background: rgba(0,0,0,0.03);
    border-color: rgba(0,0,0,0.06);
  }
  
  .desc-dot {
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  
  /* Stats */
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
    animation: slideUp 0.9s ease-out;
  }
  
  .stat-item {
    padding: 1.25rem 1.75rem;
    text-align: center;
    min-width: 130px;
    transition: all 0.2s ease;
  }
  
  .stat-item:hover {
    transform: translateY(-2px);
    border-color: var(--glass-border-hover);
  }
  
  .stat-number {
    display: block;
    font-size: 1.75rem;
    font-weight: 800;
    background: linear-gradient(135deg, #2997ff, #bf5af2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.375rem;
  }
  
  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  
  /* Actions */
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    animation: slideUp 1s ease-out;
  }
  
  .btn-primary, .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 2rem;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #2997ff 0%, #0077ed 100%);
    color: white;
    border: none;
    box-shadow: 0 4px 16px rgba(41,151,255,0.3);
    position: relative;
    overflow: hidden;
  }
  
  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(41,151,255,0.4);
    color: white;
  }
  
  .btn-primary:hover::before {
    left: 100%;
  }
  
  .btn-ghost {
    background: rgba(255,255,255,0.03);
    color: var(--text);
    border: 1px solid rgba(255,255,255,0.08);
  }
  
  .btn-ghost:hover {
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.15);
    color: var(--text);
    transform: translateY(-2px);
  }
  
  :root.light .btn-ghost {
    background: rgba(0,0,0,0.03);
    border-color: rgba(0,0,0,0.08);
  }
  
  :root.light .btn-ghost:hover {
    background: rgba(0,0,0,0.06);
    border-color: rgba(0,0,0,0.15);
  }
  
  /* Floating Elements */
  .hero-float {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 1;
  }
  
  .float-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.3;
  }
  
  :root.light .float-orb {
    opacity: 0.15;
  }
  
  .orb-1 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(41,151,255,0.4), transparent 70%);
    top: 10%;
    left: 15%;
    animation: float1 8s ease-in-out infinite;
  }
  
  .orb-2 {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(191,90,242,0.3), transparent 70%);
    top: 60%;
    right: 10%;
    animation: float2 10s ease-in-out infinite;
  }
  
  .orb-3 {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(0,255,255,0.2), transparent 70%);
    bottom: 20%;
    left: 30%;
    animation: float3 12s ease-in-out infinite;
  }
  
  .float-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(41,151,255,0.1);
  }
  
  .ring-1 {
    width: 400px;
    height: 400px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: ringPulse 4s ease-in-out infinite;
  }
  
  .ring-2 {
    width: 300px;
    height: 300px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: ringPulse 4s ease-in-out infinite 1s;
  }
  
  @keyframes float1 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(30px, -20px); }
    66% { transform: translate(-20px, 30px); }
  }
  
  @keyframes float2 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(-25px, 25px); }
    66% { transform: translate(35px, -15px); }
  }
  
  @keyframes float3 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(20px, 30px); }
    66% { transform: translate(-30px, -20px); }
  }
  
  @keyframes ringPulse {
    0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(0.8); }
    50% { opacity: 0.6; transform: translate(-50%, -50%) scale(1.1); }
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Section Headers */
  .section-header { 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    margin-bottom: 1.5rem; 
  }
  
  .section-header h2 { 
    font-size: 1.375rem; 
    font-weight: 700; 
    letter-spacing: -0.01em;
  }
  
  .count { 
    font-size: 0.8125rem; 
    color: var(--text-muted); 
    padding: 0.375rem 1rem;
    background: rgba(255,255,255,0.03);
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.06);
    font-weight: 500;
  }
  
  :root.light .count {
    background: rgba(0,0,0,0.03);
    border-color: rgba(0,0,0,0.06);
  }

  /* Links Section */
  .links-section { padding: 0 0 4rem; }
  
  .link-category { margin-bottom: 2rem; }
  
  .cat-label { 
    font-size: 0.75rem; 
    color: var(--text-muted); 
    text-transform: uppercase; 
    letter-spacing: 0.1em; 
    margin-bottom: 1rem; 
    font-weight: 600; 
  }
  
  .links-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); 
    gap: 0.75rem; 
  }
  
  .link-card { 
    display: flex; 
    align-items: center; 
    gap: 0.875rem; 
    padding: 1rem 1.125rem; 
    cursor: pointer; 
    transition: all 0.2s ease;
  }
  
  .link-card:hover { 
    color: var(--text); 
  }
  
  .link-icon { 
    font-size: 1.375rem; 
    flex-shrink: 0; 
  }
  
  .link-card h4 { 
    font-size: 0.875rem; 
    font-weight: 600; 
    margin-bottom: 0.125rem; 
  }
  
  .link-card p { 
    font-size: 0.75rem; 
    color: var(--text-muted); 
    line-height: 1.4;
  }

  /* Feeds Section */
  .feeds-section { padding: 0 0 4rem; }
  
  .see-all { 
    font-size: 0.8125rem; 
    color: var(--text-muted); 
    transition: color 0.2s;
    font-weight: 500;
  }
  
  .see-all:hover { color: var(--text); }
  
  .feeds-list { 
    display: flex; 
    flex-direction: column; 
    gap: 0.5rem; 
  }
  
  .feed-row {
    display: flex; 
    align-items: center; 
    gap: 0.75rem;
    padding: 0.875rem 1rem; 
    cursor: pointer;
    text-decoration: none; 
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }
  
  .feed-row:hover { 
    color: var(--text); 
  }
  
  .feed-priority { 
    font-size: 0.625rem; 
    flex-shrink: 0; 
  }
  
  .feed-priority.critical { 
    animation: pulse 2s infinite; 
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }
  
  .feed-type-badge {
    padding: 0.125rem 0.5rem; 
    border-radius: 999px;
    font-size: 0.6875rem; 
    font-weight: 600; 
    flex-shrink: 0;
    background: rgba(41,151,255,0.08); 
    color: var(--primary);
    border: 1px solid rgba(41,151,255,0.12);
  }
  
  .feed-title { 
    font-size: 0.875rem; 
    font-weight: 500; 
    flex: 1; 
    min-width: 0; 
    white-space: nowrap; 
