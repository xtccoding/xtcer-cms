---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase'

const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false })
---

<Layout title="XTCer">
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">XTCer</a>
      <div class="nav-links">
        <a href="/about" class="nav-link">关于</a>
        <a href="/contact" class="nav-link">联系</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-badge">轻量级内容管理</div>
        <h1>用简单的工具，<br/>写有价值的内容</h1>
        <p class="hero-desc">Astro + Supabase + Cloudflare · 极速加载 · 免费部署</p>
      </div>
    </section>

    <section class="posts-section">
      <div class="container-wide">
        <div class="section-header">
          <h2>最新文章</h2>
          <span class="count">{posts?.length || 0} 篇</span>
        </div>
        {posts && posts.length > 0 ? (
          <div class="posts-grid">
            {posts.map((post, i) => (
              <a href={`/posts/${post.id}`} class={`post-card glass-card ${i === 0 ? 'featured' : ''}`}>
                <div class="post-body">
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.content?.replace(/<[^>]*>/g, '').substring(0, i === 0 ? 200 : 120)}</p>
                </div>
                <div class="post-footer">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty glass-card">
            <p>暂无内容</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <span>© 2026 XTCer</span>
        <div class="footer-links">
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
          <a href="/about">关于</a>
          <a href="/contact">联系</a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .hero {
    padding: 6rem 0 4rem;
    text-align: center;
  }
  .hero-badge {
    display: inline-block; padding: 0.25rem 0.75rem;
    background: rgba(41,151,255,0.08); border: 1px solid rgba(41,151,255,0.15);
    border-radius: 999px; font-size: 0.75rem; color: var(--primary);
    margin-bottom: 1.5rem; font-weight: 500; letter-spacing: 0.02em;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800;
    letter-spacing: -0.04em; line-height: 1.1; margin-bottom: 1.25rem;
    background: linear-gradient(135deg, #fff 20%, rgba(255,255,255,0.4) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .hero-desc {
    font-size: 1.125rem; color: var(--text-muted); letter-spacing: 0.01em;
  }

  .posts-section { padding: 0 0 4rem; }
  .section-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .section-header h2 { font-size: 1.25rem; font-weight: 600; }
  .count { font-size: 0.8125rem; color: var(--text-muted); }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .post-card {
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 1.5rem; cursor: pointer;
  }
  .post-card.featured {
    grid-column: 1 / -1;
  }
  .post-card:hover { color: var(--text); transform: translateY(-2px); }
  .post-card h3 {
    font-size: 1rem; font-weight: 600; line-height: 1.4; margin-bottom: 0.5rem;
  }
  .post-card.featured h3 { font-size: 1.375rem; }
  .excerpt {
    color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.65;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post-card.featured .excerpt { -webkit-line-clamp: 3; }
  .post-footer {
    display: flex; gap: 0.75rem; margin-top: 1rem;
    font-size: 0.75rem; color: var(--text-muted);
  }

  .empty { text-align: center; padding: 6rem 2rem; }
  .empty p { color: var(--text-muted); }

  .footer {
    border-top: 1px solid var(--border); padding: 2rem 0;
    margin-top: 2rem;
  }
  .footer-inner {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.75rem; color: var(--text-muted);
  }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); }

  @media (max-width: 1024px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .hero { padding: 4rem 0 3rem; }
    .posts-grid { grid-template-columns: 1fr; }
    .post-card.featured { grid-column: auto; }
    .footer-inner { flex-direction: column; gap: 1rem; text-align: center; }
  }
</style>
