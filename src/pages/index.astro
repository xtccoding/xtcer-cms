---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase'

const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(20)
---

<Layout title="XTCer">
  <main>
    <nav class="glass-nav">
      <div class="nav-content">
        <a href="/" class="logo">XTCer</a>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-badge">轻量级内容管理</div>
      <h1>XTCer</h1>
      <p>快速、简洁、优雅的内容发布平台</p>
    </section>

    <section class="content">
      {posts && posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((post) => (
            <a href={`/posts/${post.id}`} class="post-card glass-card">
              <div class="post-header">
                <h3>{post.title}</h3>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted);flex-shrink:0"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </div>
              <p class="excerpt">{post.content?.replace(/<[^>]*>/g, '').substring(0, 150)}</p>
              <div class="post-meta">
                <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                <span>·</span>
                <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟阅读</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty glass-card">
          <p>暂无内容</p>
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .glass-nav {
    position: fixed; top: 1rem; left: 50%; transform: translateX(-50%);
    width: calc(100% - 2rem); max-width: 600px;
    background: rgba(255,255,255,0.05); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08); border-radius: 999px;
    z-index: 100; padding: 0.75rem 1.5rem;
  }
  .nav-content { display: flex; justify-content: center; }
  .logo { font-size: 1rem; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }

  .hero {
    padding: 10rem 2rem 4rem; text-align: center; max-width: 600px; margin: 0 auto;
  }
  .hero-badge {
    display: inline-block; padding: 0.375rem 0.875rem;
    background: rgba(41,151,255,0.1); border: 1px solid rgba(41,151,255,0.2);
    border-radius: 999px; font-size: 0.75rem; color: var(--primary);
    margin-bottom: 1.5rem; font-weight: 500;
  }
  .hero h1 {
    font-size: 4.5rem; font-weight: 800; letter-spacing: -0.04em;
    background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.5) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin-bottom: 1rem; line-height: 1;
  }
  .hero p { font-size: 1.125rem; color: var(--text-muted); }

  .content { max-width: 600px; margin: 0 auto; padding: 0 2rem 4rem; }

  .posts-grid { display: flex; flex-direction: column; gap: 0.75rem; }
  .post-card { display: block; padding: 1.25rem 1.5rem; cursor: pointer; }
  .post-card:hover { color: var(--text); }
  .post-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem; }
  .post-header h3 { font-size: 1rem; font-weight: 600; line-height: 1.4; }
  .excerpt {
    color: var(--text-muted); font-size: 0.8125rem; line-height: 1.6;
    margin-bottom: 0.75rem;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post-meta { display: flex; gap: 0.5rem; font-size: 0.75rem; color: var(--text-muted); }
  .post-meta span:first-child { opacity: 0.5; }

  .empty { text-align: center; padding: 4rem 2rem; }
  .empty p { color: var(--text-muted); }
</style>
