---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase'

// Fetch posts, links, feeds
const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false })

const { data: links } = await supabase
  .from('links')
  .select('*')
  .order('sort_order', { ascending: true })

const { data: recentFeeds } = await supabase
  .from('feeds')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(12)

// Fetch site settings
const { data: bannerData } = await supabase
  .from('site_settings')
  .select('value')
  .eq('key', 'banner')
  .single()

const { data: particlesData } = await supabase
  .from('site_settings')
  .select('value')
  .eq('key', 'particles')
  .single()

const banner = bannerData?.value || {
  title_line1: '探索前沿',
  title_line2: '洞见未来',
  title_dot: '·',
  tagline_en: 'eXploring Tech',
  tagline_cn: '技术探索者',
  desc_items: ['AI 情报', '安全漏洞', '云服务优惠', '技术深度']
}

const particlesConfig = particlesData?.value || {
  mode: 'siri',
  background_particles: { count: 120, size_min: 0.5, size_max: 2, opacity_min: 0.05, opacity_max: 0.35, speed: 0.3, color: '41, 151, 255' },
  siri_wave: { layers: 5, base_radius: 80, layer_spacing: 15, wave_amplitude: 8, wave_frequency: 3, speed: 0.02 },
  single_ring: { radius: 100, wave_amplitude: 12, speed: 0.015, color: '41, 151, 255' },
  double_ring: { radius1: 80, radius2: 120, wave_amplitude: 10, speed: 0.02, color1: '41, 151, 255', color2: '191, 90, 242' },
  mouse_effect: { enabled: true, radius: 40, pulse_speed: 0.03 }
}

const linkCategories = [...new Set(links?.map(l => l.category) || [])]

const typeLabels: Record<string, string> = {
  security: '安全', github_trending: 'GitHub', ai_monetization: 'AI',
  crypto_alpha: '加密', deal_hunt: '捡漏', industry_move: '行业',
  devtool_launch: '工具', learn_alpha: '学习',
}

function stripMarkdown(text: string) {
  return (text || '')
    .replace(/#{1,6}\s/g, '')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\*(.*?)\*/g, '$1')
    .replace(/`{1,3}[^`]*`{1,3}/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[>\-|]/g, '')
    .replace(/\n+/g, ' ')
    .trim()
}
---

<Layout title="XTcer - 技术探索者 | AI情报·安全漏洞·云服务优惠" description="XTcer - 技术探索者，专注前沿技术洞察。AI情报、安全漏洞、云服务优惠、技术深度文章实时推送。Astro + Supabase 构建，极速加载。">
  <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">XTcer</a>
        <div class="nav-links">
          <a href="/deals" class="nav-link">优惠</a>
          <a href="/feeds" class="nav-link">情报</a>
          <button class="nav-search-btn" id="nav-search" title="搜索 (⌘K)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </div>
      </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <!-- Particle Canvas -->
      <canvas id="particles" class="particles-canvas"></canvas>
      
      <div class="container">
        <div class="hero-content">
          <!-- Brand Logo -->
          <div class="brand-logo">
            <div class="logo-wrapper">
              <span class="logo-xt">XT</span>
              <span class="logo-cer">cer</span>
            </div>
            <div class="logo-underline"></div>
          </div>
          
          <!-- Tagline -->
          <div class="hero-tagline">
            <span class="tagline-en">{banner.tagline_en}</span>
            <span class="tagline-divider"></span>
            <span class="tagline-cn">{banner.tagline_cn}</span>
          </div>
          
          <!-- Slogan -->
          <h1 class="hero-slogan">
            <span class="slogan-line">{banner.title_line1}</span>
            <span class="slogan-dot">{banner.title_dot}</span>
            <span class="slogan-line slogan-gradient">{banner.title_line2}</span>
          </h1>
          
          <!-- Description -->
          <p class="hero-desc">
            {banner.desc_items.map((item: string, i: number) => (
              <>
                {i > 0 && <span class="desc-dot">·</span>}
                <span class="desc-item">{item}</span>
              </>
            ))}
          </p>
          
          <!-- Stats -->
          <div class="hero-stats">
            <div class="stat-item glass-card">
              <span class="stat-number">{posts?.length || 0}</span>
              <span class="stat-label">技术文章</span>
            </div>
            <div class="stat-item glass-card">
              <span class="stat-number">{recentFeeds?.length || 0}</span>
              <span class="stat-label">实时情报</span>
            </div>
            <div class="stat-item glass-card">
              <span class="stat-number">{links?.length || 0}</span>
              <span class="stat-label">精选导航</span>
            </div>
          </div>

          <!-- Actions -->
          <div class="hero-actions">
            <a href="/feeds" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 019 9M4 4a16 16 0 0116 16"/><circle cx="5" cy="19" r="1"/></svg>
              查看情报
            </a>
            <a href="/about" class="btn-ghost">
              了解更多
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    {links && links.length > 0 && (
      <section class="links-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>常用导航</h2>
            <span class="count">{links.length} 个</span>
          </div>
          {linkCategories.map(cat => (
            <div class="link-category">
              <h3 class="cat-label">{cat}</h3>
              <div class="links-grid">
                {links.filter(l => l.category === cat).map(link => (
                  <a href={link.url} target="_blank" rel="noopener" class="link-card glass-card hover-lift">
                    <span class="link-icon">{link.icon || '🔗'}</span>
                    <div>
                      <h4>{link.title}</h4>
                      {link.description && <p>{link.description}</p>}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {recentFeeds && recentFeeds.length > 0 && (
      <section class="feeds-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>情报流</h2>
            <a href="/feeds" class="see-all">查看全部 →</a>
          </div>
          <div class="feeds-list">
            {recentFeeds.map(feed => (
              <a href={feed.url || '#'} class="feed-row glass-card hover-lift" target={feed.url ? '_blank' : undefined} rel="noopener">
                <span class={`feed-priority ${feed.priority === 'critical' ? 'critical' : 'normal'}`}>
                  {feed.priority === 'critical' ? '🔴' : '🟢'}
                </span>
                <span class="feed-type-badge">{typeLabels[feed.feed_type] || feed.feed_type}</span>
                <span class="feed-title">{feed.title}</span>
                {feed.summary && <span class="feed-summary">{feed.summary}</span>}
                <time class="feed-time">{new Date(feed.published_at || feed.created_at).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</time>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {posts && posts.length > 0 && (
      <section class="posts-section">
        <div class="container-wide">
          <div class="section-header">
            <h2>最新文章</h2>
            <span class="count">{posts.length} 篇</span>
          </div>
          <div class="posts-grid">
            {posts.map((post) => (
              <a href={`/posts/${post.id}`} class="post-card glass-card hover-lift">
                <div class="post-body">
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.summary || stripMarkdown(post.content || '').substring(0, 120)}</p>
                </div>
                <div class="post-footer">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  <span>·</span>
                  <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟</span>
                  {post.views > 0 && <><span>·</span><span>{post.views} 次浏览</span></>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <span class="logo-xt">XT</span><span class="logo-cer">cer</span>
          </div>
          <span class="footer-slogan">探索前沿，洞见未来</span>
        </div>
        <div class="footer-links">
          <a href="/rss.xml" target="_blank">RSS</a>
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
          <a href="/about">关于</a>
          <a href="/contact">联系</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 XTcer - eXploring Tech</span>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Hero Section */
  .hero { 
    padding: 6rem 0 4rem; 
    text-align: center; 
    position: relative;
    overflow: hidden;
    min-height: 85vh;
    display: flex;
    align-items: center;
  }
  
  .particles-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  
  /* Brand Logo */
  .brand-logo {
    position: relative;
    display: inline-block;
    margin-bottom: 2.5rem;
    animation: fadeIn 0.8s ease-out;
  }
  
  .logo-wrapper {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0;
    font-family: 'Space Grotesk', 'Inter', -apple-system, sans-serif;
    font-size: 6rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  
  .logo-xt {
    background: linear-gradient(135deg, #2997ff 0%, #00d4ff 40%, #bf5af2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 4s ease infinite;
  }
  
  .logo-cer {
    color: var(--text);
    opacity: 0.95;
    font-weight: 300;
  }
  
  .logo-underline {
    height: 3px;
    margin-top: 0.75rem;
    background: linear-gradient(90deg, transparent, #2997ff, #bf5af2, #00ffff, transparent);
    border-radius: 2px;
    animation: shimmer 3s ease-in-out infinite;
  }
  
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  @keyframes shimmer {
    0%, 100% { opacity: 0.5; transform: scaleX(0.8); }
    50% { opacity: 1; transform: scaleX(1); }
  }
  
  /* Tagline */
  .hero-tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .tagline-en {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 1.25rem;
    font-weight: 550;
    color: var(--text);
    letter-spacing: 0.04em;
    font-variant-ligatures: no-common-ligatures;
  }
  
  .tagline-divider {
    width: 32px;
    height: 1.5px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 1px;
  }
  
  .tagline-cn {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--text-secondary);
    letter-spacing: 0.1em;
  }
  
  /* Slogan */
  .hero-slogan {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 2rem;
    animation: slideUp 0.7s ease-out;
  }
  
  .slogan-line {
    display: inline;
    color: var(--text);
  }
  
  .slogan-dot {
    display: inline;
    color: var(--primary);
    margin: 0 0.75rem;
    font-weight: 200;
    opacity: 0.8;
  }
  
  .slogan-gradient {
    background: linear-gradient(135deg, #2997ff 0%, #bf5af2 50%, #00ffff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 3s ease infinite;
  }
  
  :root.light .slogan-line {
    color: #1d1d1f;
  }
  
  /* Description */
  .hero-desc {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 3.5rem;
    animation: slideUp 0.8s ease-out;
  }
  
  .desc-item {
    font-family: 'Inter', sans-serif;
    padding: 0.5rem 1.25rem;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 450;
    color: var(--text-secondary);
    transition: all 0.3s ease;
    letter-spacing: 0.02em;
  }
  
  .desc-item:hover {
    background: rgba(41,151,255,0.08);
    border-color: rgba(41,151,255,0.15);
    color: var(--primary);
    transform: translateY(-1px);
  }
  
  :root.light .desc-item {
    background: rgba(0,0,0,0.02);
    border-color: rgba(0,0,0,0.05);
  }
  
  .desc-dot {
    color: var(--text-muted);
    font-size: 0.5rem;
    opacity: 0.5;
  }
  
  /* Stats */
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
    animation: slideUp 0.9s ease-out;
  }
  
  .stat-item {
    padding: 1.5rem 2rem;
    text-align: center;
    min-width: 140px;
    transition: all 0.3s ease;
    border-radius: 16px;
  }
  
  .stat-item:hover {
    transform: translateY(-3px);
    border-color: rgba(41,151,255,0.2);
    box-shadow: 0 8px 32px rgba(41,151,255,0.1);
  }
  
  .stat-number {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #2997ff, #bf5af2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }
  
  .stat-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 450;
    letter-spacing: 0.02em;
  }
  
  /* Actions */
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    animation: slideUp 1s ease-out;
  }
  
  .btn-primary, .btn-ghost {
    font-family: 'Inter', sans-serif;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.25rem;
    border-radius: 14px;
    font-size: 0.9375rem;
    font-weight: 550;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #2997ff 0%, #0077ed 100%);
    color: white;
    border: none;
    box-shadow: 0 4px 20px rgba(41,151,255,0.25);
    position: relative;
    overflow: hidden;
  }
  
  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transition: left 0.6s ease;
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(41,151,255,0.35);
    color: white;
  }
  
  .btn-primary:hover::before {
    left: 100%;
  }
  
  .btn-ghost {
    background: rgba(255,255,255,0.02);
    color: var(--text);
    border: 1px solid rgba(255,255,255,0.06);
  }
  
  .btn-ghost:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.12);
    color: var(--text);
    transform: translateY(-2px);
  }
  
  :root.light .btn-ghost {
    background: rgba(0,0,0,0.02);
    border-color: rgba(0,0,0,0.06);
  }
  
  :root.light .btn-ghost:hover {
    background: rgba(0,0,0,0.04);
    border-color: rgba(0,0,0,0.12);
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Section Headers */
  .section-header { 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    margin-bottom: 1.5rem; 
  }
  
  .section-header h2 { 
    font-family: 'Inter', sans-serif;
    font-size: 1.375rem; 
    font-weight: 650; 
    letter-spacing: -0.015em;
  }
  
  .count { 
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem; 
    color: var(--text-muted); 
    padding: 0.375rem 1rem;
    background: rgba(255,255,255,0.02);
    border-radius: 100px;
    border: 1px solid rgba(255,255,255,0.05);
    font-weight: 450;
  }
  
  :root.light .count {
    background: rgba(0,0,0,0.02);
    border-color: rgba(0,0,0,0.05);
  }

  /* Links Section */
  .links-section { padding: 0 0 4rem; }
  
  .link-category { margin-bottom: 2rem; }
  
  .cat-label { 
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem; 
    color: var(--text-muted); 
    text-transform: uppercase; 
    letter-spacing: 0.12em; 
    margin-bottom: 1rem; 
    font-weight: 600; 
  }
  
  .links-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); 
    gap: 0.75rem; 
  }
  
  .link-card { 
    display: flex; 
    align-items: center; 
    gap: 0.875rem; 
    padding: 1rem 1.125rem; 
    cursor: pointer; 
    transition: all 0.25s ease;
    border-radius: 14px;
  }
  
  .link-card:hover { 
    color: var(--text); 
  }
  
  .link-icon { 
    font-size: 1.375rem; 
    flex-shrink: 0; 
  }
  
  .link-card h4 { 
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem; 
    font-weight: 550; 
    margin-bottom: 0.125rem; 
  }
  
  .link-card p { 
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem; 
    color: var(--text-muted); 
    line-height: 1.4;
    font-weight: 400;
  }

  /* Feeds Section */
  .feeds-section { padding: 0 0 4rem; }
  
  .see-all { 
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem; 
    color: var(--text-muted); 
    transition: color 0.2s;
    font-weight: 500;
  }
  
  .see-all:hover { color: var(--text); }
  
  .feeds-list { 
    display: flex; 
    flex-direction: column; 
    gap: 0.5rem; 
  }
  
  .feed-row {
    display: flex; 
    align-items: center; 
    gap: 0.75rem;
    padding: 0.875rem 1rem; 
    cursor: pointer;
    text-decoration: none; 
    color: var(--text-secondary);
    transition: all 0.25s ease;
    border-radius: 12px;
  }
  
  .feed-row:hover { 
    color: var(--text); 
  }
  
  .feed-priority { 
    font-size: 0.625rem; 
    flex-shrink: 0; 
  }
  
  .feed-priority.critical { 
    animation: pulse 2s infinite; 
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }
  
  .feed-type-badge {
    font-family: 'Inter', sans-serif;
    padding: 0.125rem 0.5rem; 
    border-radius: 100px;
    font-size: 0.6875rem; 
    font-weight: 550; 
    flex-shrink: 0;
    background: rgba(41,151,255,0.06); 
    color: var(--primary);
    border: 1px solid rgba(41,151,255,0.1);
  }
  
  .feed-title { 
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem; 
    font-weight: 500; 
    flex: 1; 
    min-width: 0; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
  }
  
  .feed-summary { 
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem; 
    color: var(--text-muted); 
    max-width: 200px; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
    flex-shrink: 2; 
    font-weight: 400;
  }
  
  .feed-time { 
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem; 
    color: var(--text-muted); 
    flex-shrink: 0; 
    margin-left: auto; 
    font-weight: 450;
  }

  /* Posts Section */
  .posts-section { padding: 0 0 5rem; }
  
  .posts-grid { 
    display: grid; 
    grid-template-columns: repeat(3, 1fr); 
    gap: 1rem; 
  }
  
  .post-card { 
    display: flex; 
    flex-direction: column; 
    justify-content: space-between; 
    padding: 1.5rem; 
    cursor: pointer; 
    transition: all 0.3s ease;
    border-radius: 16px;
  }
  
  .post-card:hover { 
    color: var(--text); 
  }
  
  .post-card h3 { 
    font-family: 'Inter', sans-serif;
    font-size: 1.0625rem; 
    font-weight: 600; 
    line-height: 1.4; 
    margin-bottom: 0.75rem; 
    letter-spacing: -0.015em;
  }
  
  .excerpt { 
    font-family: 'Inter', sans-serif;
    color: var(--text-secondary); 
    font-size: 0.875rem; 
    line-height: 1.7; 
    display: -webkit-box; 
    -webkit-line-clamp: 3; 
    -webkit-box-orient: vertical; 
    overflow: hidden; 
    font-weight: 400;
  }
  
  .post-footer { 
    display: flex; 
    gap: 0.5rem; 
    margin-top: 1.25rem; 
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem; 
    color: var(--text-muted); 
    font-weight: 450;
  }

  /* Footer */
  .footer { 
    border-top: 1px solid var(--border); 
    padding: 2.5rem 0 1.5rem; 
    margin-top: 2rem; 
  }
  
  .footer-inner { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    margin-bottom: 1.5rem;
  }
  
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  
  .footer-logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  
  .footer-logo .logo-xt {
    background: linear-gradient(135deg, #2997ff, #bf5af2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .footer-logo .logo-cer {
    color: var(--text);
    font-weight: 300;
  }
  
  .footer-slogan {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-style: italic;
    font-weight: 400;
  }
  
  .footer-links { 
    display: flex; 
    gap: 2rem; 
  }
  
  .footer-links a { 
    font-family: 'Inter', sans-serif;
    color: var(--text-muted); 
    font-size: 0.875rem;
    transition: color 0.2s;
    font-weight: 450;
  }
  
  .footer-links a:hover { color: var(--text); }
  
  .footer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  /* Navigation Overrides */
  .nav-logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #2997ff, #bf5af2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .nav-links { display: flex; gap: 1.25rem; align-items: center; }
  .nav-link {
    font-family: 'Inter', sans-serif;
  }
  .nav-search-btn {
    background: none; border: none; color: var(--text-muted); cursor: pointer;
    padding: 0.375rem; border-radius: var(--radius-sm); transition: all 0.15s;
    display: flex; align-items: center; justify-content: center;
  }
  .nav-search-btn:hover { color: var(--text); background: var(--surface); }

  /* Responsive */
  @media (max-width: 1024px) { 
    .posts-grid { grid-template-columns: repeat(2, 1fr); } 
  }
  
  @media (max-width: 640px) {
    .hero { 
      padding: 4rem 0 2rem; 
      min-height: auto;
    }
    
    .logo-wrapper {
      font-size: 4rem;
    }
    
    .hero-tagline {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .tagline-divider {
      width: 2px;
      height: 16px;
    }
    
    .hero-slogan {
      font-size: 1.75rem;
    }
    
    .hero-desc {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .desc-dot {
      display: none;
    }
    
    .hero-stats { 
      flex-direction: column; 
      align-items: center; 
      gap: 0.75rem; 
    }
    
    .stat-item { 
      width: 100%; 
      max-width: 220px; 
      padding: 1.25rem 1.5rem;
    }
    
    .stat-number {
      font-size: 1.75rem;
    }
    
    .hero-actions { 
      flex-direction: column; 
      align-items: center; 
    }
    
    .btn-primary, .btn-ghost { 
      width: 100%; 
      max-width: 280px; 
      justify-content: center; 
      padding: 0.875rem 1.75rem;
    }
    
    .posts-grid { grid-template-columns: 1fr; }
    .post-card { padding: 1.25rem; border-radius: 14px; }
    .links-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
    .link-card { padding: 0.875rem; border-radius: 12px; }
    .feed-row { padding: 0.625rem 0.875rem; border-radius: 10px; }
    .feed-summary { display: none; }
    .footer-inner { flex-direction: column; gap: 1.25rem; text-align: center; }
    .footer-brand { align-items: center; }
    .footer-links { gap: 1.5rem; flex-wrap: wrap; justify-content: center; }
    .section-header h2 { font-size: 1.25rem; }
  }
</style>

<script define:vars={{ particlesConfig }}>
  // Search functionality
  document.getElementById('nav-search')?.addEventListener('click', () => {
    document.getElementById('search-modal')!.style.display = 'flex'
    setTimeout(() => (document.getElementById('search-input') as HTMLInputElement)?.focus(), 50)
  })
  
  // Particle System with configurable modes
  class ParticleSystem {
    private canvas: HTMLCanvasElement
    private ctx: CanvasRenderingContext2D
    private particles: Array<{
      x: number
      y: number
      vx: number
      vy: number
      size: number
      opacity: number
    }> = []
    private animationId: number = 0
    private mouse: { x: number; y: number } = { x: -1000, y: -1000 }
    private time: number = 0
    private centerX: number = 0
    private centerY: number = 0
    private config: any
    
    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas
      this.ctx = canvas.getContext('2d')!
      this.config = particlesConfig
      this.resize()
      this.initParticles()
      this.animate()
      
      window.addEventListener('resize', () => {
        this.resize()
        this.particles = []
        this.initParticles()
      })
      window.addEventListener('mousemove', (e) => {
        this.mouse.x = e.clientX
        this.mouse.y = e.clientY
      })
    }
    
    resize() {
      this.canvas.width = window.innerWidth
      this.canvas.height = window.innerHeight
      this.centerX = this.canvas.width / 2
      this.centerY = this.canvas.height / 2
    }
    
    initParticles() {
      const bg = this.config.background_particles
      for (let i = 0; i < bg.count; i++) {
        this.particles.push({
          x: Math.random() * this.canvas.width,
          y: Math.random() * this.canvas.height,
          vx: (Math.random() - 0.5) * bg.speed,
          vy: (Math.random() - 0.5) * bg.speed,
          size: Math.random() * (bg.size_max - bg.size_min) + bg.size_min,
          opacity: Math.random() * (bg.opacity_max - bg.opacity_min) + bg.opacity_min
        })
      }
    }
    
    drawSiriWave() {
      const cfg = this.config.siri_wave
      const cx = this.centerX
      const cy = this.centerY
      
      for (let i = 0; i < cfg.layers; i++) {
        const timeOffset = i * 0.4
        const radius = cfg.base_radius + i * cfg.layer_spacing
        const points = 60
        
        this.ctx.beginPath()
        
        for (let j = 0; j <= points; j++) {
          const angle = (j / points) * Math.PI * 2
          
          const wave1 = Math.sin(angle * cfg.wave_frequency + this.time * cfg.speed + timeOffset) * cfg.wave_amplitude
          const wave2 = Math.sin(angle * (cfg.wave_frequency + 2) - this.time * cfg.speed * 0.75 + timeOffset * 1.5) * (cfg.wave_amplitude * 0.6)
          const wave3 = Math.cos(angle * (cfg.wave_frequency - 1) + this.time * cfg.speed * 1.25 + timeOffset * 0.5) * (cfg.wave_amplitude * 0.75)
          
          const r = radius + wave1 + wave2 + wave3
          const x = cx + Math.cos(angle) * r
          const y = cy + Math.sin(angle) * r
          
          if (j === 0) {
            this.ctx.moveTo(x, y)
          } else {
            this.ctx.lineTo(x, y)
          }
        }
        
        this.ctx.closePath()
        const hue = 200 + i * 15
        const opacity = 0.15 - i * 0.02
        this.ctx.strokeStyle = `hsla(${hue}, 80%, 60%, ${opacity})`
        this.ctx.lineWidth = 2 - i * 0.2
        this.ctx.stroke()
      }
      
      // Center glow
      const glowGradient = this.ctx.createRadialGradient(cx, cy, 0, cx, cy, cfg.base_radius + 40)
      glowGradient.addColorStop(0, 'rgba(41, 151, 255, 0.08)')
      glowGradient.addColorStop(0.5, 'rgba(0, 212, 255, 0.04)')
      glowGradient.addColorStop(1, 'rgba(191, 90, 242, 0)')
      this.ctx.fillStyle = glowGradient
      this.ctx.beginPath()
      this.ctx.arc(cx, cy, cfg.base_radius + 40, 0, Math.PI * 2)
      this.ctx.fill()
    }
    
    drawSingleRing() {
      const cfg = this.config.single_ring
      const cx = this.centerX
      const cy = this.centerY
      const points = 60
      
      this.ctx.beginPath()
      
      for (let j = 0; j <= points; j++) {
        const angle = (j / points) * Math.PI * 2
        const wave = Math.sin(angle * 4 + this.time * cfg.speed) * cfg.wave_amplitude
        const r = cfg.radius + wave
        const x = cx + Math.cos(angle) * r
        const y = cy + Math.sin(angle) * r
        
        if (j === 0) this.ctx.moveTo(x, y)
        else this.ctx.lineTo(x, y)
      }
      
      this.ctx.closePath()
      this.ctx.strokeStyle = `rgba(${cfg.color}, 0.2)`
      this.ctx.lineWidth = 2
      this.ctx.stroke()
    }
    
    drawDoubleRing() {
      const cfg = this.config.double_ring
      const cx = this.centerX
      const cy = this.centerY
      const points = 60
      
      // Inner ring
      this.ctx.beginPath()
      for (let j = 0; j <= points; j++) {
        const angle = (j / points) * Math.PI * 2
        const wave = Math.sin(angle * 3 + this.time * cfg.speed) * cfg.wave_amplitude
        const r = cfg.radius1 + wave
        const x = cx + Math.cos(angle) * r
        const y = cy + Math.sin(angle) * r
        if (j === 0) this.ctx.moveTo(x, y)
        else this.ctx.lineTo(x, y)
      }
      this.ctx.closePath()
      this.ctx.strokeStyle = `rgba(${cfg.color1}, 0.2)`
      this.ctx.lineWidth = 2
      this.ctx.stroke()
      
      // Outer ring
      this.ctx.beginPath()
      for (let j = 0; j <= points; j++) {
        const angle = (j / points) * Math.PI * 2
        const wave = Math.sin(angle * 5 - this.time * cfg.speed * 0.8) * cfg.wave_amplitude
        const r = cfg.radius2 + wave
        const x = cx + Math.cos(angle) * r
        const y = cy + Math.sin(angle) * r
        if (j === 0) this.ctx.moveTo(x, y)
        else this.ctx.lineTo(x, y)
      }
      this.ctx.closePath()
      this.ctx.strokeStyle = `rgba(${cfg.color2}, 0.15)`
      this.ctx.lineWidth = 1.5
      this.ctx.stroke()
    }
    
    drawCenterWave() {
      const mode = this.config.mode
      if (mode === 'siri') this.drawSiriWave()
      else if (mode === 'single') this.drawSingleRing()
      else if (mode === 'double') this.drawDoubleRing()
    }
    
    drawParticles() {
      const bg = this.config.background_particles
      
      this.particles.forEach(p => {
        p.x += p.vx + Math.sin(this.time * 0.01 + p.y * 0.01) * 0.1
        p.y += p.vy + Math.cos(this.time * 0.01 + p.x * 0.01) * 0.1
        
        if (p.x < -10) p.x = this.canvas.width + 10
        if (p.x > this.canvas.width + 10) p.x = -10
        if (p.y < -10) p.y = this.canvas.height + 10
        if (p.y > this.canvas.height + 10) p.y = -10
        
        this.ctx.beginPath()
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2)
        this.ctx.fillStyle = `rgba(${bg.color}, ${p.opacity})`
        this.ctx.fill()
      })
    }
    
    drawMouseEffect() {
      const cfg = this.config.mouse_effect
      if (!cfg.enabled || this.mouse.x < 0) return
      
      const pulse = Math.sin(this.time * cfg.pulse_speed) * 0.5 + 0.5
      
      this.ctx.beginPath()
      this.ctx.arc(this.mouse.x, this.mouse.y, cfg.radius + pulse * 10, 0, Math.PI * 2)
      this.ctx.strokeStyle = `rgba(41, 151, 255, ${0.06 + pulse * 0.03})`
      this.ctx.lineWidth = 1
      this.ctx.stroke()
    }
    
    animate() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height)
      this.time++
      
      this.drawCenterWave()
      this.drawParticles()
      this.drawMouseEffect()
      
      this.animationId = requestAnimationFrame(() => this.animate())
    }
  }
  
  // Initialize
  const canvas = document.getElementById('particles') as HTMLCanvasElement
  if (canvas) {
    new ParticleSystem(canvas)
  }
</script>
