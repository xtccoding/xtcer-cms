---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase'

const authors: Record<string, { name: string; title: string; bio: string; avatar: string; expertise: string[]; social: { github?: string; twitter?: string; website?: string } }> = {
  xtcer: {
    name: 'XTcer',
    title: '技术编辑 / 独立开发者',
    bio: '多年技术从业经验，专注于 AI 应用、网络安全、云原生架构等领域。长期关注全球技术动态，致力于将前沿技术信息以简洁高效的方式传递给读者。',
    avatar: 'XT',
    expertise: ['人工智能', '网络安全', '云计算', '开源开发', 'Web 技术'],
    social: {
      github: 'https://github.com/xtccoding',
      twitter: 'https://twitter.com/xt_cer',
    }
  }
}

const { name } = Astro.params
if (!name || !authors[name]) return Astro.redirect('/about')

const author = authors[name]

const { data: posts } = await supabase
  .from('posts')
  .select('id, title, summary, created_at, views, tags')
  .order('created_at', { ascending: false })
  .limit(50)

const totalViews = posts?.reduce((sum, p) => sum + (p.views || 0), 0) || 0

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": `${author.name} - XTCer`,
    "description": author.bio,
    "url": `https://xtcer.cn/authors/${name}`,
    "mainEntity": {
      "@type": "Person",
      "name": author.name,
      "jobTitle": author.title,
      "description": author.bio,
      "url": `https://xtcer.cn/authors/${name}`,
      "sameAs": Object.values(author.social).filter(Boolean),
      "knowsAbout": author.expertise,
      "worksFor": {
        "@type": "Organization",
        "name": "XTCer",
        "url": "https://xtcer.cn"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://xtcer.cn" },
      { "@type": "ListItem", "position": 2, "name": "关于", "item": "https://xtcer.cn/about" },
      { "@type": "ListItem", "position": 3, "name": author.name, "item": `https://xtcer.cn/authors/${name}` }
    ]
  }
]
---

<Layout title={`${author.name} - XTCer 作者`} description={author.bio} schema={schemas}>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">XTCer</a>
      <div class="nav-links">
        <a href="/" class="nav-link">首页</a>
        <a href="/about" class="nav-link">关于</a>
      </div>
    </div>
  </nav>

  <main class="author-page">
    <div class="container">
      <!-- Author Profile -->
      <header class="author-profile glass-card">
        <div class="profile-top">
          <div class="profile-avatar">{author.avatar}</div>
          <div class="profile-info">
            <h1>{author.name}</h1>
            <p class="profile-title">{author.title}</p>
            <div class="profile-stats">
              <div class="stat">
                <span class="stat-value">{posts?.length || 0}</span>
                <span class="stat-label">文章</span>
              </div>
              <div class="stat">
                <span class="stat-value">{totalViews.toLocaleString()}</span>
                <span class="stat-label">总浏览</span>
              </div>
            </div>
          </div>
        </div>
        <p class="profile-bio">{author.bio}</p>
        <div class="profile-expertise">
          {author.expertise.map(tag => (
            <span class="expertise-tag">#{tag}</span>
          ))}
        </div>
        <div class="profile-links">
          {author.social.github && (
            <a href={author.social.github} target="_blank" rel="noopener" class="social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          )}
          {author.social.twitter && (
            <a href={author.social.twitter} target="_blank" rel="noopener" class="social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              Twitter
            </a>
          )}
        </div>
      </header>

      <!-- Author's Articles -->
      <section class="author-articles">
        <h2>发布的文章</h2>
        {posts && posts.length > 0 ? (
          <div class="articles-grid">
            {posts.map(post => (
              <a href={`/posts/${post.id}`} class="article-card glass-card">
                <h3>{post.title}</h3>
                <p>{post.summary || ''}</p>
                <div class="article-meta">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  {post.views > 0 && <span>{post.views} 次浏览</span>}
                </div>
                {post.tags && post.tags.length > 0 && (
                  <div class="article-tags">
                    {post.tags.slice(0, 3).map(t => (
                      <span class="tag">#{t}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        ) : (
          <p class="no-articles">暂无文章</p>
        )}
      </section>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <span>&copy; 2026 XTCer</span>
        <div class="footer-links">
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .author-page { padding: 2rem 0 4rem; }
  .container { max-width: 900px; margin: 0 auto; padding: 0 2rem; }

  .author-profile {
    padding: 2rem; margin-bottom: 2rem;
  }
  .profile-top {
    display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem;
  }
  .profile-avatar {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, #2997ff, #bf5af2);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.75rem; font-weight: 800; color: #fff;
    flex-shrink: 0;
  }
  .profile-info h1 {
    font-size: 1.75rem; font-weight: 800; color: var(--text);
    letter-spacing: -0.02em; margin: 0 0 0.25rem;
  }
  .profile-title {
    font-size: 0.9375rem; color: var(--text-muted); margin: 0 0 0.75rem;
  }
  .profile-stats {
    display: flex; gap: 1.5rem;
  }
  .stat { display: flex; flex-direction: column; }
  .stat-value { font-size: 1.25rem; font-weight: 700; color: var(--text); }
  .stat-label { font-size: 0.75rem; color: var(--text-muted); }
  .profile-bio {
    font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .profile-expertise {
    display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem;
  }
  .expertise-tag {
    padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8125rem;
    background: rgba(41,151,255,0.08); color: var(--primary);
    border: 1px solid rgba(41,151,255,0.15);
  }
  .profile-links { display: flex; gap: 0.75rem; }
  .social-link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; border-radius: 8px;
    background: var(--surface); border: 1px solid var(--glass-border);
    color: var(--text-secondary); font-size: 0.8125rem; font-weight: 500;
    text-decoration: none; transition: all 0.15s;
  }
  .social-link:hover { background: var(--surface-hover); color: var(--text); }

  .author-articles h2 {
    font-size: 1.375rem; font-weight: 700; margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
  .articles-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;
  }
  .article-card {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 1.25rem; border-radius: 12px; transition: all 0.2s;
  }
  .article-card:hover { transform: translateY(-2px); }
  .article-card h3 {
    font-size: 1rem; font-weight: 600; color: var(--text);
    line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }
  .article-card p {
    font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; margin: 0;
  }
  .article-meta {
    display: flex; gap: 0.75rem; font-size: 0.75rem; color: var(--text-muted);
    margin-top: auto; padding-top: 0.5rem; border-top: 1px solid var(--border);
  }
  .article-tags { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .article-tags .tag {
    font-size: 0.6875rem; color: var(--primary); opacity: 0.7;
  }
  .no-articles {
    text-align: center; padding: 3rem; color: var(--text-muted);
  }

  .footer { border-top: 1px solid var(--border); padding: 2rem 0; margin-top: 2rem; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-muted); }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); }

  @media (max-width: 640px) {
    .profile-top { flex-direction: column; text-align: center; }
    .profile-stats { justify-content: center; }
    .profile-expertise { justify-content: center; }
    .profile-links { justify-content: center; }
    .articles-grid { grid-template-columns: 1fr; }
  }
</style>
