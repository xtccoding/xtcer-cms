---
import Layout from '../layouts/Layout.astro'
import DealCard from '../components/DealCard.astro'
import DealsTable from '../components/DealsTable.astro'
import Pagination from '../components/Pagination.astro'
import FeedbackBox from '../components/FeedbackBox.astro'
import FestivalBanner from '../components/FestivalBanner.astro'
import { listDeals, listLikeTargets } from '../lib/store'
import { resolveSalt } from '../lib/interactions'
import { monthlyCny } from '../lib/price.mjs'
import { resolveFreebie, FREEBIE_META, type FreebieKind } from '../lib/freebie'
import { FESTIVALS, dealMatchesFestival } from '../data/festivals'
import {
  resolveCuration,
  DIFFICULTY_RANK,
  DIFFICULTY_META,
  REFERENCE_META,
  paymentRank,
  type Difficulty,
} from '../data/deal-curation'

// ---------------------------------------------------------------- 查询参数
// 分页 / 视图 / 排序 / 分类全部走 URL（服务端渲染）：
// 每页有独立地址 → 可分享、可前进后退、可被搜索引擎抓；
// 也避免了「只对当前页做前端筛选」这种和分页互相打架的做法。
//
// 为什么不干脆一次全渲染（332 张卡 ≈ 711 KB HTML / 热态约 1s）：
// 分页同时省 CPU 和带宽，比去顶 Cloudflare 的 CPU 上限划算得多。
const PAGE_SIZE = 24

const SORT_OPTIONS = [
  { key: 'difficulty', label: '容易领优先', hint: '完全免费 → 免费额度 → 试用，同档内越好领的排前面' },
  { key: 'price', label: '价格', hint: '按月付人民币从低到高，解析不出价格的沉底' },
  { key: 'payment', label: '支付方式', hint: '完全免费 → 微信 → 支付宝 → 银联 → 信用卡 → PayPal' },
  { key: 'provider', label: '厂商', hint: '按厂商名分组，方便同厂比价' },
] as const

const VIEWS: readonly string[] = ['card', 'table']
const SORTS: readonly string[] = SORT_OPTIONS.map(o => o.key)
/** 「领鸡蛋」类型筛选：默认全部免费；付费优惠降级成一个独立 Tab。 */
const FREE_TABS = ['all', 'full', 'quota', 'trial', 'paid'] as const

const sp = Astro.url.searchParams
const pick = (v: string | null, allowed: readonly string[], fallback: string) =>
  v && allowed.includes(v) ? v : fallback

const view = pick(sp.get('view'), VIEWS, 'card')
const sort = pick(sp.get('sort'), SORTS, 'difficulty')
const freeTab = pick(sp.get('f'), FREE_TABS, 'all')
const catRaw = (sp.get('cat') || '').trim()
const pageParam = Number.parseInt(sp.get('page') || '1', 10)
const requestedPage = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1

// ---------------------------------------------------------------- 取数
const dealsRaw = await listDeals({ includeExpired: false })

const deals = (dealsRaw || []).map(d => {
  const curation = resolveCuration(d.provider, d.product)
  return { ...d, curation, freebie: resolveFreebie(d, curation) }
})

// 大厂标准价参考卡不是优惠，是基准线 —— 单独一个 Tab，不混进主列表。
const referenceDeals = deals.filter(d => d.curation.reference)
// 主列表 = 普通优惠 + 「买赠」补充权益（补充卡在卡片上有 🧩 徽标区分）
const mainDeals = deals.filter(d => !d.curation.reference)

// 免费 / 付费拆开：页面默认只给「能领的」，付费优惠收进独立 Tab。
const freeDeals = mainDeals.filter(d => d.freebie.isFree)
const paidDeals = mainDeals.filter(d => !d.freebie.isFree)
const freeKind = (k: FreebieKind) => freeDeals.filter(d => d.freebie.kind === k)
const freeTabs = [
  { key: 'all', label: '全部免费', icon: '🥚', count: freeDeals.length },
  { key: 'full', label: FREEBIE_META.full.label, icon: FREEBIE_META.full.icon, count: freeKind('full').length },
  { key: 'quota', label: FREEBIE_META.quota.label, icon: FREEBIE_META.quota.icon, count: freeKind('quota').length },
  { key: 'trial', label: FREEBIE_META.trial.label, icon: FREEBIE_META.trial.icon, count: freeKind('trial').length },
  { key: 'paid', label: '付费优惠', icon: '💳', count: paidDeals.length },
] as const

const isReferenceTab = catRaw === 'reference'

// ---------------------------------------------------------------- 节日专区
// cat 形如 'festival-<id>'（如 festival-blackfriday）时进入该节日专区。
// 节日窗口由节日表按日期自动判定，这里只负责「筛选出属于该节日的 deal」。
const festivalMatch = catRaw.match(/^festival-(.+)$/)
const activeFestivalId = festivalMatch ? festivalMatch[1] : ''
const festivalMeta = FESTIVALS.find(f => f.id === activeFestivalId) || null
const isFestivalTab = !!festivalMeta

// 每个节日当前命中的 deal 数，用于 Tab 上的角标（0 条也显示 Tab，方便知道有这个专区）
const festivalCounts: Record<string, number> = {}
for (const f of FESTIVALS) {
  festivalCounts[f.id] = deals.filter(d => !d.curation.reference && dealMatchesFestival(d, f)).length
}

// ---------------------------------------------------------------- 分类
// 分类只从「当前 Tab 的数据」里取 —— 免费区里没有的分类不该出现在筛选条上。
const baseList = isReferenceTab
  ? referenceDeals
  : isFestivalTab
    ? mainDeals.filter(d => dealMatchesFestival(d, festivalMeta!))
    : freeTab === 'paid'
      ? paidDeals
      : freeTab === 'all'
        ? freeDeals
        : freeKind(freeTab as FreebieKind)

const allCategories = [...new Set(baseList.map(d => d.category))]
const categoryMap: Record<string, string> = {
  'compute': '云服务器',
  'nat': 'NAT VPS',
  'container': '容器托管',
  'shared': '虚拟主机',
  'hosting': '静态托管',
  'tunnel': '内网穿透',
  'cdn': 'CDN 加速',
  'storage': '存储',
  'database': '数据库',
  'domain': '域名',
  'ai': 'AI 额度',
  'ai_tool': 'AI 编程',
  'api': 'API',
  'other': '其他',
}
const catLabel = (c: string) => categoryMap[c] || c
const categoryOrder = [
  'compute', 'nat', 'container', 'shared', 'hosting', 'tunnel', 'cdn',
  'storage', 'database', 'domain', 'ai', 'ai_tool', 'api', 'other',
]
const sortedCategories = categoryOrder.filter(c => allCategories.includes(c))
const remainingCats = allCategories.filter(c => !categoryOrder.includes(c))
const categories = [...sortedCategories, ...remainingCats]

const cat = isReferenceTab || isFestivalTab || allCategories.includes(catRaw) ? catRaw : ''

// ---------------------------------------------------------------- 过滤 + 排序
const filtered =
  cat && !isReferenceTab && !isFestivalTab ? baseList.filter(d => d.category === cat) : baseList

/**
 * 排序用的价格键。
 * **不能直接用 price_cny** —— 它是人工录入的，口径不统一（同样 €4.5/月，
 * 有人按 39.15 月租录，有人按 427.68 年付录）。统一从 price 文本重解析成月付人民币。
 * 归不出月租口径的（赠额 / 搭售 / 模糊价 / 按量）一律排到最后，不猜。
 */
const priceKey = (d: (typeof deals)[number]) =>
  monthlyCny(d.price) ?? Number.MAX_SAFE_INTEGER

const payKey = (d: (typeof deals)[number]) =>
  paymentRank(d.curation.payments, d.curation.freeNoCard)

/** 默认排序第一优先级：完全免费(0) → 免费额度(1) → 试用(2) → 付费(3) */
const FREEBIE_RANK: Record<FreebieKind, number> = { full: 0, quota: 1, trial: 2 }
const freeRank = (d: (typeof deals)[number]) =>
  d.freebie.kind ? FREEBIE_RANK[d.freebie.kind] : 3

const sorted = [...filtered].sort((a, b) => {
  switch (sort) {
    case 'price':
      return priceKey(a) - priceKey(b)
    case 'payment': {
      const byPay = payKey(a) - payKey(b)
      return byPay !== 0 ? byPay : priceKey(a) - priceKey(b)
    }
    case 'provider': {
      const byName = a.provider.localeCompare(b.provider, 'zh-Hans-CN')
      return byName !== 0 ? byName : priceKey(a) - priceKey(b)
    }
    default: {
      const byKind = freeRank(a) - freeRank(b)
      if (byKind !== 0) return byKind
      const byDifficulty =
        DIFFICULTY_RANK[a.curation.difficulty] - DIFFICULTY_RANK[b.curation.difficulty]
      if (byDifficulty !== 0) return byDifficulty
      const byPay = payKey(a) - payKey(b)
      return byPay !== 0 ? byPay : priceKey(a) - priceKey(b)
    }
  }
})

// ---------------------------------------------------------------- 分页
const total = sorted.length
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE))
// 页码越界时钳到最后一页（例如从 13 页切到分类只剩 2 页）
const page = Math.min(requestedPage, totalPages)
const pageItems = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)

/** 生成 URL：只写非默认值，保持地址干净。切换分类/排序/视图/Tab 时把 page 归 1。 */
function makeUrl(overrides: {
  view?: string
  sort?: string
  f?: string
  cat?: string
  page?: number
} = {}) {
  const v = overrides.view ?? view
  const s = overrides.sort ?? sort
  const ft = overrides.f ?? freeTab
  const c = overrides.cat ?? cat
  const p = overrides.page ?? page
  const qs = new URLSearchParams()
  if (v !== 'card') qs.set('view', v)
  if (s !== 'difficulty') qs.set('sort', s)
  if (ft !== 'all' && c !== 'reference') qs.set('f', ft)
  if (c) qs.set('cat', c)
  if (p > 1) qs.set('page', String(p))
  const str = qs.toString()
  return str ? `/deals?${str}` : '/deals'
}

// ---------------------------------------------------------------- 卡片分组
// 默认排序下分区：免费 Tab 按「免费类型」分（完全免费 / 额度 / 试用），
// 付费 Tab 按「上手难度」分。其它排序一律平铺网格。
const sectionOrder: Difficulty[] = ['easy', 'medium', 'hard']
const freeSectionOrder: FreebieKind[] = ['full', 'quota', 'trial']
const groupedSections =
  sort === 'difficulty' && !isReferenceTab && !isFestivalTab
    ? (freeTab === 'paid'
        ? sectionOrder.map(key => ({
            key,
            meta: DIFFICULTY_META[key],
            items: pageItems.filter(d => d.curation.difficulty === key),
          }))
        : freeSectionOrder.map(key => ({
            key,
            meta: FREEBIE_META[key],
            items: pageItems.filter(d => d.freebie.kind === key),
          }))
      ).filter(s => s.items.length > 0)
    : null

const sortHint = SORT_OPTIONS.find(o => o.key === sort)?.hint || ''

// ---------------------------------------------------------------- 点赞
// 一次性拉取全站点赞数，在 JS 里聚合成 { target: count }，再传给每张 DealCard，
// 避免每张卡各发一次请求。
const likeCounts: Record<string, number> = {}
let likesTableReady = false
try {
  const targets = await listLikeTargets()
  likesTableReady = true
  for (const target of targets) {
    if (typeof target === 'string') likeCounts[target] = (likeCounts[target] || 0) + 1
  }
} catch (err) {
  console.error('[deals] like counts fetch threw:', err)
}

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const saltReady = resolveSalt(runtimeEnv) !== null
const likesEnabled = likesTableReady && saltReady

// ---------------------------------------------------------------- SEO
// 结构化数据只在第 1 页铺全量，其余页只放当前页，避免 13 份重复的大 JSON-LD。
const schemaDeals = page === 1 && !cat ? baseList : pageItems
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "免费福利 · 云服务免费额度 - XTCer",
  "description": "精选 0 元可领的云服务器、免费额度、AI Token 与限时试用，按领取难度排序",
  "url": "https://xtcer.cn/deals",
  "isPartOf": { "@type": "WebSite", "name": "XTCer", "url": "https://xtcer.cn" },
  "about": { "@type": "Thing", "name": "云服务免费福利" },
  "hasPart": schemaDeals.map(deal => ({
    "@type": "Offer",
    "name": deal.product,
    "description": deal.notes || `${deal.provider} ${deal.product}`,
    "price": deal.price_cny || deal.price_usd,
    "priceCurrency": deal.price_cny ? "CNY" : "USD",
    "availability": deal.is_active ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": { "@type": "Organization", "name": deal.provider },
    ...(deal.url ? { "url": deal.url } : {}),
  })),
}

const pageTitle =
  page > 1 ? `免费福利 第 ${page} 页 - XTCer` : '免费福利 · 云服务免费额度 - XTCer'
---

<Layout title={pageTitle} description="精选 0 元可领的云服务器、免费额度、AI Token 与限时试用，按领取难度排序" schema={schema}>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">XTCer</a>
      <div class="nav-links">
        <a href="/" class="nav-link">首页</a>
        <a href="/deals" class="nav-link" style="color:var(--text)">福利</a>
        <a href="/posts" class="nav-link">文章</a>
        <a href="/feeds" class="nav-link">情报</a>
        <a href="/account" class="nav-link">签到</a>
        <button class="nav-search-btn" id="nav-search" title="搜索 (⌘K)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </div>
    </div>
  </nav>

  <main class="deals-page">
    <div class="container-wide">
      <header class="page-header">
        <div class="page-header-main">
          <h1>免费福利</h1>
          <p class="page-desc">
            0 元可领的云服务器、免费额度、AI Token 与限时试用 —— 大家说的「<strong>领鸡蛋</strong>」都在这。
            默认按 <strong>完全免费 → 免费额度 → 试用</strong> 排，越好领越靠前；
            付费优惠已收进独立 Tab，不占版面。
          </p>
        </div>
        {/* 免费优先级：压成一行小字，放在标题块右侧的空白处，不额外占高度 */}
        <p class="pay-order">
          <span class="pay-order-title">领取优先级</span>
          <span class="pay-order-cn">完全免费 › 免费额度 › 试用</span>
          <span class="pay-order-intl">付费优惠见独立 Tab</span>
        </p>
      </header>

      {/* 节日促销倒计时横幅（黑五 / 双十一 / 双十二；无节日时不渲染） */}
      <FestivalBanner />

      {/* 工具条：视图切换 + 排序。都是链接，切换即刷新（服务端渲染）。 */}
      <div class="toolbar">
        <div class="view-switch" role="group" aria-label="展示方式">
          <a
            class:list={['view-btn', view === 'card' && 'active']}
            href={makeUrl({ view: 'card', page: 1 })}
            aria-current={view === 'card' ? 'true' : undefined}
          >▦ 卡片</a>
          <a
            class:list={['view-btn', view === 'table' && 'active']}
            href={makeUrl({ view: 'table', page: 1 })}
            aria-current={view === 'table' ? 'true' : undefined}
          >☰ 表格</a>
        </div>

        <div class="sort-inline">
          <span class="sort-label">排序</span>
          {SORT_OPTIONS.map(o => (
            <a
              class:list={['sort-btn', sort === o.key && 'active']}
              href={makeUrl({ sort: o.key, page: 1 })}
              title={o.hint}
              aria-current={sort === o.key ? 'true' : undefined}
            >{o.label}</a>
          ))}
        </div>

        <span class="result-count">{total} 条</span>
      </div>

      <p class="sort-hint">{sortHint}</p>

      {/* 主 Tab：免费类型。默认「全部免费」，付费优惠独立成一个 Tab。 */}
      <div class="tabs free-tabs">
        {freeTabs.map(t => (
          <a
            class:list={['tab', 'tab-free', freeTab === t.key && !isReferenceTab && 'active']}
            href={makeUrl({ f: t.key, cat: '', page: 1 })}
          >{t.icon} {t.label}<span class="tab-badge">{t.count}</span></a>
        ))}
      </div>

      {/* 分类 Tab：服务端筛选（分页之后前端筛选只能筛到当前页，所以必须走 URL） */}
      <div class="tabs tabs-sub">
        <a class:list={['tab', !cat && !isReferenceTab && 'active']} href={makeUrl({ cat: '', page: 1 })}>全部</a>
        {/* 节日专区 Tab 放在最前：节令期间是用户最关心的入口，别让它被挤出可视区 */}
        {FESTIVALS.map(f => (
          <a
            class:list={['tab', 'tab-fest', cat === `festival-${f.id}` && 'active']}
            href={makeUrl({ cat: `festival-${f.id}`, page: 1 })}
            style={`--fest-accent:${f.accent}`}
          >{f.icon} {f.label}<span class="tab-badge">{festivalCounts[f.id]}</span></a>
        ))}
        {categories.map(c => (
          <a class:list={['tab', cat === c && 'active']} href={makeUrl({ cat: c, page: 1 })}>{catLabel(c)}</a>
        ))}
        <a
          class:list={['tab', 'tab-ref', isReferenceTab && 'active']}
          href={makeUrl({ cat: 'reference', page: 1 })}
        >{REFERENCE_META.icon} 大厂标准价</a>
      </div>

      {isFestivalTab && festivalMeta && (
        <div class="section-head standalone">
          <h2 class="section-title">
            <span class="section-icon">{festivalMeta.icon}</span>
            {festivalMeta.label} 专区
            <span class="section-count">{total}</span>
          </h2>
          <p class="section-desc">
            {festivalMeta.slogan}。此专区按关键词自动归集与黑五 / 双十一 / 双十二相关的优惠；
            窗口期结束会继续保留常驻优惠，节日专属价请以官网活动页为准。
          </p>
        </div>
      )}

      {isReferenceTab && (
        <div class="section-head standalone">
          <h2 class="section-title">
            <span class="section-icon">{REFERENCE_META.icon}</span>
            {REFERENCE_META.label}
            <span class="section-count">{total}</span>
          </h2>
          <p class="section-desc">{REFERENCE_META.desc}</p>
        </div>
      )}

      {view === 'table' && (
        <DealsTable
          items={pageItems}
          catLabel={catLabel}
          sort={sort}
          hrefForSort={(s: string) => makeUrl({ sort: s, page: 1 })}
        />
      )}

      {view === 'card' && groupedSections && (
        groupedSections.map(section => (
          <section class="diff-section" data-diff={section.key}>
            <div class="section-head">
              <h2 class="section-title">
                <span class="section-icon">{section.meta.icon}</span>
                {section.meta.label}
                <span class="section-count">{section.items.length}</span>
              </h2>
              <p class="section-desc">{section.meta.desc}</p>
            </div>

            <div class="deals-grid">
              {section.items.map(deal => (
                <DealCard
                  deal={deal}
                  freebie={deal.freebie}
                  categoryLabel={catLabel(deal.category)}
                  likeCount={likeCounts[deal.id] || 0}
                  likesEnabled={likesEnabled}
                  userActions={true}
                />
              ))}
            </div>
          </section>
        ))
      )}

      {view === 'card' && !groupedSections && pageItems.length > 0 && (
        <div class="deals-grid">
          {pageItems.map(deal => (
            <DealCard
              deal={deal}
              freebie={deal.freebie}
              categoryLabel={catLabel(deal.category)}
              likeCount={likeCounts[deal.id] || 0}
              likesEnabled={likesEnabled}
              userActions={true}
            />
          ))}
        </div>
      )}

      {total === 0 && (
        <div class="empty">
          <p>该分类下暂无可领的福利</p>
        </div>
      )}

      <Pagination
        page={page}
        totalPages={totalPages}
        total={total}
        pageSize={PAGE_SIZE}
        hrefFor={(p: number) => makeUrl({ page: p })}
      />

      <p class="disclaimer">
        免费额度与试用政策随时会变，领取前请以官网为准。标注「高难度」的免费额度
        <strong>不保证注册成功</strong>，详见 <a href="/posts/df92ea33-2962-4531-acf2-9c57c433b7fb">免费云额度注册避坑指南</a>。
        <br />
        域名：价格为 2026-10 核实的参考价，促销随时变动。<strong>低价后缀首年便宜、续费常翻数倍</strong>，
        长期持有请优先看续费价。国内注册商（阿里云 / 腾讯云 / 百度智能云）需实名认证，
        <strong>要备案就必须用国内注册商</strong>。
      </p>

      <FeedbackBox enabled={saltReady} />
    </div>
  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <span>© 2026 XTCer</span>
        <div class="footer-links">
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // 点击复制优惠码
    document.querySelectorAll<HTMLElement>('.promo-chip').forEach(chip => {
      chip.addEventListener('click', async () => {
        const code = chip.dataset.code || ''
        try {
          await navigator.clipboard.writeText(code)
        } catch {
          const ta = document.createElement('textarea')
          ta.value = code
          document.body.appendChild(ta)
          ta.select()
          document.execCommand('copy')
          ta.remove()
        }
        const badge = chip.querySelector('.promo-copy')
        if (badge) {
          badge.textContent = '已复制'
          setTimeout(() => { badge.textContent = '复制' }, 1500)
        }
      })
    })

    document.getElementById('nav-search')?.addEventListener('click', () => {
      document.getElementById('search-modal')!.style.display = 'flex'
      setTimeout(() => (document.getElementById('search-input') as HTMLInputElement)?.focus(), 50)
    })
  </script>
</Layout>

