---
import Layout from '../layouts/Layout.astro'
import DealCard from '../components/DealCard.astro'
import { supabase } from '../lib/supabase'
import {
  resolveCuration,
  DIFFICULTY_RANK,
  DIFFICULTY_META,
  SUPPLEMENT_META,
  paymentRank,
  type Difficulty,
} from '../data/deal-curation'

const { data: dealsRaw } = await supabase
  .from('deals')
  .select('*')
  .eq('is_active', true)
  // 过期即隐藏：expiry 为空 = 长期有效；有值则必须 >= 今天。
  // expiry 统一存 YYYY-MM-DD，按字符串比较即可。
  .or(`expiry.is.null,expiry.gte.${new Date().toISOString().slice(0, 10)}`)

// 附上人工整理层（难度 / 风险 / 优惠码 / 教程），再排序：
//   1. 难度：容易成功的排最前，Oracle / Azure / GCP / AWS 这类高难度沉到最后
//   2. 支付：同一难度内「国内友好」优先 —— 微信 → 支付宝 → 银联 → 信用卡 → PayPal
//   3. 价格：同为国内友好（或无支付信息）时，便宜的排前面
// 「买其他送域名」这类补充权益单独抽出来，放到最后一块。
const deals = (dealsRaw || [])
  .map(d => ({ ...d, curation: resolveCuration(d.provider, d.product) }))
  .sort((a, b) => {
    const byDifficulty =
      DIFFICULTY_RANK[a.curation.difficulty] - DIFFICULTY_RANK[b.curation.difficulty]
    if (byDifficulty !== 0) return byDifficulty
    const byPayment =
      paymentRank(a.curation.payments, a.curation.freeNoCard) -
      paymentRank(b.curation.payments, b.curation.freeNoCard)
    if (byPayment !== 0) return byPayment
    return (a.price_cny ?? Number.MAX_SAFE_INTEGER) - (b.price_cny ?? Number.MAX_SAFE_INTEGER)
  })

const mainDeals = deals.filter(d => !d.curation.supplement)
const supplementItems = deals.filter(d => d.curation.supplement)

const sectionOrder: Difficulty[] = ['easy', 'medium', 'hard']
const sections = sectionOrder
  .map(key => ({ key, items: mainDeals.filter(d => d.curation.difficulty === key) }))
  .filter(s => s.items.length > 0)

const allCategories = [...new Set(deals.map(d => d.category))]
const categoryMap: Record<string, string> = {
  'compute': '云服务器',
  'nat': 'NAT VPS',
  'container': '容器托管',
  'shared': '虚拟主机',
  'hosting': '静态托管',
  'tunnel': '内网穿透',
  'cdn': 'CDN 加速',
  'storage': '存储',
  'database': '数据库',
  'domain': '域名',
  'ai': 'AI 额度',
  'ai_tool': 'AI 编程',
  'api': 'API',
  'other': '其他',
}
const catLabel = (c: string) => categoryMap[c] || c
const categoryOrder = [
  'compute', 'nat', 'container', 'shared', 'hosting', 'tunnel', 'cdn',
  'storage', 'database', 'domain', 'ai', 'ai_tool', 'api', 'other',
]
const sortedCategories = categoryOrder.filter(c => allCategories.includes(c))
const remaining = allCategories.filter(c => !categoryOrder.includes(c))
const categories = [...sortedCategories, ...remaining]

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "云服务优惠 - XTCer",
  "description": "精选云服务器、AI Token、域名、存储等优惠信息，按上手难度与价格排序",
  "url": "https://xtcer.cn/deals",
  "isPartOf": { "@type": "WebSite", "name": "XTCer", "url": "https://xtcer.cn" },
  "about": { "@type": "Thing", "name": "云服务优惠" },
  "hasPart": deals.map(deal => ({
    "@type": "Offer",
    "name": deal.product,
    "description": deal.notes || `${deal.provider} ${deal.product}`,
    "price": deal.price_cny || deal.price_usd,
    "priceCurrency": deal.price_cny ? "CNY" : "USD",
    "availability": deal.is_active ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": { "@type": "Organization", "name": deal.provider },
    ...(deal.url ? { "url": deal.url } : {}),
  })),
}
---

<Layout title="云服务优惠 - XTCer" description="精选云服务器、AI Token、域名、存储等优惠信息，按上手难度与价格排序" schema={schema}>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">XTCer</a>
      <div class="nav-links">
        <a href="/" class="nav-link">首页</a>
        <a href="/deals" class="nav-link" style="color:var(--text)">优惠</a>
        <a href="/feeds" class="nav-link">情报</a>
        <button class="nav-search-btn" id="nav-search" title="搜索 (⌘K)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </div>
    </div>
  </nav>

  <main class="deals-page">
    <div class="container-wide">
      <header class="page-header">
        <div class="page-header-main">
          <h1>云服务优惠</h1>
          <p class="page-desc">
            排序规则：<strong>上手难度</strong> → <strong>国内支付友好度</strong> → 价格。
            容易成功、能微信 / 支付宝付款的排前面，只能刷海外信用卡、风控严格的沉到最后。
          </p>
        </div>
        {/* 支付优先级：压成一行小字，放在标题块右侧的空白处，不额外占高度 */}
        <p class="pay-order">
          <span class="pay-order-title">支付优先级</span>
          <span class="pay-order-cn">微信 › 支付宝 › 银联</span>
          <span class="pay-order-intl">信用卡 › PayPal › 加密货币</span>
        </p>
      </header>

      <div class="tabs">
        <button class="tab active" data-cat="">全部</button>
        {categories.map(cat => (
          <button class="tab" data-cat={cat}>{catLabel(cat)}</button>
        ))}
      </div>

      {sections.map(section => (
        <section class="diff-section" data-diff={section.key}>
          <div class="section-head">
            <h2 class="section-title">
              <span class="section-icon">{DIFFICULTY_META[section.key].icon}</span>
              {DIFFICULTY_META[section.key].label}
              <span class="section-count">{section.items.length}</span>
            </h2>
            <p class="section-desc">{DIFFICULTY_META[section.key].desc}</p>
          </div>

          <div class="deals-grid">
            {section.items.map(deal => <DealCard deal={deal} categoryLabel={catLabel(deal.category)} />)}
          </div>
        </section>
      ))}

      {supplementItems.length > 0 && (
        <section class="diff-section supplement" data-diff="supplement">
          <div class="section-head">
            <h2 class="section-title">
              <span class="section-icon">{SUPPLEMENT_META.icon}</span>
              {SUPPLEMENT_META.label}
              <span class="section-count">{supplementItems.length}</span>
            </h2>
            <p class="section-desc">{SUPPLEMENT_META.desc}</p>
          </div>

          <div class="deals-grid">
            {supplementItems.map(deal => <DealCard deal={deal} categoryLabel={catLabel(deal.category)} />)}
          </div>
        </section>
      )}

      {deals.length === 0 && (
        <div class="empty">
          <p>暂无优惠信息，敬请期待</p>
        </div>
      )}

      <p class="disclaimer">
        优惠信息与价格会变动，下单前请以官网为准。标注「高难度」的免费额度
        <strong>不保证注册成功</strong>，详见 <a href="/posts/df92ea33-2962-4531-acf2-9c57c433b7fb">免费云额度注册避坑指南</a>。
        <br />
        域名：价格为 2026-10 核实的参考价，促销随时变动。<strong>低价后缀首年便宜、续费常翻数倍</strong>，
        长期持有请优先看续费价。国内注册商（阿里云 / 腾讯云 / 百度智能云）需实名认证，
        <strong>要备案就必须用国内注册商</strong>。
      </p>
    </div>
  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <span>© 2026 XTCer</span>
        <div class="footer-links">
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // 分类筛选：命中后隐藏不匹配的卡片，并隐藏空掉的难度分区。
    function applyFilter(cat: string) {
      document.querySelectorAll<HTMLElement>('.deal-card').forEach(card => {
        card.style.display = (!cat || card.dataset.cat === cat) ? '' : 'none'
      })
      document.querySelectorAll<HTMLElement>('.diff-section').forEach(section => {
        const anyVisible = [...section.querySelectorAll<HTMLElement>('.deal-card')]
          .some(c => c.style.display !== 'none')
        section.style.display = anyVisible ? '' : 'none'
      })
    }

    document.querySelectorAll<HTMLElement>('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'))
        tab.classList.add('active')
        applyFilter(tab.dataset.cat || '')
      })
    })

    // 点击复制优惠码
    document.querySelectorAll<HTMLElement>('.promo-chip').forEach(chip => {
      chip.addEventListener('click', async () => {
        const code = chip.dataset.code || ''
        try {
          await navigator.clipboard.writeText(code)
        } catch {
          const ta = document.createElement('textarea')
          ta.value = code
          document.body.appendChild(ta)
          ta.select()
          document.execCommand('copy')
          ta.remove()
        }
        const badge = chip.querySelector('.promo-copy')
        if (badge) {
          badge.textContent = '已复制'
          setTimeout(() => { badge.textContent = '复制' }, 1500)
        }
      })
    })

    document.getElementById('nav-search')?.addEventListener('click', () => {
      document.getElementById('search-modal')!.style.display = 'flex'
      setTimeout(() => (document.getElementById('search-input') as HTMLInputElement)?.focus(), 50)
    })
  </script>
</Layout>

<style>
  .deals-page { padding: 1.5rem 0 2.5rem; }

  /* 标题块 + 支付优先级：并排。支付优先级塞进标题右侧的空白里，不额外占高度 */
  .page-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: 0.5rem 2rem; margin-bottom: 1.25rem;
  }
  .page-header-main { min-width: 0; flex: 1 1 22rem; }
  .page-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700;
    letter-spacing: -0.02em; margin-bottom: 0.5rem;
  }
  .page-desc { color: var(--text-muted); font-size: 0.9375rem; }
  .page-desc strong { color: var(--text); }

  /* 支付优先级：一行小字、纯文字、无边框无底色 —— 贴合背景不突兀 */
  .pay-order {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.375rem;
    margin: 0 0 0.25rem; font-size: 0.75rem; line-height: 1.6;
    color: var(--text-muted);
  }
  .pay-order-title { font-weight: 700; color: var(--text-secondary); }
  .pay-order-cn { color: #1a8f3c; font-weight: 600; }
  .pay-order-intl { color: var(--text-muted); }
  .pay-order-cn::after { content: ' › '; color: var(--text-muted); font-weight: 400; }

  /* 分类 Tab：始终**一行**横向滑动。滚动条隐藏（默认那条灰条太突兀），
     也不做渐隐 —— 右缘被切掉半个 chip 本身就是"还能滑"的提示。 */
  .tabs {
    display: flex; flex-wrap: nowrap; gap: 0.5rem;
    margin-bottom: 1.25rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .tabs::-webkit-scrollbar { display: none; height: 0; }
  .tab {
    padding: 0.5rem 1rem; border: 1px solid var(--glass-border); border-radius: 999px;
    background: var(--surface); color: var(--text-muted); font-size: 0.8125rem;
    cursor: pointer; white-space: nowrap; transition: all 0.15s;
  }
  .tab:hover { color: var(--text); border-color: var(--glass-border-hover); }
  .tab.active { background: var(--primary); color: white; border-color: var(--primary); }

  /* 大块（难度分区）之间收紧，卡片内部也收紧 —— 纯信息展示，密集优先 */
  .diff-section { margin-bottom: 1.5rem; }
  .section-head {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.125rem 0.625rem;
    margin-bottom: 0.625rem; padding-bottom: 0.375rem; border-bottom: 1px solid var(--border);
  }
  .section-title {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.01em;
  }
  .section-icon { font-size: 0.9375rem; }
  .section-count {
    font-size: 0.6875rem; font-weight: 600; color: var(--text-muted);
    background: var(--surface); border: 1px solid var(--glass-border);
    border-radius: 999px; padding: 0.0625rem 0.5rem;
  }
  .section-desc { color: var(--text-muted); font-size: 0.75rem; margin: 0; }
  .diff-section.supplement .section-head { border-bottom-style: dashed; }

  .deals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(292px, 1fr));
    gap: 0.625rem;
    align-items: start;
  }

  .disclaimer {
    margin-top: 1rem; padding: 0.875rem 1rem; border-radius: var(--radius-sm);
    background: var(--surface); border: 1px solid var(--border);
    font-size: 0.75rem; color: var(--text-muted); line-height: 1.6;
  }
  .disclaimer a { color: var(--primary); }
  .disclaimer strong { color: var(--text-secondary); }

  .empty { text-align: center; padding: 4rem; }
  .empty p { color: var(--text-muted); font-size: 1rem; }

  .footer { border-top: 1px solid var(--border); padding: 1.5rem 0; margin-top: 1rem; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-muted); }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); }

  .nav-links { display: flex; gap: 1.25rem; align-items: center; }
  .nav-search-btn {
    background: none; border: none; color: var(--text-muted); cursor: pointer;
    padding: 0.375rem; border-radius: var(--radius-sm); transition: all 0.15s;
    display: flex; align-items: center; justify-content: center;
  }
  .nav-search-btn:hover { color: var(--text); background: var(--surface); }

  @media (max-width: 640px) {
    .deals-grid { grid-template-columns: 1fr; }
    .footer-inner { flex-direction: column; gap: 1rem; }
  }
</style>
