---
import Layout from '../layouts/Layout.astro'
import { supabase } from '../lib/supabase'
import {
  resolveCuration,
  DIFFICULTY_RANK,
  DIFFICULTY_META,
  type Difficulty,
} from '../data/deal-curation'

const { data: dealsRaw } = await supabase
  .from('deals')
  .select('*')
  .eq('is_active', true)
  // 过期即隐藏：expiry 为空 = 长期有效；有值则必须 >= 今天。
  // expiry 统一存 YYYY-MM-DD，按字符串比较即可。
  .or(`expiry.is.null,expiry.gte.${new Date().toISOString().slice(0, 10)}`)

// 附上人工整理层（难度 / 风险 / 优惠码 / 教程），再按「难度 → 价格」排序：
// 容易成功、低价的排最前，Oracle / Azure / GCP / AWS 这类高难度沉到最后。
const deals = (dealsRaw || [])
  .map(d => ({ ...d, curation: resolveCuration(d.provider, d.product) }))
  .sort((a, b) => {
    const byDifficulty =
      DIFFICULTY_RANK[a.curation.difficulty] - DIFFICULTY_RANK[b.curation.difficulty]
    if (byDifficulty !== 0) return byDifficulty
    return (a.price_cny ?? Number.MAX_SAFE_INTEGER) - (b.price_cny ?? Number.MAX_SAFE_INTEGER)
  })

const sectionOrder: Difficulty[] = ['easy', 'medium', 'hard']
const sections = sectionOrder
  .map(key => ({ key, items: deals.filter(d => d.curation.difficulty === key) }))
  .filter(s => s.items.length > 0)

const allCategories = [...new Set(deals.map(d => d.category))]
const categoryMap: Record<string, string> = {
  'compute': '计算',
  'ai': 'AI Token',
  'api': 'API',
  'storage': '存储',
  'tray': '托盘',
  'hosting': '托管',
  'database': '数据库',
  'domain': '域名',
  'other': '其他',
}
const categoryOrder = ['compute', 'ai', 'api', 'storage', 'database', 'hosting', 'domain', 'tray', 'other']
const sortedCategories = categoryOrder.filter(c => allCategories.includes(c))
const remaining = allCategories.filter(c => !categoryOrder.includes(c))
const categories = [...sortedCategories, ...remaining]

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "云服务优惠 - XTCer",
  "description": "精选云服务器、AI Token、存储等优惠信息，按上手难度与价格排序",
  "url": "https://xtcer.cn/deals",
  "isPartOf": { "@type": "WebSite", "name": "XTCer", "url": "https://xtcer.cn" },
  "about": { "@type": "Thing", "name": "云服务优惠" },
  "hasPart": deals.map(deal => ({
    "@type": "Offer",
    "name": deal.product,
    "description": deal.notes || `${deal.provider} ${deal.product}`,
    "price": deal.price_cny || deal.price_usd,
    "priceCurrency": deal.price_cny ? "CNY" : "USD",
    "availability": deal.is_active ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": { "@type": "Organization", "name": deal.provider },
    ...(deal.url ? { "url": deal.url } : {}),
  })),
}
---

<Layout title="云服务优惠 - XTCer" description="精选云服务器、AI Token、存储等优惠信息，按上手难度与价格排序" schema={schema}>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">XTCer</a>
      <div class="nav-links">
        <a href="/" class="nav-link">首页</a>
        <a href="/deals" class="nav-link" style="color:var(--text)">优惠</a>
        <a href="/feeds" class="nav-link">情报</a>
        <button class="nav-search-btn" id="nav-search" title="搜索 (⌘K)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </div>
    </div>
  </nav>

  <main class="deals-page">
    <div class="container-wide">
      <header class="page-header">
        <h1>云服务优惠</h1>
        <p class="page-desc">按<strong>上手难度</strong>排序：容易成功、低价的排前面，需要信用卡 / 风控严格的沉到最后</p>
      </header>

      <div class="tabs">
        <button class="tab active" data-cat="">全部</button>
        {categories.map(cat => (
          <button class="tab" data-cat={cat}>{categoryMap[cat] || cat}</button>
        ))}
      </div>

      {sections.map(section => (
        <section class="diff-section" data-diff={section.key}>
          <div class="section-head">
            <h2 class="section-title">
              <span class="section-icon">{DIFFICULTY_META[section.key].icon}</span>
              {DIFFICULTY_META[section.key].label}
              <span class="section-count">{section.items.length}</span>
            </h2>
            <p class="section-desc">{DIFFICULTY_META[section.key].desc}</p>
          </div>

          <div class="deals-grid">
            {section.items.map(deal => (
              <div class="deal-card glass-card" data-cat={deal.category} data-diff={deal.curation.difficulty}>
                <div class="deal-header">
                  <span class="deal-provider">{deal.provider}</span>
                  <span class="deal-badge">{categoryMap[deal.category] || deal.category}</span>
                </div>
                <h3 class="deal-product">
                  {deal.url ? <a href={deal.url} target="_blank" rel="noopener">{deal.product}</a> : deal.product}
                </h3>
                <div class="deal-price">
                  <span class="price-value">{deal.price}</span>
                  {deal.price_cny ? <span class="price-cny">≈ ¥{deal.price_cny}</span> : null}
                </div>
                <div class="deal-specs">
                  {deal.config && <span class="spec">🖥 {deal.config}</span>}
                  {deal.bandwidth && <span class="spec">📡 {deal.bandwidth}</span>}
                  {deal.region && <span class="spec">🌍 {deal.region}</span>}
                </div>

                {deal.curation.promo && (
                  <button class="promo-chip" data-code={deal.curation.promo} title="点击复制优惠码">
                    🎁 优惠码 <code>{deal.curation.promo}</code>
                    <span class="promo-copy">复制</span>
                  </button>
                )}
                {deal.curation.promoNote && <p class="promo-note">{deal.curation.promoNote}</p>}

                {deal.curation.warning && (
                  <p class="deal-warning">⚠️ {deal.curation.warning}</p>
                )}

                {deal.notes && <p class="deal-notes">{deal.notes}</p>}

                {deal.curation.tips && deal.curation.tips.length > 0 && (
                  <ul class="deal-tips">
                    {deal.curation.tips.map(tip => <li>{tip}</li>)}
                  </ul>
                )}

                <div class="deal-footer">
                  <div class="deal-footer-left">
                    {deal.type && <span class="deal-type">{deal.type}</span>}
                    {deal.expiry && <span class="deal-expiry">截止: {deal.expiry}</span>}
                  </div>
                  {deal.curation.tutorialUrl && (
                    <a class="tutorial-link" href={deal.curation.tutorialUrl}>注册教程 →</a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      {deals.length === 0 && (
        <div class="empty">
          <p>暂无优惠信息，敬请期待</p>
        </div>
      )}

      <p class="disclaimer">
        优惠信息与价格会变动，下单前请以官网为准。标注「高难度」的免费额度
        <strong>不保证注册成功</strong>，详见 <a href="/posts/df92ea33-2962-4531-acf2-9c57c433b7fb">免费云额度注册避坑指南</a>。
      </p>
    </div>
  </main>

  <footer class="footer">
    <div class="container-wide">
      <div class="footer-inner">
        <span>© 2026 XTCer</span>
        <div class="footer-links">
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // 分类筛选：命中后隐藏不匹配的卡片，并隐藏空掉的难度分区。
    function applyFilter(cat: string) {
      document.querySelectorAll<HTMLElement>('.deal-card').forEach(card => {
        card.style.display = (!cat || card.dataset.cat === cat) ? '' : 'none'
      })
      document.querySelectorAll<HTMLElement>('.diff-section').forEach(section => {
        const anyVisible = [...section.querySelectorAll<HTMLElement>('.deal-card')]
          .some(c => c.style.display !== 'none')
        section.style.display = anyVisible ? '' : 'none'
      })
    }

    document.querySelectorAll<HTMLElement>('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'))
        tab.classList.add('active')
        applyFilter(tab.dataset.cat || '')
      })
    })

    // 点击复制优惠码
    document.querySelectorAll<HTMLElement>('.promo-chip').forEach(chip => {
      chip.addEventListener('click', async () => {
        const code = chip.dataset.code || ''
        try {
          await navigator.clipboard.writeText(code)
        } catch {
          const ta = document.createElement('textarea')
          ta.value = code
          document.body.appendChild(ta)
          ta.select()
          document.execCommand('copy')
          ta.remove()
        }
        const badge = chip.querySelector('.promo-copy')
        if (badge) {
          badge.textContent = '已复制'
          setTimeout(() => { badge.textContent = '复制' }, 1500)
        }
      })
    })

    document.getElementById('nav-search')?.addEventListener('click', () => {
      document.getElementById('search-modal')!.style.display = 'flex'
      setTimeout(() => (document.getElementById('search-input') as HTMLInputElement)?.focus(), 50)
    })
  </script>
</Layout>

<style>
  .deals-page { padding: 2rem 0 4rem; }

  .page-header { margin-bottom: 2rem; }
  .page-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700;
    letter-spacing: -0.02em; margin-bottom: 0.5rem;
  }
  .page-desc { color: var(--text-muted); font-size: 0.9375rem; }
  .page-desc strong { color: var(--text); }

  .tabs {
    display: flex; gap: 0.5rem; margin-bottom: 2rem;
    overflow-x: auto; padding-bottom: 0.25rem;
    -webkit-overflow-scrolling: touch;
  }
  .tab {
    padding: 0.5rem 1rem; border: 1px solid var(--glass-border); border-radius: 999px;
    background: var(--surface); color: var(--text-muted); font-size: 0.8125rem;
    cursor: pointer; white-space: nowrap; transition: all 0.15s;
  }
  .tab:hover { color: var(--text); border-color: var(--glass-border-hover); }
  .tab.active { background: var(--primary); color: white; border-color: var(--primary); }

  .diff-section { margin-bottom: 2.5rem; }
  .section-head { margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }
  .section-title {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em;
  }
  .section-icon { font-size: 1rem; }
  .section-count {
    font-size: 0.6875rem; font-weight: 600; color: var(--text-muted);
    background: var(--surface); border: 1px solid var(--glass-border);
    border-radius: 999px; padding: 0.0625rem 0.5rem;
  }
  .section-desc { color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.25rem; }

  .deals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
  }

  .deal-card {
    padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.625rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .deal-card:hover { transform: translateY(-2px); }
  .deal-card[data-diff='hard'] { border-left: 3px solid var(--orange); }

  .deal-header { display: flex; justify-content: space-between; align-items: center; }
  .deal-provider { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .deal-badge {
    padding: 0.125rem 0.5rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 500;
    background: rgba(41,151,255,0.08); color: var(--primary);
    border: 1px solid rgba(41,151,255,0.15);
  }

  .deal-product { font-size: 1rem; font-weight: 600; line-height: 1.4; }
  .deal-product a { color: var(--text); }
  .deal-product a:hover { color: var(--primary); }

  .deal-price { display: flex; align-items: baseline; gap: 0.5rem; }
  .price-value { font-size: 1.25rem; font-weight: 700; color: var(--green); }
  .price-cny { font-size: 0.75rem; color: var(--text-muted); }

  .deal-specs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .spec { font-size: 0.75rem; color: var(--text-secondary); }

  .promo-chip {
    display: flex; align-items: center; gap: 0.5rem; width: 100%;
    padding: 0.5rem 0.75rem; border-radius: var(--radius-sm);
    background: rgba(41,151,255,0.06); border: 1px dashed rgba(41,151,255,0.35);
    color: var(--text); font-size: 0.75rem; cursor: pointer; text-align: left;
    transition: background 0.15s, border-color 0.15s;
  }
  .promo-chip:hover { background: rgba(41,151,255,0.12); border-color: var(--primary); }
  .promo-chip code { font-weight: 700; color: var(--primary); letter-spacing: 0.03em; }
  .promo-copy { margin-left: auto; font-size: 0.6875rem; color: var(--text-muted); }
  .promo-note { font-size: 0.6875rem; color: var(--text-muted); }

  .deal-warning {
    font-size: 0.75rem; color: var(--text-secondary); line-height: 1.5;
    padding: 0.5rem 0.75rem; background: rgba(255,159,10,0.06);
    border-radius: var(--radius-sm); border-left: 2px solid var(--orange);
  }

  .deal-notes {
    font-size: 0.75rem; color: var(--text-muted); line-height: 1.5;
    padding: 0.5rem 0.75rem; background: rgba(255,255,255,0.02);
    border-radius: var(--radius-sm); border-left: 2px solid var(--primary);
  }

  .deal-tips { margin: 0; padding-left: 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .deal-tips li { font-size: 0.6875rem; color: var(--text-muted); line-height: 1.4; }

  .deal-footer {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    margin-top: auto; padding-top: 0.5rem; border-top: 1px solid var(--border);
  }
  .deal-footer-left { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .deal-type { font-size: 0.6875rem; color: var(--text-muted); }
  .deal-expiry { font-size: 0.6875rem; color: var(--orange); }
  .tutorial-link { font-size: 0.75rem; font-weight: 600; color: var(--primary); white-space: nowrap; }
  .tutorial-link:hover { text-decoration: underline; }

  .disclaimer {
    margin-top: 1.5rem; padding: 0.875rem 1rem; border-radius: var(--radius-sm);
    background: var(--surface); border: 1px solid var(--border);
    font-size: 0.75rem; color: var(--text-muted); line-height: 1.6;
  }
  .disclaimer a { color: var(--primary); }
  .disclaimer strong { color: var(--text-secondary); }

  .empty { text-align: center; padding: 4rem; }
  .empty p { color: var(--text-muted); font-size: 1rem; }

  .footer { border-top: 1px solid var(--border); padding: 2rem 0; margin-top: 2rem; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-muted); }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); }

  .nav-links { display: flex; gap: 1.25rem; align-items: center; }
  .nav-search-btn {
    background: none; border: none; color: var(--text-muted); cursor: pointer;
    padding: 0.375rem; border-radius: var(--radius-sm); transition: all 0.15s;
    display: flex; align-items: center; justify-content: center;
  }
  .nav-search-btn:hover { color: var(--text); background: var(--surface); }

  @media (max-width: 640px) {
    .deals-grid { grid-template-columns: 1fr; }
    .footer-inner { flex-direction: column; gap: 1rem; }
  }
</style>
