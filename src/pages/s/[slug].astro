---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase'

function formatSize(bytes: number): string {
  if (bytes < 1024) return bytes + ' B'
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB'
  return (bytes / 1024 / 1024).toFixed(1) + ' MB'
}

const { slug } = Astro.params
if (!slug) return Astro.redirect('/')

const { data: file } = await supabase
  .from('files')
  .select('*')
  .eq('share_slug', slug)
  .single()

if (!file) return new Response('File not found', { status: 404 })

if (file.expires_at && new Date(file.expires_at) < new Date()) {
  return new Response('File expired', { status: 410 })
}

const needsPassword = !!file.password
const isImage = file.content_type?.startsWith('image/')
const isVideo = file.content_type?.startsWith('video/')
const isAudio = file.content_type?.startsWith('audio/')
const isPdf = file.content_type === 'application/pdf'
const fileHash = file.key?.match(/files\/([a-f0-9]+)/)?.[1] || ''
---

<Layout title={`${file.filename} - XTCer`}>
  <div class="share-page">
    <div class="share-card glass-card" id="share-card">
      {needsPassword ? (
        <div id="password-gate">
          <div class="share-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h2>{file.filename}</h2>
          <p class="share-muted">此文件需要密码访问</p>
          <div style="display:flex;gap:0.5rem;margin-top:1rem">
            <input type="password" id="pw-input" class="input" placeholder="输入密码" style="flex:1" />
            <button class="btn btn-primary" id="pw-submit">访问</button>
          </div>
          <p id="pw-error" style="color:var(--red);font-size:0.75rem;display:none;margin-top:0.5rem">密码错误</p>
        </div>
      ) : (
        <div id="file-content">
          <div class="share-header">
            <h2>{file.filename}</h2>
            <div class="share-meta-row">
              <span>{formatSize(file.size || 0)} · {file.downloads || 0} 次下载</span>
              {fileHash && (
                <span class="share-hash" title={fileHash} onclick={`navigator.clipboard.writeText('${fileHash}');this.textContent='已复制';setTimeout(()=>this.textContent='SHA256: ${fileHash.substring(0,12)}…',1500)`}>
                  SHA256: {fileHash.substring(0,12)}…
                </span>
              )}
            </div>
          </div>
          {isImage && (
            <div class="share-preview">
              <img src={file.url} alt={file.filename} loading="lazy" />
            </div>
          )}
          {isVideo && (
            <div class="share-preview">
              <video src={file.url} controls preload="metadata" />
            </div>
          )}
          {isAudio && (
            <div class="share-preview" style="padding:2rem 0">
              <audio src={file.url} controls preload="metadata" style="width:100%" />
            </div>
          )}
          {isPdf && (
            <div class="share-preview">
              <iframe src={file.url} title={file.filename} />
            </div>
          )}
          {!isImage && !isVideo && !isAudio && !isPdf && (
            <div class="share-icon">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
          )}
          <a href={file.url} download={file.filename} class="btn btn-primary share-download" id="download-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            下载文件
          </a>
        </div>
      )}
    </div>
    <footer class="share-footer">
      <a href="/">XTCer</a>
    </footer>
  </div>

  {needsPassword && (
    <script define:vars={{ slug, fileUrl: file.url, filename: file.filename, fileSize: file.size, downloads: file.downloads }}>
      document.getElementById('pw-submit')?.addEventListener('click', async () => {
        const pw = (document.getElementById('pw-input')).value
        const res = await fetch('/api/files/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, password: pw })
        })
        if (res.ok) {
          const data = await res.json()
          document.getElementById('password-gate').innerHTML = `
            <div class="share-header">
              <h2>${filename}</h2>
              <span class="share-meta">${(fileSize / 1024 / 1024).toFixed(1)} MB · ${downloads || 0} 次下载</span>
            </div>
            <a href="${data.url}" download="${filename}" class="btn btn-primary share-download">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              下载文件
            </a>
          `
        } else {
          document.getElementById('pw-error').style.display = ''
        }
      })
      document.getElementById('pw-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('pw-submit').click()
      })
    </script>
  )}

  <script>
    document.getElementById('download-btn')?.addEventListener('click', async () => {
      const slug = window.location.pathname.split('/s/')[1]
      fetch('/api/files/download', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }) })
    })
  </script>
</Layout>

<style>
  .share-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; }
  .share-card { max-width: 640px; width: 100%; padding: 2.5rem; text-align: center; }
  .share-card h2 { font-size: 1.125rem; word-break: break-all; margin-bottom: 0.5rem; }
  .share-muted { color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.5rem; }
  .share-icon { margin: 1.5rem 0; }
  .share-header { margin-bottom: 1.25rem; }
  .share-meta-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: center; font-size: 0.75rem; color: var(--text-muted); }
  .share-hash {
    font-family: 'SF Mono', monospace; font-size: 0.6875rem;
    background: rgba(255,255,255,0.05); padding: 0.125rem 0.5rem;
    border-radius: 3px; cursor: pointer; transition: all 0.15s;
  }
  .share-hash:hover { background: rgba(41,151,255,0.1); color: var(--primary); }
  .share-preview { margin: 1rem 0; border-radius: var(--radius); overflow: hidden; background: rgba(0,0,0,0.2); }
  .share-preview img { max-width: 100%; max-height: 480px; display: block; margin: 0 auto; }
  .share-preview video { max-width: 100%; max-height: 480px; display: block; margin: 0 auto; }
  .share-preview iframe { width: 100%; height: 480px; border: none; }
  .share-download { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; padding: 0.625rem 1.5rem; font-size: 0.875rem; text-decoration: none; }
  .share-footer { margin-top: 2rem; font-size: 0.75rem; color: var(--text-muted); }
  .share-footer a { color: var(--primary); text-decoration: none; }
</style>
