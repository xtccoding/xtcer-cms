---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')

// Dynamic gallery slug check
const { slug } = Astro.params
const gallerySlug = Astro.cookies.get('gallery_slug')?.value
if (!gallerySlug || slug !== gallerySlug) return Astro.redirect('/admin')
---

<Layout title="图床管理 - XTCer">
  <div class="admin-layout">
    <Sidebar active="gallery" />
    <div class="admin-main">
      <header class="admin-header">
        <div>
          <h1>图床管理</h1>
          <p class="admin-subtitle">R2 图片存储 · 按内容 hash 去重</p>
        </div>
        <div class="header-actions">
          <input type="file" id="upload-input" accept="image/*" multiple style="display:none" />
          <button class="btn btn-primary btn-sm" id="upload-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            上传图片
          </button>
          <button class="btn btn-ghost btn-sm" id="refresh-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
            刷新
          </button>
        </div>
      </header>

      <div class="upload-zone" id="upload-zone">
        <div class="upload-zone-inner">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <p>拖拽图片到这里上传，或 <span class="upload-link" id="upload-link">点击选择</span></p>
          <small>支持 JPG / PNG / GIF / WebP / SVG · 最大 10MB · 自动按内容 hash 去重</small>
        </div>
      </div>

      <div class="gallery-stats" id="gallery-stats"></div>

      <div class="gallery-toolbar glass-card">
        <div class="search-row">
          <input type="text" id="gallery-search" class="input" placeholder="搜索文件名、hash..." />
          <input type="date" id="date-from" class="input date-input" title="开始日期" />
          <input type="date" id="date-to" class="input date-input" title="结束日期" />
          <button class="btn btn-ghost btn-sm" id="search-btn">搜索</button>
          <button class="btn btn-ghost btn-sm" id="reset-btn" style="display:none">重置</button>
        </div>
        <div class="tags-row" id="tags-row"></div>
      </div>

      <div class="gallery-grid" id="gallery-grid"></div>

      <div class="gallery-pagination" id="gallery-pagination"></div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" style="display:none">
    <div class="lightbox-backdrop"></div>
    <button class="lightbox-close" id="lightbox-close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lightbox-nav lightbox-next" id="lightbox-next">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-info" id="lightbox-info"></div>
    <div class="lightbox-actions" id="lightbox-actions"></div>
  </div>

  <div id="delete-modal" class="modal" style="display:none">
    <div class="modal-backdrop"></div>
    <div class="modal-content glass-card">
      <h3>确认删除</h3>
      <p>删除后不可恢复，引用此图片的文章将显示裂图。</p>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancel-delete">取消</button>
        <button class="btn btn-danger" id="confirm-delete">删除</button>
      </div>
    </div>
  </div>

  <div id="tag-modal" class="modal" style="display:none">
    <div class="modal-backdrop"></div>
    <div class="modal-content glass-card" style="max-width:420px">
      <h3>编辑标签</h3>
      <div id="tag-list" class="tag-edit-list" style="margin-bottom:0.75rem"></div>
      <div style="display:flex;gap:0.5rem">
        <input type="text" id="tag-input" class="input" placeholder="输入标签，回车添加" style="flex:1" />
        <button class="btn btn-ghost btn-sm" id="tag-add">添加</button>
      </div>
      <div class="modal-actions" style="margin-top:1rem">
        <button class="btn btn-ghost" id="tag-cancel">取消</button>
        <button class="btn btn-primary" id="tag-save">保存</button>
      </div>
    </div>
  </div>

  <script>
    let deleteId = ''
    let deleteKey = ''
    let currentPage = 1
    let totalPages = 1
    let allFiles: any[] = []
    let allTags: string[] = []
    let lightboxIndex = -1
    let currentSearch = ''
    let currentTag = ''
    let currentDateFrom = ''
    let currentDateTo = ''

    async function loadImages(page = 1) {
      const params = new URLSearchParams({ page: String(page), limit: '50' })
      if (currentSearch) params.set('q', currentSearch)
      if (currentTag) params.set('tag', currentTag)
      if (currentDateFrom) params.set('from', currentDateFrom)
      if (currentDateTo) params.set('to', currentDateTo)

      const res = await fetch(`/api/gallery?${params}`)
      const data = await res.json()

      allFiles = data.files || []
      allTags = data.allTags || []
      currentPage = data.page || 1
      totalPages = data.totalPages || 1
      renderGallery()
      renderPagination()
      renderTags()

      const statsEl = document.getElementById('gallery-stats')!
      statsEl.textContent = `${data.total || allFiles.length} 张图片 · ${((data.totalSize || 0) / 1024 / 1024).toFixed(1)} MB`
    }

    function renderTags() {
      const tagsRow = document.getElementById('tags-row')!
      if (allTags.length === 0) { tagsRow.innerHTML = ''; return }
      tagsRow.innerHTML = '<span class="tags-label">标签:</span>' +
        allTags.map(t => `<button class="tag-btn ${t === currentTag ? 'active' : ''}" data-tag="${escapeHtml(t)}">${escapeHtml(t)}</button>`).join('')
    }

    function formatSize(bytes: number): string {
      if (bytes < 1024) return bytes + ' B'
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB'
      return (bytes / 1024 / 1024).toFixed(1) + ' MB'
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;')
    }

    function renderGallery() {
      const grid = document.getElementById('gallery-grid')!
      grid.innerHTML = allFiles.map((f, i) => {
        const name = escapeHtml(f.filename || f.key?.split('/').pop() || '')
        const tags = (f.tags || []).map((t: string) => `<span class="img-tag" data-tag="${escapeHtml(t)}">${escapeHtml(t)}</span>`).join('')
        return `<div class="gallery-item glass-card" data-index="${i}">
          <div class="gallery-img-wrap" data-index="${i}" style="position:relative;width:100%;padding-top:100%;overflow:hidden;background:rgba(0,0,0,0.3);cursor:pointer;border-radius:var(--radius-sm) var(--radius-sm) 0 0">
            <img src="${escapeHtml(f.url)}" alt="${name}" loading="lazy" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block" />
            <div class="gallery-img-overlay" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4);opacity:0;transition:opacity 0.2s">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </div>
          </div>
          <div style="padding:0.375rem 0.5rem">
            <span style="display:block;font-size:0.625rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${name}">${name}</span>
            <div class="img-tags">${tags}</div>
            <span style="display:block;font-size:0.5625rem;color:var(--text-muted);margin-top:0.125rem">${formatSize(f.size)}</span>
          </div>
          <div style="display:flex;gap:0.25rem;padding:0 0.375rem 0.375rem">
            <button class="btn btn-ghost btn-sm tag-edit-btn" data-id="${f.id}" data-tags='${JSON.stringify(f.tags || [])}' title="编辑标签" style="font-size:0.5625rem;padding:0.1875rem 0.3125rem">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            </button>
            <button class="btn btn-ghost btn-sm copy-url" data-url="${escapeHtml(f.url)}" title="复制链接" style="font-size:0.5625rem;padding:0.1875rem 0.3125rem">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            </button>
            <button class="btn btn-ghost btn-sm copy-md" data-url="${escapeHtml(f.url)}" data-name="${name}" title="复制 MD" style="font-size:0.5625rem;padding:0.1875rem 0.3125rem">MD</button>
            <button class="btn btn-danger btn-sm del-img" data-id="${f.id}" data-key="${escapeHtml(f.key)}" title="删除" style="font-size:0.5625rem;padding:0.1875rem 0.3125rem">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
            </button>
          </div>
        </div>`
      }).join('') || '<div class="empty-state">暂无图片</div>'
    }

    function renderPagination() {
      const el = document.getElementById('gallery-pagination')!
      if (totalPages <= 1) { el.innerHTML = ''; return }

      let html = `<span class="page-info">第 ${currentPage}/${totalPages} 页</span><div class="page-btns">`
      if (currentPage > 1) {
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="1">首页</button>`
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${currentPage - 1}">上一页</button>`
      }
      if (currentPage < totalPages) {
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${currentPage + 1}">下一页</button>`
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${totalPages}">末页</button>`
      }
      html += `</div>`
      el.innerHTML = html
    }

    // Upload
    const uploadInput = document.getElementById('upload-input') as HTMLInputElement
    const uploadBtn = document.getElementById('upload-btn')!
    const uploadLink = document.getElementById('upload-link')!
    const uploadZone = document.getElementById('upload-zone')!

    uploadBtn.addEventListener('click', () => uploadInput.click())
    uploadLink.addEventListener('click', () => uploadInput.click())

    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('dragover') })
    uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'))
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault()
      uploadZone.classList.remove('dragover')
      const files = e.dataTransfer?.files
      if (files?.length) uploadFiles(Array.from(files))
    })

    uploadInput.addEventListener('change', () => {
      const files = uploadInput.files
      if (files?.length) uploadFiles(Array.from(files))
    })

    async function uploadFiles(files: File[]) {
      let success = 0, dedup = 0, failed = 0

      for (const file of files) {
        const formData = new FormData()
        formData.append('file', file)

        try {
          const res = await fetch('/api/upload', { method: 'POST', body: formData })
          const data = await res.json()
          if (res.ok) {
            success++
            if (data.deduplicated) dedup++
          } else {
            failed++
          }
        } catch {
          failed++
        }
      }

      let msg = `上传完成：${success} 张成功`
      if (dedup > 0) msg += `（${dedup} 张去重）`
      if (failed > 0) msg += `，${failed} 张失败`
      ;(window as any).showToast(msg, failed > 0 ? 'error' : 'success')

      uploadInput.value = ''
      loadImages()
    }

    // Search and filter
    const searchInput = document.getElementById('gallery-search') as HTMLInputElement
    const dateFromInput = document.getElementById('date-from') as HTMLInputElement
    const dateToInput = document.getElementById('date-to') as HTMLInputElement
    const searchBtn = document.getElementById('search-btn')!
    const resetBtn = document.getElementById('reset-btn')!

    searchBtn.addEventListener('click', () => {
      currentSearch = searchInput.value.trim()
      currentDateFrom = dateFromInput.value
      currentDateTo = dateToInput.value
      if (currentSearch || currentTag || currentDateFrom || currentDateTo) resetBtn.style.display = ''
      loadImages(1)
    })

    searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') searchBtn.click() })

    resetBtn.addEventListener('click', () => {
      searchInput.value = ''; dateFromInput.value = ''; dateToInput.value = ''
      currentSearch = ''; currentTag = ''; currentDateFrom = ''; currentDateTo = ''
      resetBtn.style.display = 'none'
      loadImages(1)
    })

    // Tag filter click
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement

      const tagBtn = target.closest('.tag-btn') as HTMLElement
      if (tagBtn) {
        currentTag = currentTag === tagBtn.dataset.tag ? '' : (tagBtn.dataset.tag || '')
        if (currentTag || currentSearch || currentDateFrom || currentDateTo) resetBtn.style.display = ''
        loadImages(1)
        return
      }

      const tagEditBtn = target.closest('.tag-edit-btn') as HTMLElement
      if (tagEditBtn) {
        const id = tagEditBtn.dataset.id
        const tags = JSON.parse(tagEditBtn.dataset.tags || '[]')
        openTagEditor(id!, tags)
        return
      }

      const imgTag = target.closest('.img-tag') as HTMLElement
      if (imgTag) {
        currentTag = imgTag.dataset.tag || ''
        if (currentTag) resetBtn.style.display = ''
        loadImages(1)
        return
      }

      const copyBtn = target.closest('.copy-url') as HTMLElement
      const copyMd = target.closest('.copy-md') as HTMLElement

      if (copyBtn) {
        navigator.clipboard.writeText(copyBtn.dataset.url || '')
        ;(window as any).showToast('链接已复制', 'success')
      }
      if (copyMd) {
        const md = `![](${copyMd.dataset.url})`
        navigator.clipboard.writeText(md)
        ;(window as any).showToast('Markdown 已复制', 'success')
      }

      const delBtn = target.closest('.del-img') as HTMLElement
      if (delBtn) {
        deleteId = delBtn.dataset.id || ''
        deleteKey = delBtn.dataset.key || ''
        document.getElementById('delete-modal')!.style.display = 'flex'
      }

      const pageBtn = target.closest('.page-btn') as HTMLElement
      if (pageBtn) {
        const page = parseInt(pageBtn.dataset.page || '1')
        loadImages(page)
        document.querySelector('.gallery-grid')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }
    })

    document.getElementById('cancel-delete')?.addEventListener('click', () => { document.getElementById('delete-modal')!.style.display = 'none' })
    document.querySelector('.modal-backdrop')?.addEventListener('click', () => { document.getElementById('delete-modal')!.style.display = 'none' })
    document.getElementById('confirm-delete')?.addEventListener('click', async () => {
      if (!deleteId && !deleteKey) return
      const res = await fetch('/api/gallery', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: deleteId, key: deleteKey }) })
      if (res.ok) {
        ;(window as any).showToast('已删除', 'success')
        document.getElementById('delete-modal')!.style.display = 'none'
        allFiles = allFiles.filter(f => f.id !== deleteId)
        renderGallery()
      } else {
        ;(window as any).showToast('删除失败', 'error')
      }
    })

    document.getElementById('refresh-btn')?.addEventListener('click', () => loadImages())

    // Lightbox
    const lightbox = document.getElementById('lightbox')!
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement
    const lightboxInfo = document.getElementById('lightbox-info')!
    const lightboxActions = document.getElementById('lightbox-actions')!

    function openLightbox(index: number) {
      if (index < 0 || index >= allFiles.length) return
      lightboxIndex = index
      const f = allFiles[index]
      lightboxImg.src = f.url
      lightboxImg.alt = f.filename || ''
      const name = f.filename || f.key?.split('/').pop() || ''
      lightboxInfo.textContent = `${name} · ${formatSize(f.size)} · ${index + 1}/${allFiles.length}`
      lightboxActions.innerHTML = `
        <button class="btn btn-ghost btn-sm lb-copy-url" data-url="${f.url}">复制链接</button>
        <button class="btn btn-ghost btn-sm lb-copy-md" data-url="${f.url}">复制 MD</button>
      `
      lightbox.style.display = 'flex'
      document.body.style.overflow = 'hidden'
    }

    function closeLightbox() {
      lightbox.style.display = 'none'
      document.body.style.overflow = ''
      lightboxIndex = -1
    }

    // Click image to open lightbox
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const imgWrap = target.closest('.gallery-img-wrap') as HTMLElement
      if (imgWrap) {
        const index = parseInt(imgWrap.dataset.index || '0')
        openLightbox(index)
        return
      }

      // Lightbox actions
      const lbCopyUrl = (e.target as HTMLElement).closest('.lb-copy-url') as HTMLElement
      const lbCopyMd = (e.target as HTMLElement).closest('.lb-copy-md') as HTMLElement
      if (lbCopyUrl) {
        navigator.clipboard.writeText(lbCopyUrl.dataset.url || '')
        ;(window as any).showToast('链接已复制', 'success')
      }
      if (lbCopyMd) {
        navigator.clipboard.writeText(`![](${lbCopyMd.dataset.url})`)
        ;(window as any).showToast('Markdown 已复制', 'success')
      }
    })

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox)
    document.querySelector('.lightbox-backdrop')?.addEventListener('click', closeLightbox)
    document.getElementById('lightbox-prev')?.addEventListener('click', () => openLightbox(lightboxIndex - 1))
    document.getElementById('lightbox-next')?.addEventListener('click', () => openLightbox(lightboxIndex + 1))

    document.addEventListener('keydown', (e) => {
      if (lightbox.style.display !== 'flex') return
      if (e.key === 'Escape') closeLightbox()
      if (e.key === 'ArrowLeft') openLightbox(lightboxIndex - 1)
      if (e.key === 'ArrowRight') openLightbox(lightboxIndex + 1)
    })

    // Tag editor
    let editingTagId = ''
    function openTagEditor(id: string, tags: string[]) {
      editingTagId = id
      const modal = document.getElementById('tag-modal')!
      const input = document.getElementById('tag-input') as HTMLInputElement
      const container = document.getElementById('tag-list')!
      input.value = ''
      renderTagList(container, tags)
      modal.style.display = 'flex'
      input.focus()
    }

    function renderTagList(container: HTMLElement, tags: string[]) {
      container.innerHTML = tags.map(t =>
        `<span class="edit-tag">${escapeHtml(t)} <button class="edit-tag-remove" data-tag="${escapeHtml(t)}">&times;</button></span>`
      ).join('') || '<span style="font-size:0.75rem;color:var(--text-muted)">暂无标签</span>'
    }

    document.getElementById('tag-add')?.addEventListener('click', async () => {
      const input = document.getElementById('tag-input') as HTMLInputElement
      const tag = input.value.trim()
      if (!tag) return
      const container = document.getElementById('tag-list')!
      const currentTags = Array.from(container.querySelectorAll('.edit-tag')).map(el => (el as HTMLElement).dataset.tag!)
      if (!currentTags.includes(tag)) currentTags.push(tag)
      renderTagList(container, currentTags)
      input.value = ''
      input.focus()
    })

    document.getElementById('tag-input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); document.getElementById('tag-add')?.click() }
    })

    document.addEventListener('click', (e) => {
      const removeBtn = (e.target as HTMLElement).closest('.edit-tag-remove') as HTMLElement
      if (removeBtn) {
        const tag = removeBtn.dataset.tag
        const container = document.getElementById('tag-list')!
        const currentTags = Array.from(container.querySelectorAll('.edit-tag')).map(el => (el as HTMLElement).dataset.tag!).filter(t => t !== tag)
        renderTagList(container, currentTags)
      }
    })

    document.getElementById('tag-save')?.addEventListener('click', async () => {
      const container = document.getElementById('tag-list')!
      const tags = Array.from(container.querySelectorAll('.edit-tag')).map(el => (el as HTMLElement).dataset.tag!)
      const res = await fetch('/api/gallery', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: editingTagId, tags }) })
      if (res.ok) {
        const file = allFiles.find(f => f.id === editingTagId)
        if (file) file.tags = tags
        renderGallery()
        ;(window as any).showToast('标签已更新', 'success')
      }
      document.getElementById('tag-modal')!.style.display = 'none'
    })

    document.getElementById('tag-cancel')?.addEventListener('click', () => { document.getElementById('tag-modal')!.style.display = 'none' })

    loadImages()
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.25rem; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
  .admin-header h1 { font-size: 1.375rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.75rem; margin-top: 0.125rem; }
  .header-actions { display: flex; gap: 0.5rem; }

  .upload-zone {
    border: 2px dashed var(--glass-border); border-radius: var(--radius);
    padding: 2rem; margin-bottom: 1.25rem; text-align: center;
    transition: all 0.2s;
  }
  .upload-zone.dragover { border-color: var(--primary); background: rgba(41,151,255,0.04); }
