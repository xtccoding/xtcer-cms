---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')

// Dynamic gallery slug check
const { slug } = Astro.params
const gallerySlug = Astro.cookies.get('gallery_slug')?.value
if (!gallerySlug || slug !== gallerySlug) return Astro.redirect('/admin')
---

<Layout title="图床管理 - XTCer">
  <div class="admin-layout">
    <Sidebar active="gallery" />
    <div class="admin-main">
      <header class="admin-header">
        <div>
          <h1>图床管理</h1>
          <p class="admin-subtitle">R2 图片存储 · 按内容 hash 去重</p>
        </div>
        <div class="header-actions">
          <input type="file" id="upload-input" accept="image/*" multiple style="display:none" />
          <button class="btn btn-primary btn-sm" id="upload-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            上传图片
          </button>
          <button class="btn btn-ghost btn-sm" id="refresh-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
            刷新
          </button>
        </div>
      </header>

      <div class="upload-zone" id="upload-zone">
        <div class="upload-zone-inner">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <p>拖拽图片到这里上传，或 <span class="upload-link" id="upload-link">点击选择</span></p>
          <small>支持 JPG / PNG / GIF / WebP / SVG · 最大 10MB · 自动按内容 hash 去重</small>
        </div>
      </div>

      <div class="gallery-stats" id="gallery-stats"></div>

      <div class="gallery-grid" id="gallery-grid"></div>

      <div class="gallery-pagination" id="gallery-pagination"></div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" style="display:none">
    <div class="lightbox-backdrop"></div>
    <button class="lightbox-close" id="lightbox-close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lightbox-nav lightbox-next" id="lightbox-next">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-info" id="lightbox-info"></div>
    <div class="lightbox-actions" id="lightbox-actions"></div>
  </div>

  <div id="delete-modal" class="modal" style="display:none">
    <div class="modal-backdrop"></div>
    <div class="modal-content glass-card">
      <h3>确认删除</h3>
      <p>删除后不可恢复，引用此图片的文章将显示裂图。</p>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancel-delete">取消</button>
        <button class="btn btn-danger" id="confirm-delete">删除</button>
      </div>
    </div>
  </div>

  <script>
    let deleteId = ''
    let deleteKey = ''
    let currentPage = 1
    let totalPages = 1
    let allFiles: any[] = []
    let lightboxIndex = -1

    async function loadImages(page = 1, append = false) {
      const params = new URLSearchParams({ page: String(page), limit: '50' })
      const res = await fetch(`/api/gallery?${params}`)
      const data = await res.json()

      if (!append) allFiles = []
      allFiles.push(...(data.files || []))

      currentPage = data.page || 1
      totalPages = data.totalPages || 1
      renderGallery()
      renderPagination()

      const statsEl = document.getElementById('gallery-stats')!
      statsEl.textContent = `${data.total || allFiles.length} 张图片 · ${((data.totalSize || 0) / 1024 / 1024).toFixed(1)} MB`
    }

    function formatSize(bytes: number): string {
      if (bytes < 1024) return bytes + ' B'
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB'
      return (bytes / 1024 / 1024).toFixed(1) + ' MB'
    }

    function renderGallery() {
      const grid = document.getElementById('gallery-grid')!
      grid.innerHTML = allFiles.map((f, i) => {
        const name = f.filename || f.key?.split('/').pop() || ''
        const date = f.created_at ? new Date(f.created_at).toLocaleDateString('zh-CN') : ''
        return `<div class="gallery-item glass-card" data-index="${i}">
          <div class="gallery-img-wrap" data-index="${i}">
            <img src="${f.url}" alt="${name}" loading="lazy" />
            <div class="gallery-img-overlay">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </div>
          </div>
          <div class="gallery-info">
            <span class="gallery-name" title="${name}">${name}</span>
            <span class="gallery-meta">${formatSize(f.size)} · ${date}</span>
          </div>
          <div class="gallery-actions">
            <button class="btn btn-ghost btn-sm copy-url" data-url="${f.url}" title="复制链接">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            </button>
            <button class="btn btn-ghost btn-sm copy-md" data-url="${f.url}" data-name="${name}" title="复制 Markdown">
              MD
            </button>
            <button class="btn btn-danger btn-sm del-img" data-id="${f.id}" data-key="${f.key}" title="删除">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
            </button>
          </div>
        </div>`
      }).join('') || '<div class="empty-state">暂无图片</div>'
    }

    function renderPagination() {
      const el = document.getElementById('gallery-pagination')!
      if (totalPages <= 1) { el.innerHTML = ''; return }

      let html = `<span class="page-info">第 ${currentPage}/${totalPages} 页</span><div class="page-btns">`
      if (currentPage > 1) {
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="1">首页</button>`
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${currentPage - 1}">上一页</button>`
      }
      if (currentPage < totalPages) {
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${currentPage + 1}">下一页</button>`
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${totalPages}">末页</button>`
      }
      html += `</div>`
      el.innerHTML = html
    }

    // Upload
    const uploadInput = document.getElementById('upload-input') as HTMLInputElement
    const uploadBtn = document.getElementById('upload-btn')!
    const uploadLink = document.getElementById('upload-link')!
    const uploadZone = document.getElementById('upload-zone')!

    uploadBtn.addEventListener('click', () => uploadInput.click())
    uploadLink.addEventListener('click', () => uploadInput.click())

    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('dragover') })
    uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'))
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault()
      uploadZone.classList.remove('dragover')
      const files = e.dataTransfer?.files
      if (files?.length) uploadFiles(Array.from(files))
    })

    uploadInput.addEventListener('change', () => {
      const files = uploadInput.files
      if (files?.length) uploadFiles(Array.from(files))
    })

    async function uploadFiles(files: File[]) {
      let success = 0, dedup = 0, failed = 0

      for (const file of files) {
        const formData = new FormData()
        formData.append('file', file)

        try {
          const res = await fetch('/api/upload', { method: 'POST', body: formData })
          const data = await res.json()
          if (res.ok) {
            success++
            if (data.deduplicated) dedup++
          } else {
            failed++
          }
        } catch {
          failed++
        }
      }

      let msg = `上传完成：${success} 张成功`
      if (dedup > 0) msg += `（${dedup} 张去重）`
      if (failed > 0) msg += `，${failed} 张失败`
      ;(window as any).showToast(msg, failed > 0 ? 'error' : 'success')

      uploadInput.value = ''
      loadImages()
    }

    // Copy URL
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const copyBtn = target.closest('.copy-url') as HTMLElement
      const copyMd = target.closest('.copy-md') as HTMLElement

      if (copyBtn) {
        navigator.clipboard.writeText(copyBtn.dataset.url || '')
        ;(window as any).showToast('链接已复制', 'success')
      }
      if (copyMd) {
        const md = `![](${copyMd.dataset.url})`
        navigator.clipboard.writeText(md)
        ;(window as any).showToast('Markdown 已复制', 'success')
      }

      // Delete
      const delBtn = target.closest('.del-img') as HTMLElement
      if (delBtn) {
        deleteId = delBtn.dataset.id || ''
        deleteKey = delBtn.dataset.key || ''
        document.getElementById('delete-modal')!.style.display = 'flex'
      }

      // Pagination
      const pageBtn = target.closest('.page-btn') as HTMLElement
      if (pageBtn) {
        const page = parseInt(pageBtn.dataset.page || '1')
        loadImages(page)
        document.querySelector('.gallery-grid')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }
    })

    document.getElementById('cancel-delete')?.addEventListener('click', () => { document.getElementById('delete-modal')!.style.display = 'none' })
    document.querySelector('.modal-backdrop')?.addEventListener('click', () => { document.getElementById('delete-modal')!.style.display = 'none' })
    document.getElementById('confirm-delete')?.addEventListener('click', async () => {
      if (!deleteId && !deleteKey) return
      const res = await fetch('/api/gallery', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: deleteId, key: deleteKey }) })
      if (res.ok) {
        ;(window as any).showToast('已删除', 'success')
        document.getElementById('delete-modal')!.style.display = 'none'
        allFiles = allFiles.filter(f => f.id !== deleteId)
        renderGallery()
      } else {
        ;(window as any).showToast('删除失败', 'error')
      }
    })

    document.getElementById('refresh-btn')?.addEventListener('click', () => loadImages())

    // Lightbox
    const lightbox = document.getElementById('lightbox')!
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement
    const lightboxInfo = document.getElementById('lightbox-info')!
    const lightboxActions = document.getElementById('lightbox-actions')!

    function openLightbox(index: number) {
      if (index < 0 || index >= allFiles.length) return
      lightboxIndex = index
      const f = allFiles[index]
      lightboxImg.src = f.url
      lightboxImg.alt = f.filename || ''
      const name = f.filename || f.key?.split('/').pop() || ''
      lightboxInfo.textContent = `${name} · ${formatSize(f.size)} · ${index + 1}/${allFiles.length}`
      lightboxActions.innerHTML = `
        <button class="btn btn-ghost btn-sm lb-copy-url" data-url="${f.url}">复制链接</button>
        <button class="btn btn-ghost btn-sm lb-copy-md" data-url="${f.url}">复制 MD</button>
      `
      lightbox.style.display = 'flex'
      document.body.style.overflow = 'hidden'
    }

    function closeLightbox() {
      lightbox.style.display = 'none'
      document.body.style.overflow = ''
      lightboxIndex = -1
    }

    // Click image to open lightbox
    document.addEventListener('click', (e) => {
      const imgWrap = (e.target as HTMLElement).closest('.gallery-img-wrap') as HTMLElement
      if (imgWrap) {
        const index = parseInt(imgWrap.dataset.index || '0')
        openLightbox(index)
        return
      }

      // Lightbox actions
      const lbCopyUrl = (e.target as HTMLElement).closest('.lb-copy-url') as HTMLElement
      const lbCopyMd = (e.target as HTMLElement).closest('.lb-copy-md') as HTMLElement
      if (lbCopyUrl) {
        navigator.clipboard.writeText(lbCopyUrl.dataset.url || '')
        ;(window as any).showToast('链接已复制', 'success')
      }
      if (lbCopyMd) {
        navigator.clipboard.writeText(`![](${lbCopyMd.dataset.url})`)
        ;(window as any).showToast('Markdown 已复制', 'success')
      }
    })

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox)
    document.querySelector('.lightbox-backdrop')?.addEventListener('click', closeLightbox)
    document.getElementById('lightbox-prev')?.addEventListener('click', () => openLightbox(lightboxIndex - 1))
    document.getElementById('lightbox-next')?.addEventListener('click', () => openLightbox(lightboxIndex + 1))

    document.addEventListener('keydown', (e) => {
      if (lightbox.style.display !== 'flex') return
      if (e.key === 'Escape') closeLightbox()
      if (e.key === 'ArrowLeft') openLightbox(lightboxIndex - 1)
      if (e.key === 'ArrowRight') openLightbox(lightboxIndex + 1)
    })

    loadImages()
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.25rem; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
  .admin-header h1 { font-size: 1.375rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.75rem; margin-top: 0.125rem; }
  .header-actions { display: flex; gap: 0.5rem; }

  .upload-zone {
    border: 2px dashed var(--glass-border); border-radius: var(--radius);
    padding: 2rem; margin-bottom: 1.25rem; text-align: center;
    transition: all 0.2s;
  }
  .upload-zone.dragover { border-color: var(--primary); background: rgba(41,151,255,0.04); }
  .upload-zone-inner { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .upload-zone p { color: var(--text-muted); font-size: 0.8125rem; }
  .upload-zone small { color: var(--text-muted); font-size: 0.6875rem; }
  .upload-link { color: var(--primary); cursor: pointer; }
  .upload-link:hover { text-decoration: underline; }

  .gallery-stats { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem; }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.5rem;
  }
  .gallery-item {
    overflow: hidden; display: flex; flex-direction: column;
  }
  .gallery-img-wrap {
    aspect-ratio: 1; overflow: hidden; background: rgba(0,0,0,0.2);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; position: relative;
  }
  .gallery-img-wrap img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.2s;
  }
  .gallery-img-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.4); opacity: 0;
    transition: opacity 0.2s;
  }
  .gallery-item:hover .gallery-img-overlay { opacity: 1; }
  .gallery-item:hover .gallery-img-wrap img { transform: scale(1.05); }
  .gallery-info { padding: 0.625rem 0.75rem; flex: 1; }
  .gallery-name { display: block; font-size: 0.6875rem; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gallery-meta { display: block; font-size: 0.625rem; color: var(--text-muted); margin-top: 0.125rem; }
  .gallery-actions { display: flex; gap: 0.25rem; padding: 0 0.5rem 0.5rem; }
  .gallery-actions .btn { font-size: 0.625rem; padding: 0.25rem 0.375rem; }

  .empty-state { grid-column: 1 / -1; text-align: center; padding: 3rem; color: var(--text-muted); }

  .gallery-pagination { display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .page-info { font-size: 0.75rem; color: var(--text-muted); }
  .page-btns { display: flex; gap: 0.375rem; }

  .lightbox {
    position: fixed; inset: 0; z-index: 2000;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
  }
  .lightbox-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.9); }
  .lightbox-close {
    position: absolute; top: 1rem; right: 1rem; z-index: 1;
    background: rgba(255,255,255,0.1); border: none; border-radius: 50%;
    color: white; width: 40px; height: 40px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .lightbox-close:hover { background: rgba(255,255,255,0.2); }
  .lightbox-nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 1;
    background: rgba(255,255,255,0.1); border: none; border-radius: 50%;
    color: white; width: 44px; height: 44px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .lightbox-nav:hover { background: rgba(255,255,255,0.2); }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }
  .lightbox-content {
    position: relative; z-index: 1;
    max-width: 90vw; max-height: 80vh;
    display: flex; align-items: center; justify-content: center;
  }
  .lightbox-content img {
    max-width: 100%; max-height: 80vh; object-fit: contain;
    border-radius: var(--radius-sm); box-shadow: 0 8px 40px rgba(0,0,0,0.5);
  }
  .lightbox-info {
    position: relative; z-index: 1;
    margin-top: 1rem; font-size: 0.8125rem; color: rgba(255,255,255,0.7);
    text-align: center;
  }
  .lightbox-actions {
    position: relative; z-index: 1;
    margin-top: 0.75rem; display: flex; gap: 0.5rem; justify-content: center;
  }

  .modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); }
  .modal-content { position: relative; z-index: 1; width: 100%; max-width: 400px; padding: 2rem; }
  .modal-content h3 { font-size: 1.125rem; margin-bottom: 0.75rem; }
  .modal-content p { color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem; }
  .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; }

  @media (max-width: 768px) {
    .admin-main { margin-left: 0; padding: 0.75rem; }
    .admin-header { flex-direction: column; gap: 0.75rem; }
    .header-actions { width: 100%; }
    .gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 0.375rem; }
    .gallery-info { padding: 0.375rem 0.5rem; }
    .gallery-name { font-size: 0.625rem; }
    .gallery-actions { padding: 0 0.375rem 0.375rem; }
    .upload-zone { padding: 1.5rem; }
    .lightbox-nav { width: 36px; height: 36px; }
    .lightbox-prev { left: 0.5rem; }
    .lightbox-next { right: 0.5rem; }
  }
</style>
