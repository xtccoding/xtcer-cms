---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'
import { supabase } from '../../lib/supabase'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')

const { data: posts } = await supabase.from('posts').select('id')
---

<Layout title="设置 - XTCer">
  <div class="admin-layout">
    <Sidebar active="settings" />
    <div class="admin-main">
      <header class="admin-header">
        <div><h1>设置</h1><p class="admin-subtitle">系统配置和状态</p></div>
      </header>

      <div class="status-grid">
        <div class={`status-card glass-card ${posts && posts.length > 0 ? 'ok' : 'warn'}`}>
          <div class="status-icon">
            {posts && posts.length > 0 ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            ) : (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            )}
          </div>
          <div><h3>数据库</h3><p>{posts && posts.length > 0 ? `${posts.length} 篇文章` : '需要创建 posts 表'}</p></div>
        </div>
        <div class="status-card glass-card ok">
          <div class="status-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
          <div><h3>Supabase</h3><p>已连接</p></div>
        </div>
        <div class="status-card glass-card ok">
          <div class="status-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
          <div><h3>Cloudflare</h3><p>已部署</p></div>
        </div>
      </div>

      <section class="setup-section glass-card">
        <h2>管理密码</h2>
        <p>通过 Cloudflare Pages 环境变量 <code>ADMIN_PASSWORD</code> 设置。</p>
      </section>

      <section class="setup-section glass-card">
        <h2>数据库表</h2>
        <p>如果还没有 posts 表，在 Supabase SQL 编辑器运行：</p>
        <div class="code-block">
          <div class="code-header"><span>SQL</span><button class="copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('sql-code').textContent);this.textContent='已复制';setTimeout(()=>this.textContent='复制',2000)">复制</button></div>
          <pre><code id="sql-code">CREATE TABLE posts (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  title TEXT NOT NULL,
  content TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

ALTER TABLE posts ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read" ON posts FOR SELECT USING (true);
CREATE POLICY "Anyone can insert" ON posts FOR INSERT WITH CHECK (true);
CREATE POLICY "Anyone can update" ON posts FOR UPDATE USING (true);
CREATE POLICY "Anyone can delete" ON posts FOR DELETE USING (true);</code></pre>
        </div>
        <div style="margin-top:1rem">
          <a href="https://supabase.com/dashboard/project/ltwwyznurskgsphujarm/sql" target="_blank" class="btn btn-primary">
            打开 SQL 编辑器
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.5rem; max-width: 800px; }
  .admin-header { margin-bottom: 2rem; }
  .admin-header h1 { font-size: 1.5rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.125rem; }

  .status-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 1.5rem; }
  .status-card { display: flex; align-items: center; gap: 0.875rem; padding: 1rem 1.25rem; }
  .status-card.ok { border-color: rgba(48,209,88,0.15); }
  .status-card.warn { border-color: rgba(255,159,10,0.15); }
  .status-icon { flex-shrink: 0; }
  .status-card h3 { font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.125rem; }
  .status-card p { font-size: 0.75rem; color: var(--text-muted); }

  .setup-section { padding: 1.5rem; margin-bottom: 1rem; }
  .setup-section h2 { font-size: 1rem; margin-bottom: 0.5rem; }
  .setup-section p { color: var(--text-muted); font-size: 0.8125rem; margin-bottom: 0.75rem; line-height: 1.7; }
  .setup-section code { background: rgba(255,255,255,0.06); padding: 0.125rem 0.375rem; border-radius: 3px; font-size: 0.8125rem; font-family: 'SF Mono', monospace; }

  .code-block { border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  .code-header { display: flex; justify-content: space-between; align-items: center; padding: 0.375rem 0.75rem; background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--border); font-size: 0.6875rem; color: var(--text-muted); }
  .copy-btn { background: none; border: none; color: var(--primary); cursor: pointer; font-size: 0.6875rem; }
  .code-block pre { padding: 0.875rem; margin: 0; background: rgba(0,0,0,0.3); overflow-x: auto; }
  .code-block code { font-family: 'SF Mono', monospace; font-size: 0.75rem; line-height: 1.7; color: var(--text-secondary); background: none; padding: 0; }

  @media (max-width: 768px) {
    .admin-main { margin-left: 0; }
    .status-grid { grid-template-columns: 1fr; }
  }
</style>
