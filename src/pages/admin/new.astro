---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')
---

<Layout title="新建文章 - XTCer">
  <div class="admin-layout">
    <Sidebar active="" />
    <div class="admin-main">
      <header class="editor-header">
        <div class="editor-header-left">
          <a href="/admin/dashboard" class="toolbar-btn" title="返回">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        </div>
        <div class="toolbar">
          <div class="toolbar-group">
            <input type="file" id="image-upload" accept="image/*" style="display:none" />
            <button class="toolbar-btn" id="upload-btn" title="上传图片">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </button>
            <button class="toolbar-btn" id="toggle-preview" title="预览">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>

          <div class="toolbar-divider"></div>

          <div class="ai-dropdown" id="ai-dropdown">
            <button class="toolbar-btn toolbar-btn-ai" id="ai-btn" title="AI 助手">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4v1h1a3 3 0 013 3v1a3 3 0 01-3 3h-1v4a4 4 0 01-8 0v-4H7a3 3 0 01-3-3v-1a3 3 0 013-3h1V6a4 4 0 014-4z"/></svg>
              <span class="toolbar-label">AI</span>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="ai-menu" id="ai-menu">
              <button class="ai-option" data-action="polish">
                <span class="ai-option-icon">✨</span>
                <div><strong>润色</strong><small>优化表达，更流畅专业</small></div>
              </button>
              <button class="ai-option" data-action="expand">
                <span class="ai-option-icon">📝</span>
                <div><strong>扩展</strong><small>添加细节和例子</small></div>
              </button>
              <button class="ai-option" data-action="summarize">
                <span class="ai-option-icon">📋</span>
                <div><strong>摘要</strong><small>生成100字摘要</small></div>
              </button>
              <button class="ai-option" data-action="title">
                <span class="ai-option-icon">💡</span>
                <div><strong>起标题</strong><small>生成5个标题建议</small></div>
              </button>
              <div class="ai-divider"></div>
              <button class="ai-option" data-action="translate-en">
                <span class="ai-option-icon">🇬🇧</span>
                <div><strong>翻译成英文</strong></div>
              </button>
              <button class="ai-option" data-action="translate-zh">
                <span class="ai-option-icon">🇨🇳</span>
                <div><strong>翻译成中文</strong></div>
              </button>
            </div>
          </div>

          <div class="toolbar-divider"></div>

          <button class="toolbar-btn toolbar-btn-save" id="save-btn" title="保存 (⌘S)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span class="toolbar-label">保存</span>
          </button>
        </div>
      </header>

      <div id="ai-status" class="ai-status" style="display:none">
        <div class="ai-status-spinner"></div>
        <span id="ai-status-text">AI 正在处理...</span>
      </div>

      <div class="editor-body">
        <input type="text" id="post-title" class="input title-input" placeholder="输入标题..." autofocus />
        <div class="tags-row">
          <input type="text" id="post-tags" class="input tags-input" placeholder="标签（用逗号分隔，如：ai,llm,chatgpt）" />
          <button class="btn btn-ghost btn-sm" id="auto-tag-btn" title="AI 自动打标">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4v1h1a3 3 0 013 3v1a3 3 0 01-3 3h-1v4a4 4 0 01-8 0v-4H7a3 3 0 01-3-3v-1a3 3 0 013-3h1V6a4 4 0 014-4z"/></svg>
            AI 打标
          </button>
        </div>
        <input type="text" id="post-summary" class="input summary-input" placeholder="摘要（可选，100-160字，用于首页展示和SEO）" />
        <textarea id="post-content" class="input editor" placeholder="在这里写内容...支持 Markdown"></textarea>
        <div id="preview" class="preview markdown-body" style="display:none"></div>
      </div>
    </div>
  </div>

  <script>
    import { marked } from 'marked'
    const titleInput = document.getElementById('post-title') as HTMLInputElement
    const tagsInput = document.getElementById('post-tags') as HTMLInputElement
    const summaryInput = document.getElementById('post-summary') as HTMLInputElement
    const contentInput = document.getElementById('post-content') as HTMLTextAreaElement
    const preview = document.getElementById('preview')!
    const toggleBtn = document.getElementById('toggle-preview')!
    const saveBtn = document.getElementById('save-btn')!
    const aiBtn = document.getElementById('ai-btn')!
    const aiMenu = document.getElementById('ai-menu')!
    const aiStatus = document.getElementById('ai-status')!
    const aiStatusText = document.getElementById('ai-status-text')!
    let showPreview = false

    aiBtn.addEventListener('click', () => { aiMenu.classList.toggle('show') })
    document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.ai-dropdown')) aiMenu.classList.remove('show') })

    // AI auto-tag
    const autoTagBtn = document.getElementById('auto-tag-btn')!
    autoTagBtn.addEventListener('click', async () => {
      const title = titleInput.value.trim()
      if (!title) { titleInput.focus(); return }
      autoTagBtn.disabled = true
      autoTagBtn.textContent = '生成中...'
      aiStatus.style.display = 'flex'
      aiStatus.style.color = ''
      aiStatusText.textContent = 'AI 正在分析文章生成标签...'
      try {
        const res = await fetch('/api/ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'tag', title, content: contentInput.value }),
        })
        const data = await res.json()
        if (res.ok && data.result) {
          const tags = data.result.split(/[,，\n]/).map((t: string) => t.trim().toLowerCase().replace(/[^a-z0-9\-]/g, '')).filter((t: string) => t.length > 0)
          const existing = tagsInput.value.split(/[,，]/).map(t => t.trim()).filter(Boolean)
          const merged = [...new Set([...existing, ...tags])]
          tagsInput.value = merged.join(',')
          aiStatusText.textContent = `已生成 ${tags.length} 个标签`
          setTimeout(() => { aiStatus.style.display = 'none' }, 2000)
        } else {
          aiStatusText.textContent = `错误: ${data.error || '未知错误'}`
          aiStatus.style.color = 'var(--red)'
          setTimeout(() => { aiStatus.style.display = 'none'; aiStatus.style.color = '' }, 3000)
        }
      } catch {
        aiStatusText.textContent = '网络错误'
        aiStatus.style.color = 'var(--red)'
        setTimeout(() => { aiStatus.style.display = 'none'; aiStatus.style.color = '' }, 3000)
      }
      autoTagBtn.disabled = false
      autoTagBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4v1h1a3 3 0 013 3v1a3 3 0 01-3 3h-1v4a4 4 0 01-8 0v-4H7a3 3 0 01-3-3v-1a3 3 0 013-3h1V6a4 4 0 014-4z"/></svg>AI 打标'
    })

    document.querySelectorAll('.ai-option').forEach(opt => {
      opt.addEventListener('click', async () => {
        const action = (opt as HTMLElement).dataset.action
        aiMenu.classList.remove('show')
        const content = contentInput.value.trim()
        const title = titleInput.value.trim()
        if (!content && action !== 'title') { contentInput.focus(); return }

        aiStatus.style.display = 'flex'
        aiStatusText.textContent = 'AI 正在处理...'
        ;(opt as HTMLButtonElement).disabled = true

        try {
          const res = await fetch('/api/ai', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action, content, title }),
          })
          const data = await res.json()
          if (res.ok && data.result) {
            aiStatusText.textContent = `完成 (模型: ${data.model})`
            setTimeout(() => { aiStatus.style.display = 'none' }, 3000)

            if (action === 'title') {
              const titles = data.result.split('\n').filter((t: string) => t.trim())
              const chosen = prompt('选择一个标题（输入序号 1-5）:\n\n' + titles.map((t: string, i: number) => `${i+1}. ${t}`).join('\n'))
              if (chosen && titles[parseInt(chosen)-1]) { titleInput.value = titles[parseInt(chosen)-1].replace(/^\d+[\.\)、]\s*/, '') }
            } else if (action === 'summarize') {
              alert('摘要:\n\n' + data.result)
            } else {
              if (confirm('是否用 AI 生成的内容替换当前内容？\n\n点击"确定"替换，点击"取消"追加到末尾。')) {
                contentInput.value = data.result
              } else {
                contentInput.value += '\n\n' + data.result
              }
            }
          } else {
            aiStatusText.textContent = `错误: ${data.error || '未知错误'}`
            aiStatus.style.color = 'var(--red)'
            setTimeout(() => { aiStatus.style.display = 'none'; aiStatus.style.color = '' }, 5000)
          }
        } catch (e) {
          aiStatusText.textContent = '网络错误，请重试'
          aiStatus.style.color = 'var(--red)'
          setTimeout(() => { aiStatus.style.display = 'none'; aiStatus.style.color = '' }, 5000)
        }
        ;(opt as HTMLButtonElement).disabled = false
      })
    })

    toggleBtn.addEventListener('click', () => {
      showPreview = !showPreview
      if (showPreview) {
        preview.innerHTML = marked.parse(contentInput.value) as string
        preview.style.display = 'block'; contentInput.style.display = 'none'
        toggleBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>'
        toggleBtn.title = '编辑'
      } else {
        preview.style.display = 'none'; contentInput.style.display = 'block'; contentInput.focus()
        toggleBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
        toggleBtn.title = '预览'
      }
    })
    contentInput.addEventListener('input', () => { if (showPreview) preview.innerHTML = marked.parse(contentInput.value) as string })

    // Image upload
    const uploadBtn = document.getElementById('upload-btn')!
    const imageUpload = document.getElementById('image-upload') as HTMLInputElement

    uploadBtn.addEventListener('click', () => imageUpload.click())
    imageUpload.addEventListener('change', async () => {
      const file = imageUpload.files?.[0]
      if (!file) return

      uploadBtn.textContent = '上传中...'
      uploadBtn.disabled = true

      const formData = new FormData()
      formData.append('file', file)

      try {
        const res = await fetch('/api/upload', { method: 'POST', body: formData })
        const data = await res.json()
        if (res.ok && data.url) {
          const md = `![${file.name}](${data.url})`
          const pos = contentInput.selectionStart
          contentInput.value = contentInput.value.slice(0, pos) + md + contentInput.value.slice(pos)
          contentInput.focus()
          contentInput.selectionStart = contentInput.selectionEnd = pos + md.length
        } else {
          alert(data.error || '上传失败')
        }
      } catch {
        alert('上传失败')
      }

      uploadBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>'
      uploadBtn.disabled = false
      imageUpload.value = ''
    })

    saveBtn.addEventListener('click', async () => {
      const title = titleInput.value.trim()
      if (!title) { titleInput.focus(); return }
      const tags = tagsInput.value.split(/[,，]/).map(t => t.trim().toLowerCase()).filter(Boolean)
      saveBtn.textContent = '保存中...'
      saveBtn.disabled = true
      try {
        const res = await fetch('/api/posts', { 
          method: 'POST', 
          headers: { 'Content-Type': 'application/json' }, 
          body: JSON.stringify({ title, summary: summaryInput.value.trim(), content: contentInput.value.trim(), tags }),
          credentials: 'include'
        })
        if (res.ok) {
          const post = await res.json()
          ;(window as any).showToast('文章已创建', 'success')
          // 跳转到编辑页面
          setTimeout(() => { window.location.href = `/admin/edit/${post.id}` }, 500)
        } else {
          const data = await res.json().catch(() => ({}))
          if (res.status === 401) {
            ;(window as any).showToast('认证失败，请重新登录', 'error')
            setTimeout(() => { window.location.href = '/admin/login' }, 1000)
          } else {
            ;(window as any).showToast(data.error || '保存失败', 'error')
          }
          saveBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg><span class="toolbar-label">保存</span>'
          saveBtn.disabled = false
        }
      } catch (e) {
        ;(window as any).showToast('网络错误', 'error')
            saveBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg><span class="toolbar-label">保存</span>'
        saveBtn.disabled = false
      }
    })
    document.addEventListener('keydown', (e) => { if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveBtn.click() } })
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; overflow-x: hidden; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.5rem; min-width: 0; width: calc(100% - 200px); }

  .editor-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1rem; gap: 1rem;
  }
  .editor-header-left { display: flex; align-items: center; gap: 0.75rem; }

  .toolbar {
    display: flex; align-items: center; gap: 0.25rem;
    padding: 0.375rem; border-radius: 14px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  }
  .toolbar-group { display: flex; align-items: center; gap: 0.125rem; }
  .toolbar-divider {
    width: 1px; height: 20px; margin: 0 0.25rem;
    background: rgba(255,255,255,0.08);
  }
  .toolbar-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
    width: auto; min-width: 34px; height: 34px;
    padding: 0 0.5rem; border: none; border-radius: 10px;
    background: transparent; color: var(--text-muted);
    font-size: 0.75rem; font-weight: 500; cursor: pointer;
    transition: all 0.15s ease; text-decoration: none;
    font-family: 'Inter', sans-serif;
  }
  .toolbar-btn:hover { color: var(--text); background: rgba(255,255,255,0.06); }
  .toolbar-btn:active { transform: scale(0.95); }
  .toolbar-btn-ai { color: var(--primary); gap: 0.25rem; }
  .toolbar-btn-ai:hover { background: rgba(41,151,255,0.1); color: var(--primary); }
  .toolbar-btn-save {
    background: linear-gradient(135deg, #2997ff, #0077ed);
    color: #fff; font-weight: 600;
    box-shadow: 0 2px 8px rgba(41,151,255,0.25);
    padding: 0 0.875rem;
  }
  .toolbar-btn-save:hover {
    background: linear-gradient(135deg, #4dabff, #2997ff);
    box-shadow: 0 4px 16px rgba(41,151,255,0.35);
    color: #fff; transform: translateY(-1px);
  }
  .toolbar-btn-save:active { transform: scale(0.97) translateY(0); }
  .toolbar-label { font-size: 0.75rem; }

  .ai-dropdown { position: relative; }
  .ai-menu {
    display: none; position: absolute; top: calc(100% + 6px); right: 0;
    min-width: 240px; padding: 0.375rem; z-index: 100;
    background: rgba(20,20,20,0.95); backdrop-filter: blur(30px);
    border: 1px solid rgba(255,255,255,0.08); border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.5);
    animation: menuIn 0.15s ease-out;
  }
  @keyframes menuIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  .ai-menu.show { display: block; }
  .ai-option {
    display: flex; align-items: center; gap: 0.75rem; width: 100%;
    padding: 0.5rem 0.625rem; border: none; background: none;
    border-radius: 10px; cursor: pointer; text-align: left;
    transition: background 0.12s;
  }
  .ai-option:hover { background: rgba(255,255,255,0.06); }
  .ai-option-icon { font-size: 1rem; flex-shrink: 0; width: 24px; text-align: center; }
  .ai-option strong { display: block; font-size: 0.8125rem; color: var(--text); font-weight: 500; }
  .ai-option small { font-size: 0.6875rem; color: var(--text-muted); }
  .ai-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 0.25rem 0; }

  .ai-status {
    display: flex; align-items: center; gap: 0.625rem;
    padding: 0.625rem 1rem; margin-bottom: 0.75rem;
    background: rgba(41,151,255,0.06); border: 1px solid rgba(41,151,255,0.12);
    border-radius: 10px; font-size: 0.8125rem; color: var(--primary);
  }
  .ai-status-spinner {
    width: 14px; height: 14px; border: 2px solid rgba(41,151,255,0.2);
    border-top-color: var(--primary); border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .editor-body { display: flex; flex-direction: column; gap: 0.75rem; }
  .input {
    background: var(--surface); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px; color: var(--text); font-family: 'Inter', sans-serif;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .input:focus { outline: none; border-color: rgba(41,151,255,0.4); box-shadow: 0 0 0 3px rgba(41,151,255,0.08); }
  .title-input { font-size: 1.375rem; font-weight: 600; padding: 0.875rem 1rem; }
  .summary-input { font-size: 0.875rem; padding: 0.625rem 1rem; color: var(--text-secondary); }
  .tags-row { display: flex; gap: 0.5rem; align-items: center; }
  .tags-row .tags-input { flex: 1; }
  .tags-input { font-size: 0.8125rem; padding: 0.5rem 1rem; color: var(--primary); }
  .editor { width: 100%; min-height: 65vh; padding: 1rem; font-size: 0.875rem; line-height: 1.8; resize: none; }
  .preview { width: 100%; min-height: 65vh; padding: 1.5rem; background: var(--surface); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; overflow-y: auto; }
  .preview :global(h1) { font-size: 1.75rem; margin-bottom: 0.75rem; color: var(--text); }
  .preview :global(h2) { font-size: 1.375rem; margin: 1.5rem 0 0.625rem; color: var(--text); }
  .preview :global(h3) { font-size: 1.125rem; margin: 1.25rem 0 0.5rem; color: var(--text); }
  .preview :global(p) { margin-bottom: 1rem; color: var(--text-secondary); line-height: 1.8; }
  .preview :global(ul), .preview :global(ol) { margin: 1rem 0; padding-left: 1.5rem; color: var(--text-secondary); }
  .preview :global(li) { margin-bottom: 0.375rem; }
  .preview :global(blockquote) { border-left: 3px solid var(--primary); padding-left: 1rem; margin: 1rem 0; }
  .preview :global(code) { background: rgba(255,255,255,0.06); padding: 0.125rem 0.375rem; border-radius: 3px; font-size: 0.8125em; }
  .preview :global(pre) { background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem; overflow-x: auto; margin: 1rem 0; }
  .preview :global(pre code) { background: none; padding: 0; }
  .preview :global(strong) { color: var(--text); }

  @media (max-width: 768px) { .admin-main { margin-left: 0; } }
  @media (max-width: 480px) {
    .toolbar-label { display: none; }
    .toolbar-btn { min-width: 30px; height: 30px; padding: 0 0.375rem; }
    .toolbar { padding: 0.25rem; gap: 0.125rem; }
  }
</style>
