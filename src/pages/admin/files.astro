---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')
---

<Layout title="文件管理 - XTCer">
  <div class="admin-layout">
    <Sidebar active="files" />
    <div class="admin-main">
      <header class="admin-header">
        <div>
          <h1>文件管理</h1>
          <p class="admin-subtitle" id="files-stats">加载中...</p>
        </div>
        <div class="header-actions">
          <button class="btn btn-primary btn-sm" id="upload-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            上传文件
          </button>
        </div>
      </header>

      <div class="files-grid" id="files-grid"></div>
      <div class="pagination" id="pagination"></div>
    </div>
  </div>

  <div id="upload-modal" class="modal" style="display:none">
    <div class="modal-backdrop" id="upload-backdrop"></div>
    <div class="modal-content glass-card" style="max-width:480px">
      <h3>上传文件</h3>
      <div class="upload-zone" id="upload-zone">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <p>拖拽文件到这里，或 <span class="upload-link" id="upload-link">点击选择</span></p>
        <small>最大 100MB</small>
      </div>
      <div style="margin-top:0.75rem;display:flex;flex-direction:column;gap:0.5rem">
        <div style="display:flex;gap:0.5rem">
          <input type="text" id="file-slug" class="input" placeholder="自定义链接（留空随机）" style="flex:1" />
          <input type="text" id="file-password" class="input" placeholder="密码（可选）" style="width:120px" />
        </div>
        <select id="file-expires" class="input" style="width:100%">
          <option value="0">永不过期</option>
          <option value="1">1 小时</option>
          <option value="24">1 天</option>
          <option value="168">7 天</option>
          <option value="720">30 天</option>
        </select>
      </div>
      <div id="upload-progress" style="display:none;margin:0.75rem 0">
        <div style="display:flex;justify-content:space-between;font-size:0.75rem;margin-bottom:0.375rem">
          <span id="upload-status">上传中...</span>
        </div>
        <div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden">
          <div id="upload-bar" style="height:100%;background:var(--primary);width:0;transition:width 0.3s"></div>
        </div>
      </div>
      <div class="modal-actions" style="margin-top:1rem">
        <button class="btn btn-ghost" id="upload-cancel">关闭</button>
      </div>
    </div>
  </div>

  <div id="edit-modal" class="modal" style="display:none">
    <div class="modal-backdrop" id="edit-backdrop"></div>
    <div class="modal-content glass-card" style="max-width:400px">
      <h3>编辑分享设置</h3>
      <div style="display:flex;flex-direction:column;gap:0.5rem;margin-top:0.75rem">
        <input type="text" id="edit-slug" class="input" placeholder="分享链接" />
        <input type="text" id="edit-password" class="input" placeholder="密码（留空取消）" />
        <select id="edit-expires" class="input">
          <option value="">永不过期</option>
          <option value="1h">1 小时后</option>
          <option value="1d">1 天后</option>
          <option value="7d">7 天后</option>
          <option value="30d">30 天后</option>
        </select>
      </div>
      <div class="modal-actions" style="margin-top:1rem">
        <button class="btn btn-ghost" id="edit-cancel">取消</button>
        <button class="btn btn-primary" id="edit-save">保存</button>
      </div>
    </div>
  </div>

  <div id="delete-modal" class="modal" style="display:none">
    <div class="modal-backdrop"></div>
    <div class="modal-content glass-card">
      <h3>确认删除</h3>
      <p>删除后文件将从 R2 存储中移除，分享链接将失效。</p>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancel-delete">取消</button>
        <button class="btn btn-danger" id="confirm-delete">删除</button>
      </div>
    </div>
  </div>

  <input type="file" id="file-input" style="display:none" />

  <script>
    let allFiles: any[] = []
    let currentPage = 1
    let totalPages = 1
    let deleteId = ''
    let editId = ''

    const siteUrl = window.location.origin

    function formatSize(bytes: number): string {
      if (bytes < 1024) return bytes + ' B'
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB'
      return (bytes / 1024 / 1024).toFixed(1) + ' MB'
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;')
    }

    async function loadFiles(page = 1) {
      const res = await fetch(`/api/files?page=${page}&limit=50`)
      const data = await res.json()
      allFiles = data.files || []
      currentPage = data.page || 1
      totalPages = data.totalPages || 1
      renderFiles()
      renderPagination()
      document.getElementById('files-stats')!.textContent = `共 ${data.total || 0} 个文件`
    }

    function getFileIcon(type: string | null): string {
      if (!type) return '📄'
      if (type.startsWith('image/')) return '🖼️'
      if (type.startsWith('video/')) return '🎬'
      if (type.startsWith('audio/')) return '🎵'
      if (type.includes('pdf')) return '📕'
      if (type.includes('zip') || type.includes('rar') || type.includes('7z') || type.includes('tar')) return '📦'
      if (type.includes('word') || type.includes('document')) return '📘'
      if (type.includes('excel') || type.includes('sheet')) return '📊'
      if (type.includes('powerpoint') || type.includes('presentation')) return '📙'
      if (type.includes('text') || type.includes('json') || type.includes('xml') || type.includes('html') || type.includes('css') || type.includes('javascript')) return '📝'
      return '📄'
    }

    function renderFiles() {
      const grid = document.getElementById('files-grid')!
      if (allFiles.length === 0) {
        grid.innerHTML = '<div class="empty-state">暂无文件，点击"上传文件"开始</div>'
        return
      }
      grid.innerHTML = allFiles.map(f => {
        const name = escapeHtml(f.filename)
        const shareUrl = `${siteUrl}/s/${f.share_slug}`
        const expired = f.expires_at && new Date(f.expires_at) < new Date()
        const icon = getFileIcon(f.content_type)
        const size = formatSize(f.size || 0)
        const ext = name.split('.').pop()?.toUpperCase() || ''
        return `<div class="file-card glass-card">
          <div class="file-card-header">
            <span class="file-icon">${icon}</span>
            <span class="file-ext">${ext}</span>
          </div>
          <div class="file-card-body">
            <div class="file-name" title="${name}">${name}</div>
            <div class="file-meta">
              <span>${size}</span>
              <span>${new Date(f.created_at).toLocaleDateString('zh-CN')}</span>
            </div>
            <div class="file-share">
              <code class="share-slug">/s/${f.share_slug}</code>
              <button class="btn btn-ghost btn-xs copy-link" data-url="${shareUrl}" title="复制链接">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </div>
            <div class="file-tags">
              ${f.password ? '<span class="file-tag tag-lock">密码</span>' : ''}
              ${expired ? '<span class="file-tag tag-expired">已过期</span>' : (f.expires_at ? `<span class="file-tag tag-time">${new Date(f.expires_at).toLocaleDateString('zh-CN')} 过期</span>` : '')}
              ${f.downloads > 0 ? `<span class="file-tag tag-downloads">${f.downloads} 次下载</span>` : ''}
            </div>
          </div>
          <div class="file-card-actions">
            <button class="btn btn-ghost btn-xs edit-btn" data-id="${f.id}" data-slug="${f.share_slug}" data-password="${f.password || ''}" title="编辑">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
            <a href="${f.url}" target="_blank" class="btn btn-ghost btn-xs" title="预览">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
            <button class="btn btn-ghost btn-xs del-btn" data-id="${f.id}" title="删除">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
            </button>
          </div>
        </div>`
      }).join('')
    }

    function renderPagination() {
      const el = document.getElementById('pagination')!
      if (totalPages <= 1) { el.innerHTML = ''; return }
      let html = `<span class="page-info">第 ${currentPage}/${totalPages} 页</span><div class="page-btns">`
      if (currentPage > 1) {
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="1">首页</button>`
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${currentPage - 1}">上一页</button>`
      }
      if (currentPage < totalPages) {
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${currentPage + 1}">下一页</button>`
        html += `<button class="btn btn-ghost btn-sm page-btn" data-page="${totalPages}">末页</button>`
      }
      html += `</div>`
      el.innerHTML = html
    }

    // Upload
    const fileInput = document.getElementById('file-input') as HTMLInputElement
    const uploadBtn = document.getElementById('upload-btn')!
    const uploadModal = document.getElementById('upload-modal')!
    const uploadZone = document.getElementById('upload-zone')!

    uploadBtn.addEventListener('click', () => { uploadModal.style.display = 'flex' })
    document.getElementById('upload-cancel')?.addEventListener('click', () => { uploadModal.style.display = 'none' })
    document.getElementById('upload-backdrop')?.addEventListener('click', () => { uploadModal.style.display = 'none' })
    document.getElementById('upload-link')?.addEventListener('click', () => fileInput.click())

    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('dragover') })
    uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'))
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault(); uploadZone.classList.remove('dragover')
      const files = e.dataTransfer?.files
      if (files?.length) uploadFile(files[0])
    })

    fileInput.addEventListener('change', () => {
      if (fileInput.files?.length) uploadFile(fileInput.files[0])
    })

    async function uploadFile(file: File) {
      const slug = (document.getElementById('file-slug') as HTMLInputElement).value.trim()
      const password = (document.getElementById('file-password') as HTMLInputElement).value.trim()
      const expires = (document.getElementById('file-expires') as HTMLSelectElement).value

      const progressEl = document.getElementById('upload-progress')!
      const statusEl = document.getElementById('upload-status')!
      const barEl = document.getElementById('upload-bar')!
      const zoneEl = document.getElementById('upload-zone')!

      progressEl.style.display = ''
      zoneEl.style.display = 'none'
      statusEl.textContent = '上传中...'
      barEl.style.width = '30%'

      const formData = new FormData()
      formData.append('file', file)
      if (slug) formData.append('slug', slug)
      if (password) formData.append('password', password)
      if (expires !== '0') formData.append('expires', expires)

      try {
        barEl.style.width = '60%'
        const res = await fetch('/api/files', { method: 'POST', body: formData })
        const data = await res.json()

        if (res.ok) {
          barEl.style.width = '100%'
          statusEl.textContent = '上传完成'
          const shareUrl = `${siteUrl}/s/${data.share_slug}`
          await navigator.clipboard.writeText(shareUrl)
          ;(window as any).showToast('上传成功，分享链接已复制', 'success')
          loadFiles()
        } else {
          statusEl.textContent = '上传失败'
          ;(window as any).showToast(data.error || '上传失败', 'error')
        }
      } catch {
        statusEl.textContent = '上传失败'
        ;(window as any).showToast('上传失败', 'error')
      }

      fileInput.value = ''
      setTimeout(() => {
        uploadModal.style.display = 'none'
        progressEl.style.display = 'none'
        zoneEl.style.display = ''
        barEl.style.width = '0'
      }, 800)
    }

    // Edit
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const editBtn = target.closest('.edit-btn') as HTMLElement
      if (editBtn) {
        editId = editBtn.dataset.id || ''
        ;(document.getElementById('edit-slug') as HTMLInputElement).value = editBtn.dataset.slug || ''
        ;(document.getElementById('edit-password') as HTMLInputElement).value = editBtn.dataset.password || ''
        document.getElementById('edit-modal')!.style.display = 'flex'
        return
      }
    })

    document.getElementById('edit-cancel')?.addEventListener('click', () => { document.getElementById('edit-modal')!.style.display = 'none' })
    document.getElementById('edit-backdrop')?.addEventListener('click', () => { document.getElementById('edit-modal')!.style.display = 'none' })

    document.getElementById('edit-save')?.addEventListener('click', async () => {
      const slug = (document.getElementById('edit-slug') as HTMLInputElement).value.trim()
      const password = (document.getElementById('edit-password') as HTMLInputElement).value.trim()
      const expiresSelect = document.getElementById('edit-expires') as HTMLSelectElement
      let expires_at: string | null = null
      const val = expiresSelect.value
      if (val === '1h') expires_at = new Date(Date.now() + 3600000).toISOString()
      else if (val === '1d') expires_at = new Date(Date.now() + 86400000).toISOString()
      else if (val === '7d') expires_at = new Date(Date.now() + 604800000).toISOString()
      else if (val === '30d') expires_at = new Date(Date.now() + 2592000000).toISOString()

      const res = await fetch('/api/files', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: editId, share_slug: slug, password, expires_at }) })
      if (res.ok) {
        ;(window as any).showToast('已更新', 'success')
        loadFiles(currentPage)
      } else {
        const data = await res.json()
        ;(window as any).showToast(data.error || '更新失败', 'error')
      }
      document.getElementById('edit-modal')!.style.display = 'none'
    })

    // Delete
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const delBtn = target.closest('.del-btn') as HTMLElement
      if (delBtn) {
        deleteId = delBtn.dataset.id || ''
        document.getElementById('delete-modal')!.style.display = 'flex'
        return
      }
      const copyBtn = target.closest('.copy-link') as HTMLElement
      if (copyBtn) {
        navigator.clipboard.writeText(copyBtn.dataset.url || '')
        ;(window as any).showToast('已复制', 'success')
        return
      }
    })

    document.getElementById('cancel-delete')?.addEventListener('click', () => { document.getElementById('delete-modal')!.style.display = 'none' })
    document.getElementById('confirm-delete')?.addEventListener('click', async () => {
      if (!deleteId) return
      await fetch('/api/files', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: deleteId }) })
      ;(window as any).showToast('已删除', 'success')
      document.getElementById('delete-modal')!.style.display = 'none'
      loadFiles(currentPage)
    })

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const pageBtn = target.closest('.page-btn') as HTMLElement
      if (pageBtn) {
        loadFiles(parseInt(pageBtn.dataset.page || '1'))
        document.querySelector('.table-wrap')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }
    })

    loadFiles()
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.25rem; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
  .admin-header h1 { font-size: 1.375rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.75rem; margin-top: 0.125rem; }
  .header-actions { display: flex; gap: 0.5rem; }

  .upload-zone {
    border: 2px dashed var(--glass-border); border-radius: var(--radius);
    padding: 2.5rem 2rem; text-align: center; transition: all 0.2s; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 0.625rem;
  }
  .upload-zone:hover { border-color: var(--primary); background: rgba(41,151,255,0.03); }
  .upload-zone.dragover { border-color: var(--primary); background: rgba(41,151,255,0.06); }
  .upload-zone p { color: var(--text-muted); font-size: 0.8125rem; }
  .upload-zone small { color: var(--text-muted); font-size: 0.6875rem; }
  .upload-link { color: var(--primary); cursor: pointer; }
  .upload-link:hover { text-decoration: underline; }

  .files-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.625rem;
  }
  .file-card {
    display: flex; flex-direction: column; border-radius: var(--radius-sm); overflow: hidden;
    transition: border-color 0.2s;
  }
  .file-card:hover { border-color: var(--glass-border-hover); }
  .file-card-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.75rem 0.875rem;
    background: rgba(255,255,255,0.02);
    border-bottom: 1px solid var(--border);
  }
  .file-icon { font-size: 1.25rem; }
  .file-ext {
    font-size: 0.5625rem; font-weight: 600; color: var(--text-muted);
    padding: 0.125rem 0.375rem; border-radius: 3px;
    background: rgba(255,255,255,0.05); letter-spacing: 0.05em;
  }
  .file-card-body { flex: 1; padding: 0.75rem 0.875rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .file-name {
    font-size: 0.8125rem; font-weight: 600; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .file-meta {
    display: flex; gap: 0.625rem; font-size: 0.6875rem; color: var(--text-muted);
  }
  .file-share {
    display: flex; align-items: center; gap: 0.375rem; margin-top: 0.125rem;
  }
  .share-slug {
    font-size: 0.6875rem; color: var(--primary);
    background: rgba(41,151,255,0.08); padding: 0.125rem 0.5rem;
    border-radius: 3px; cursor: pointer;
  }
  .share-slug:hover { background: rgba(41,151,255,0.15); }
  .file-tags { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.25rem; }
  .file-tag {
    font-size: 0.5625rem; padding: 0.0625rem 0.375rem;
    border-radius: 999px; font-weight: 500;
  }
  .tag-lock { background: rgba(255,159,10,0.1); color: var(--orange); border: 1px solid rgba(255,159,10,0.15); }
  .tag-expired { background: rgba(255,69,58,0.1); color: var(--red); border: 1px solid rgba(255,69,58,0.15); }
  .tag-time { background: rgba(100,100,100,0.1); color: var(--text-muted); border: 1px solid rgba(100,100,100,0.15); }
  .tag-downloads { background: rgba(48,209,88,0.1); color: var(--green); border: 1px solid rgba(48,209,88,0.15); }
  .file-card-actions {
    display: flex; gap: 0.25rem; padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--border); background: rgba(255,255,255,0.01);
  }
  .btn-xs { padding: 0.1875rem 0.375rem; font-size: 0.625rem; }

  .empty-state { text-align: center; padding: 3rem; color: var(--text-muted); font-size: 0.875rem; grid-column: 1 / -1; }

  .pagination { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border); }
  .page-info { font-size: 0.6875rem; color: var(--text-muted); }
  .page-btns { display: flex; gap: 0.375rem; }

  .modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); }
  .modal-content { position: relative; z-index: 1; width: 100%; max-width: 400px; padding: 2rem; }
  .modal-content h3 { font-size: 1.125rem; margin-bottom: 0.75rem; }
  .modal-content p { color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem; }
  .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; }

  @media (max-width: 768px) {
    .admin-main { margin-left: 0; padding: 0.75rem; }
    .admin-header { flex-direction: column; gap: 0.75rem; }
    .files-grid { grid-template-columns: 1fr; }
  }
</style>
