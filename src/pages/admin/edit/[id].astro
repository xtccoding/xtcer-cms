---
import Layout from '../../../layouts/Layout.astro'
import { supabase } from '../../../lib/supabase'

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || 'xtcer2024'
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')

const { id } = Astro.params
const { data: post } = await supabase.from('posts').select('*').eq('id', id).single()
if (!post) return Astro.redirect('/admin/dashboard')
---

<Layout title={`编辑 - ${post.title}`}>
  <div class="admin-layout">
    <aside class="sidebar glass-card">
      <div class="sidebar-brand"><a href="/" class="nav-logo">XTCer</a></div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          文章管理
        </a>
        <a href="/admin/new" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14m-7-7h14"/></svg>
          新建文章
        </a>
        <div class="sidebar-divider"></div>
        <a href="/admin/logout" class="sidebar-link logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4m7 14l5-5-5-5m5 5H9"/></svg>
          退出
        </a>
      </nav>
    </aside>

    <div class="admin-main">
      <header class="editor-header">
        <a href="/admin/dashboard" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          返回
        </a>
        <div class="editor-actions">
          <span class="save-status" id="save-status"></span>
          <button class="btn btn-ghost btn-sm" id="toggle-preview">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            预览
          </button>
          <button class="btn btn-primary btn-sm" id="save-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            保存
          </button>
        </div>
      </header>

      <div class="editor-body">
        <input type="text" id="post-title" class="input title-input" value={post.title} />
        <textarea id="post-content" class="input editor">{post.content}</textarea>
        <div id="preview" class="preview markdown-body" style="display:none"></div>
      </div>
    </div>
  </div>

  <script>
    import { marked } from 'marked'
    const titleInput = document.getElementById('post-title') as HTMLInputElement
    const contentInput = document.getElementById('post-content') as HTMLTextAreaElement
    const preview = document.getElementById('preview')!
    const toggleBtn = document.getElementById('toggle-preview')!
    const saveBtn = document.getElementById('save-btn')!
    const saveStatus = document.getElementById('save-status')!
    const postId = window.location.pathname.split('/').pop()
    let showPreview = false
    let saved = true

    const markDirty = () => { saved = false; saveStatus.textContent = '' }
    titleInput.addEventListener('input', markDirty)
    contentInput.addEventListener('input', () => { markDirty(); if (showPreview) preview.innerHTML = marked.parse(contentInput.value) as string })

    toggleBtn.addEventListener('click', () => {
      showPreview = !showPreview
      if (showPreview) {
        preview.innerHTML = marked.parse(contentInput.value) as string
        preview.style.display = 'block'; contentInput.style.display = 'none'
        toggleBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>编辑'
      } else {
        preview.style.display = 'none'; contentInput.style.display = 'block'; contentInput.focus()
        toggleBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>预览'
      }
    })

    saveBtn.addEventListener('click', async () => {
      const title = titleInput.value.trim()
      if (!title) { titleInput.focus(); return }
      saveBtn.textContent = '保存中...'
      const res = await fetch(`/api/posts/${postId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title, content: contentInput.value.trim() }) })
      if (res.ok) { saved = true; saveStatus.textContent = '已保存'; setTimeout(() => { saveStatus.textContent = '' }, 3000) }
      else { alert('保存失败') }
      saveBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>保存'
    })

    document.addEventListener('keydown', (e) => { if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveBtn.click() } })
    window.addEventListener('beforeunload', (e) => { if (!saved) { e.preventDefault(); e.returnValue = '' } })
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .sidebar {
    width: 220px; flex-shrink: 0; padding: 1.5rem 1rem;
    position: fixed; top: 0; bottom: 0; left: 0;
    border-radius: 0; border-left: none; border-top: none; border-bottom: none;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px);
    display: flex; flex-direction: column;
  }
  .sidebar-brand { padding: 0 0.5rem; margin-bottom: 2rem; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 0.125rem; flex: 1; }
  .sidebar-link { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.625rem; border-radius: var(--radius-sm); color: var(--text-muted); font-size: 0.8125rem; transition: all 0.15s; }
  .sidebar-link:hover { color: var(--text); background: var(--surface); }
  .sidebar-link.active { color: var(--primary); background: rgba(41,151,255,0.08); }
  .sidebar-divider { height: 1px; background: var(--border); margin: 0.5rem 0; }
  .sidebar-link.logout { color: var(--red); margin-top: auto; }
  .sidebar-link.logout:hover { background: rgba(255,69,58,0.08); }

  .admin-main { flex: 1; margin-left: 220px; padding: 1.5rem 2rem; }
  .editor-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .back-link { display: inline-flex; align-items: center; gap: 0.375rem; color: var(--text-muted); font-size: 0.8125rem; }
  .back-link:hover { color: var(--text); }
  .editor-actions { display: flex; gap: 0.5rem; align-items: center; }
  .save-status { font-size: 0.75rem; color: var(--green); }

  .editor-body { display: flex; flex-direction: column; gap: 0.75rem; }
  .title-input { font-size: 1.375rem; font-weight: 600; padding: 0.875rem 1rem; background: var(--surface); }
  .editor { width: 100%; min-height: 65vh; padding: 1rem; font-size: 0.875rem; line-height: 1.8; resize: none; }
  .preview {
    width: 100%; min-height: 65vh; padding: 1.5rem;
    background: var(--surface); border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm); overflow-y: auto;
  }
  .preview :global(h1) { font-size: 1.75rem; margin-bottom: 0.75rem; color: var(--text); }
  .preview :global(h2) { font-size: 1.375rem; margin: 1.5rem 0 0.625rem; color: var(--text); }
  .preview :global(h3) { font-size: 1.125rem; margin: 1.25rem 0 0.5rem; color: var(--text); }
  .preview :global(p) { margin-bottom: 1rem; color: var(--text-secondary); line-height: 1.8; }
  .preview :global(ul), .preview :global(ol) { margin: 1rem 0; padding-left: 1.5rem; color: var(--text-secondary); }
  .preview :global(li) { margin-bottom: 0.375rem; }
  .preview :global(blockquote) { border-left: 3px solid var(--primary); padding-left: 1rem; margin: 1rem 0; }
  .preview :global(code) { background: rgba(255,255,255,0.06); padding: 0.125rem 0.375rem; border-radius: 3px; font-size: 0.8125em; }
  .preview :global(pre) { background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem; overflow-x: auto; margin: 1rem 0; }
  .preview :global(pre code) { background: none; padding: 0; }
  .preview :global(strong) { color: var(--text); }

  @media (max-width: 768px) {
    .sidebar { display: none; }
    .admin-main { margin-left: 0; }
  }
</style>
