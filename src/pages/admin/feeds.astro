---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'
import { supabase } from '../../lib/supabase'

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || 'xtcer2024'
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')

const { data: feeds } = await supabase.from('feeds').select('*').order('created_at', { ascending: false })
const feedTypes = [...new Set(feeds?.map(f => f.feed_type) || [])]
const typeLabels: Record<string, string> = {
  security: '安全', github_trending: 'GitHub', ai_monetization: 'AI',
  crypto_alpha: '加密', deal_hunt: '捡漏', industry_move: '行业',
  devtool_launch: '工具', learn_alpha: '学习',
}
---

<Layout title="情报管理 - XTCer">
  <div class="admin-layout">
    <Sidebar active="feeds" />
    <div class="admin-main">
      <header class="admin-header">
        <div>
          <h1>情报管理</h1>
          <p class="admin-subtitle">{feeds?.length || 0} 条情报，{feedTypes.length} 个分类</p>
        </div>
      </header>

      <div class="filter-bar">
        <select id="filter-type" class="input filter-select">
          <option value="">全部类型</option>
          {Object.entries(typeLabels).map(([k, v]) => <option value={k}>{v} ({k})</option>)}
        </select>
        <select id="filter-priority" class="input filter-select">
          <option value="">全部优先级</option>
          <option value="critical">critical</option>
          <option value="normal">normal</option>
        </select>
        <span class="filter-count" id="filter-count">{feeds?.length || 0} 条</span>
      </div>

      <div class="feeds-list" id="feeds-list">
        {feeds && feeds.map(feed => (
          <div class="feed-item glass-card" data-id={feed.id} data-type={feed.feed_type} data-priority={feed.priority || 'normal'}>
            <div class="feed-header">
              <span class="feed-type">{typeLabels[feed.feed_type] || feed.feed_type}</span>
              <span class={`feed-priority ${feed.priority === 'critical' ? 'critical' : 'normal'}`}>
                {feed.priority === 'critical' ? '🔴' : '🟢'} {feed.priority || 'normal'}
              </span>
              <span class="feed-time">{new Date(feed.created_at).toLocaleDateString('zh-CN')}</span>
            </div>
            <h3 class="feed-title">
              {feed.url ? <a href={feed.url} target="_blank" rel="noopener">{feed.title}</a> : feed.title}
            </h3>
            {feed.summary && <p class="feed-summary">{feed.summary}</p>}
            {feed.tags && feed.tags.length > 0 && (
              <div class="feed-tags">{feed.tags.map((t: string) => <span class="tag">{t}</span>)}</div>
            )}
            {feed.source && <span class="feed-source">来源: {feed.source}</span>}
            <div class="feed-actions">
              <button class="btn btn-danger btn-sm del-feed" data-id={feed.id}>删除</button>
            </div>
          </div>
        ))}
        {(!feeds || feeds.length === 0) && (
          <div class="empty"><p>暂无情报数据，等待 cron 推送</p></div>
        )}
      </div>
    </div>
  </div>

  <script>
    document.getElementById('filter-type')?.addEventListener('change', filterFeeds)
    document.getElementById('filter-priority')?.addEventListener('change', filterFeeds)

    function filterFeeds() {
      const type = (document.getElementById('filter-type') as HTMLSelectElement).value
      const priority = (document.getElementById('filter-priority') as HTMLSelectElement).value
      let count = 0
      document.querySelectorAll('#feeds-list .feed-item').forEach(el => {
        const e = el as HTMLElement
        const matchType = !type || e.dataset.type === type
        const matchPri = !priority || e.dataset.priority === priority
        e.style.display = (matchType && matchPri) ? '' : 'none'
        if (matchType && matchPri) count++
      })
      document.getElementById('filter-count')!.textContent = count + ' 条'
    }

    document.querySelectorAll('.del-feed').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('确定删除？')) return
        const id = (btn as HTMLElement).dataset.id
        const res = await fetch('/api/feeds', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        })
        if (res.ok) btn.closest('.feed-item')?.remove()
      })
    })
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.5rem; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .admin-header h1 { font-size: 1.5rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.125rem; }

  .filter-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .filter-select { width: auto; min-width: 140px; padding: 0.5rem 0.75rem; font-size: 0.8125rem; }
  .filter-count { font-size: 0.75rem; color: var(--text-muted); margin-left: auto; }

  .feeds-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .feed-item { padding: 1rem 1.25rem; }
  .feed-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
  .feed-type { padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 500; background: rgba(41,151,255,0.08); color: var(--primary); border: 1px solid rgba(41,151,255,0.15); }
  .feed-priority { font-size: 0.6875rem; }
  .feed-priority.critical { color: var(--red); }
  .feed-priority.normal { color: var(--green); }
  .feed-time { font-size: 0.6875rem; color: var(--text-muted); margin-left: auto; }
  .feed-title { font-size: 0.875rem; font-weight: 600; margin-bottom: 0.375rem; }
  .feed-title a { color: var(--text); }
  .feed-title a:hover { color: var(--primary); }
  .feed-source { font-size: 0.6875rem; color: var(--text-muted); }
  .feed-actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; }

  .empty { text-align: center; padding: 3rem; }
  .empty p { color: var(--text-muted); }

  @media (max-width: 768px) { .admin-main { margin-left: 0; } }
</style>
