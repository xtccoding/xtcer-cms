---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')
---

<Layout title="文件风格预览 - XTCer">
  <div class="admin-layout">
    <Sidebar active="files" />
    <div class="admin-main">
      <header class="admin-header">
        <div>
          <h1>文件列表风格预览</h1>
          <p class="admin-subtitle">选择你喜欢的风格，告诉我名称</p>
        </div>
        <div class="header-actions">
          <select id="style-select" class="input" style="width:180px">
            <option value="apple-list">Apple List</option>
            <option value="finder">macOS Finder</option>
            <option value="notion">Notion</option>
            <option value="linear">Linear</option>
            <option value="raycast">Raycast</option>
            <option value="github">GitHub</option>
            <option value="vercel">Vercel</option>
            <option value="arc">Arc Browser</option>
            <option value="spotify">Spotify</option>
            <option value="ios-settings">iOS Settings</option>
          </select>
        </div>
      </header>

      <div id="preview-container"></div>
    </div>
  </div>

  <script>
    const files = [
      { name: '2024年度报告.pdf', ext: 'PDF', size: '2.3 MB', slug: 'report2024', hash: 'abc12345def', status: 'normal', dl: 12, date: '6月5日', type: 'pdf' },
      { name: '产品设计稿v3.png', ext: 'PNG', size: '1.8 MB', slug: 'design-v3', hash: 'def67890abc', status: 'normal', dl: 45, date: '6月4日', type: 'image' },
      { name: '项目源码备份.zip', ext: 'ZIP', size: '15.0 MB', slug: 'source-backup', hash: '111222aa333', status: 'normal', dl: 8, date: '6月3日', type: 'archive' },
      { name: '会议录屏-0601.mp4', ext: 'MP4', size: '50.0 MB', slug: 'meeting-0601', hash: '333444bb555', status: 'normal', dl: 23, date: '6月1日', type: 'video' },
      { name: '合同模板.docx', ext: 'DOCX', size: '200 KB', slug: 'contract-tpl', hash: '555666cc777', status: 'password', dl: 67, date: '5月28日', type: 'doc' },
      { name: '团队合照.jpg', ext: 'JPG', size: '3.0 MB', slug: 'team-photo', hash: '777888dd999', status: 'normal', dl: 5, date: '5月25日', type: 'image' },
      { name: 'Q2财务数据.xlsx', ext: 'XLSX', size: '500 KB', slug: 'q2-finance', hash: '999aaee0bbb', status: 'password', dl: 31, date: '5月20日', type: 'doc' },
      { name: '播客第42期.mp3', ext: 'MP3', size: '8.0 MB', slug: 'podcast-42', hash: 'bbbccc11ddd', status: 'normal', dl: 19, date: '5月18日', type: 'audio' },
      { name: '部署说明.txt', ext: 'TXT', size: '4 KB', slug: 'deploy-guide', hash: 'dddeee22fff', status: 'normal', dl: 88, date: '5月15日', type: 'text' },
      { name: 'Logo矢量文件.svg', ext: 'SVG', size: '16 KB', slug: 'logo-svg', hash: 'fff00033aaa', status: 'normal', dl: 41, date: '5月10日', type: 'image' },
      { name: '数据库备份-0605.tar.gz', ext: 'GZ', size: '100 MB', slug: 'db-backup', hash: 'aabb4455cc', status: 'expired', dl: 3, date: '5月8日', type: 'archive' },
      { name: '产品发布会PPT.pptx', ext: 'PPTX', size: '7.8 MB', slug: 'launch-ppt', hash: 'ccdd6677ee', status: 'normal', dl: 56, date: '5月5日', type: 'doc' },
    ]

    const icons: Record<string, string> = {
      pdf: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
      image: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>',
      video: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#bf5af2" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
      audio: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff9f0a" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
      doc: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0a84ff" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
      archive: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64d2ff" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>',
      text: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8e8e93" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
    }

    function getIcon(type: string) { return icons[type] || icons.text }

    const styles: Record<string, () => string> = {
      'apple-list': () => `<div class="s-apple">
        ${files.map(f => `<div class="apple-row">
          <div class="apple-icon">${getIcon(f.type)}</div>
          <div class="apple-info"><div class="apple-name">${f.name}</div><div class="apple-sub">${f.size} · ${f.hash.substring(0,8)} · ${f.date}</div></div>
          <div class="apple-right"><span class="apple-link">/s/${f.slug}</span>${f.status==='password'?'<span class="apple-badge">密码</span>':''}${f.status==='expired'?'<span class="apple-badge apple-badge-red">过期</span>':''}<span class="apple-dl">${f.dl}</span></div>
        </div>`).join('')}
      </div>`,

      'finder': () => `<div class="s-finder">
        <div class="finder-header"><span>名称</span><span>大小</span><span>链接</span><span>下载</span><span>日期</span></div>
        ${files.map(f => `<div class="finder-row"><span class="finder-name">${getIcon(f.type)} ${f.name}</span><span class="finder-size">${f.size}</span><span class="finder-link">/s/${f.slug}</span><span class="finder-dl">${f.dl}</span><span class="finder-date">${f.date}</span></div>`).join('')}
      </div>`,

      'notion': () => `<div class="s-notion">
        ${files.map(f => `<div class="notion-row"><span class="notion-check">☐</span><span class="notion-icon">${getIcon(f.type)}</span><span class="notion-name">${f.name}</span><span class="notion-tag">${f.ext}</span><span class="notion-meta">${f.size}</span><span class="notion-link">/s/${f.slug}</span></div>`).join('')}
      </div>`,

      'linear': () => `<div class="s-linear">
        ${files.map(f => `<div class="linear-row"><span class="linear-icon">${getIcon(f.type)}</span><span class="linear-name">${f.name}</span><span class="linear-ext">${f.ext}</span><span class="linear-size">${f.size}</span><span class="linear-link">/s/${f.slug}</span><span class="linear-dl">${f.dl}</span></div>`).join('')}
      </div>`,

      'raycast': () => `<div class="s-raycast">
        ${files.map(f => `<div class="raycast-row"><div class="raycast-icon">${getIcon(f.type)}</div><div class="raycast-info"><span class="raycast-name">${f.name}</span><span class="raycast-sub">${f.size} · ${f.date}</span></div><span class="raycast-link">/s/${f.slug}</span></div>`).join('')}
      </div>`,

      'github': () => `<div class="s-github">
        ${files.map(f => `<div class="gh-row"><span class="gh-icon">${getIcon(f.type)}</span><span class="gh-name">${f.name}</span><span class="gh-hash" title="${f.hash}">${f.hash.substring(0,7)}</span><span class="gh-size">${f.size}</span><span class="gh-link">/s/${f.slug}</span><span class="gh-date">${f.date}</span></div>`).join('')}
      </div>`,

      'vercel': () => `<div class="s-vercel">
        ${files.map(f => `<div class="vercel-row"><div class="vercel-left">${getIcon(f.type)}<span class="vercel-name">${f.name}</span></div><div class="vercel-right"><span class="vercel-ext">${f.ext}</span><span class="vercel-size">${f.size}</span><span class="vercel-link">/s/${f.slug}</span></div></div>`).join('')}
      </div>`,

      'arc': () => `<div class="s-arc">
        ${files.map(f => `<div class="arc-row"><div class="arc-icon">${getIcon(f.type)}</div><div class="arc-info"><span class="arc-name">${f.name}</span><span class="arc-sub">${f.ext} · ${f.size} · ${f.hash.substring(0,8)}</span></div><span class="arc-link">/s/${f.slug}</span></div>`).join('')}
      </div>`,

      'spotify': () => `<div class="s-spotify">
        ${files.map((f, i) => `<div class="sp-row"><span class="sp-num">${String(i+1).padStart(2,'0')}</span><span class="sp-icon">${getIcon(f.type)}</span><span class="sp-name">${f.name}</span><span class="sp-ext">${f.ext}</span><span class="sp-dl">${f.dl}</span><span class="sp-link">/s/${f.slug}</span></div>`).join('')}
      </div>`,

      'ios-settings': () => `<div class="s-ios">
        ${files.map(f => `<div class="ios-row"><span class="ios-icon">${getIcon(f.type)}</span><div class="ios-info"><span class="ios-name">${f.name}</span><span class="ios-sub">${f.size} · ${f.date}</span></div><span class="ios-link">/s/${f.slug}</span><span class="ios-arrow">›</span></div>`).join('')}
      </div>`,
    }

    const select = document.getElementById('style-select') as HTMLSelectElement
    const container = document.getElementById('preview-container')!

    function render() { container.innerHTML = `<div class="style-frame glass-card">${styles[select.value]()}</div>` }
    select.addEventListener('change', render)
    render()
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.25rem; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
  .admin-header h1 { font-size: 1.375rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.75rem; margin-top: 0.125rem; }
  .header-actions { display: flex; gap: 0.5rem; }

  .style-frame { padding: 1rem; overflow-x: auto; }

  /* ===== Apple List ===== */
  .s-apple { display: flex; flex-direction: column; }
  .apple-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 0.75rem; border-radius: var(--radius-sm); transition: background 0.15s; cursor: default; }
  .apple-row:hover { background: rgba(255,255,255,0.03); }
  .apple-icon { flex-shrink: 0; opacity: 0.8; }
  .apple-info { flex: 1; min-width: 0; }
  .apple-name { font-size: 0.8125rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .apple-sub { font-size: 0.6875rem; color: var(--text-muted); margin-top: 0.0625rem; }
  .apple-right { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .apple-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; background: rgba(41,151,255,0.06); padding: 0.0625rem 0.375rem; border-radius: 4px; }
  .apple-badge { font-size: 0.5rem; padding: 0.0625rem 0.375rem; border-radius: 999px; background: rgba(255,159,10,0.1); color: #ff9f0a; }
  .apple-badge-red { background: rgba(255,69,58,0.1); color: #ff453a; }
  .apple-dl { font-size: 0.625rem; color: var(--text-muted); min-width: 20px; text-align: right; }

  /* ===== Finder ===== */
  .s-finder { font-size: 0.75rem; }
  .finder-header { display: grid; grid-template-columns: 2fr 80px 1fr 50px 80px; gap: 0.5rem; padding: 0.375rem 0.5rem; color: var(--text-muted); font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); }
  .finder-row { display: grid; grid-template-columns: 2fr 80px 1fr 50px 80px; gap: 0.5rem; padding: 0.375rem 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.03); align-items: center; transition: background 0.15s; }
  .finder-row:hover { background: rgba(41,151,255,0.04); }
  .finder-name { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .finder-size, .finder-dl, .finder-date { color: var(--text-muted); font-size: 0.6875rem; }
  .finder-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }

  /* ===== Notion ===== */
  .s-notion { display: flex; flex-direction: column; }
  .notion-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.03); font-size: 0.8125rem; transition: background 0.15s; }
  .notion-row:hover { background: rgba(255,255,255,0.02); }
  .notion-check { color: var(--text-muted); font-size: 0.875rem; cursor: pointer; }
  .notion-icon { flex-shrink: 0; }
  .notion-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .notion-tag { font-size: 0.5625rem; padding: 0.0625rem 0.375rem; border-radius: 3px; background: rgba(255,255,255,0.04); color: var(--text-muted); }
  .notion-meta { font-size: 0.6875rem; color: var(--text-muted); min-width: 50px; }
  .notion-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }

  /* ===== Linear ===== */
  .s-linear { display: flex; flex-direction: column; }
  .linear-row { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.625rem; border-radius: var(--radius-sm); transition: background 0.15s; font-size: 0.8125rem; }
  .linear-row:hover { background: rgba(255,255,255,0.03); }
  .linear-icon { flex-shrink: 0; }
  .linear-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
  .linear-ext { font-size: 0.5625rem; padding: 0.0625rem 0.3125rem; border-radius: 3px; background: rgba(255,255,255,0.04); color: var(--text-muted); font-weight: 600; }
  .linear-size { font-size: 0.6875rem; color: var(--text-muted); min-width: 50px; }
  .linear-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }
  .linear-dl { font-size: 0.625rem; color: var(--text-muted); min-width: 24px; text-align: right; }

  /* ===== Raycast ===== */
  .s-raycast { display: flex; flex-direction: column; gap: 2px; }
  .raycast-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-radius: var(--radius); transition: background 0.15s; }
  .raycast-row:hover { background: rgba(255,255,255,0.04); }
  .raycast-icon { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.04); border-radius: var(--radius-sm); flex-shrink: 0; }
  .raycast-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .raycast-name { font-size: 0.8125rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .raycast-sub { font-size: 0.6875rem; color: var(--text-muted); }
  .raycast-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }

  /* ===== GitHub ===== */
  .s-github { font-size: 0.75rem; }
  .gh-row { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.625rem; border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s; }
  .gh-row:hover { background: rgba(255,255,255,0.02); }
  .gh-icon { flex-shrink: 0; }
  .gh-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; color: #58a6ff; }
  .gh-hash { font-size: 0.625rem; font-family: monospace; color: var(--text-muted); background: rgba(255,255,255,0.04); padding: 0 0.25rem; border-radius: 3px; }
  .gh-size { font-size: 0.6875rem; color: var(--text-muted); min-width: 50px; }
  .gh-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }
  .gh-date { font-size: 0.6875rem; color: var(--text-muted); min-width: 60px; }

  /* ===== Vercel ===== */
  .s-vercel { display: flex; flex-direction: column; }
  .vercel-row { display: flex; align-items: center; justify-content: space-between; padding: 0.625rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s; }
  .vercel-row:hover { background: rgba(255,255,255,0.02); }
  .vercel-left { display: flex; align-items: center; gap: 0.625rem; }
  .vercel-name { font-size: 0.8125rem; font-weight: 500; }
  .vercel-right { display: flex; align-items: center; gap: 0.75rem; }
  .vercel-ext { font-size: 0.5625rem; padding: 0.0625rem 0.3125rem; border-radius: 3px; background: rgba(255,255,255,0.04); color: var(--text-muted); font-weight: 600; }
  .vercel-size { font-size: 0.6875rem; color: var(--text-muted); }
  .vercel-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }

  /* ===== Arc ===== */
  .s-arc { display: flex; flex-direction: column; gap: 4px; }
  .arc-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 0.875rem; border-radius: var(--radius); background: rgba(255,255,255,0.02); transition: all 0.15s; }
  .arc-row:hover { background: rgba(255,255,255,0.04); transform: translateX(2px); }
  .arc-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.04); border-radius: var(--radius-sm); flex-shrink: 0; }
  .arc-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .arc-name { font-size: 0.8125rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .arc-sub { font-size: 0.6875rem; color: var(--text-muted); }
  .arc-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }

  /* ===== Spotify ===== */
  .s-spotify { display: flex; flex-direction: column; }
  .sp-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.375rem 0.5rem; border-radius: var(--radius-sm); transition: background 0.15s; }
  .sp-row:hover { background: rgba(30,215,96,0.06); }
  .sp-num { font-size: 0.6875rem; color: var(--text-muted); min-width: 20px; font-variant-numeric: tabular-nums; }
  .sp-icon { flex-shrink: 0; }
  .sp-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.8125rem; font-weight: 500; }
  .sp-ext { font-size: 0.5625rem; padding: 0.0625rem 0.3125rem; border-radius: 3px; background: rgba(255,255,255,0.04); color: var(--text-muted); }
  .sp-dl { font-size: 0.6875rem; color: var(--text-muted); min-width: 24px; text-align: right; }
  .sp-link { font-size: 0.6875rem; color: #1ed760; font-family: monospace; }

  /* ===== iOS Settings ===== */
  .s-ios { display: flex; flex-direction: column; }
  .ios-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s; }
  .ios-row:hover { background: rgba(255,255,255,0.02); }
  .ios-icon { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 6px; flex-shrink: 0; }
  .ios-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .ios-name { font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ios-sub { font-size: 0.6875rem; color: var(--text-muted); }
  .ios-link { font-size: 0.6875rem; color: var(--primary); font-family: monospace; }
  .ios-arrow { font-size: 1.125rem; color: var(--text-muted); font-weight: 300; }
</style>
