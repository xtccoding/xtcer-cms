---
import Layout from '../../layouts/Layout.astro'
import { getAdminPath } from '../../lib/admin-path'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
const adminPath = getAdminPath()
if (cookie?.value === ADMIN_PASSWORD) return Astro.redirect(adminPath)

let error = ''
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const password = formData.get('password')
    if (password === ADMIN_PASSWORD) {
    const gallerySlug = crypto.randomUUID().replace(/-/g, '').substring(0, 12)
    const filesSlug = crypto.randomUUID().replace(/-/g, '').substring(0, 12)
    Astro.cookies.set('admin_auth', ADMIN_PASSWORD, { path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60*60*24*7 })
    Astro.cookies.set('gallery_slug', gallerySlug, { path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60*60*24*7 })
    Astro.cookies.set('files_slug', filesSlug, { path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60*60*24*7 })
    return Astro.redirect(adminPath)
  } else { error = '密码错误' }
}
---

<Layout title="登录 - XTCer">
  <div class="login-page">
    <div class="login-card">
      <div class="card-aurora" aria-hidden="true"></div>

      <div class="brand">
        <div class="brand-mark">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="10.5" width="16" height="10" rx="2.5"/>
            <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
            <circle cx="12" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <h1>XTCer</h1>
        <p class="subtitle">管理后台 · 请输入访问密码</p>
      </div>

      {error && (
        <div class="error" role="alert">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="13"/><line x1="12" y1="16.5" x2="12" y2="16.5"/>
          </svg>
          <span>{error}</span>
        </div>
      )}

      <form method="POST" id="login-form" novalidate>
        <div class="field">
          <span class="field-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <rect x="4" y="10.5" width="16" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
            </svg>
          </span>
          <input type="password" name="password" id="pwd" placeholder="密码" required autofocus
                 autocomplete="current-password" spellcheck="false" />
          <button type="button" class="toggle-eye" id="toggle" aria-label="显示密码" tabindex="-1">
            <svg class="eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
            </svg>
            <svg class="eye-off" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 3l18 18"/><path d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.2 3.9"/>
              <path d="M6.6 6.7A16.7 16.7 0 0 0 2 12s3.6 6 10 6a9.7 9.7 0 0 0 4.2-.9"/>
            </svg>
          </button>
        </div>

        <button type="submit" class="login-btn" id="submit-btn">
          <span class="btn-text">登录</span>
          <span class="spinner" aria-hidden="true"></span>
        </button>
      </form>

      <div class="card-foot">
        <a href="/" class="back-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          返回首页
        </a>
        <span class="foot-dot">·</span>
        <span class="foot-note">仅限授权访问</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  .login-card {
    position: relative;
    width: 100%;
    max-width: 396px;
    padding: 2.75rem 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 32px 64px -24px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    overflow: hidden;
    animation: cardIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* 顶部渐变高光条：和首页 banner 同款语言 */
  .login-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(41, 151, 255, 0.85), rgba(191, 90, 242, 0.85), transparent);
  }

  /* 卡内极光光晕 */
  .card-aurora {
    position: absolute;
    top: -170px;
    left: 50%;
    width: 320px;
    height: 320px;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(41, 151, 255, 0.28), rgba(191, 90, 242, 0.12) 45%, transparent 70%);
    filter: blur(18px);
    pointer-events: none;
  }

  .brand { text-align: center; margin-bottom: 1.75rem; position: relative; }

  .brand-mark {
    width: 52px;
    height: 52px;
    margin: 0 auto 0.875rem;
    display: grid;
    place-items: center;
    border-radius: 15px;
    color: #fff;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    box-shadow: 0 10px 28px -8px rgba(41, 151, 255, 0.6);
  }

  h1 {
    font-size: 1.4375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--text) 20%, var(--primary) 120%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    margin-top: 0.3125rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .error {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.5625rem 0.75rem;
    margin-bottom: 0.875rem;
    background: rgba(255, 69, 58, 0.1);
    border: 1px solid rgba(255, 69, 58, 0.28);
    border-radius: 10px;
    color: var(--red);
    font-size: 0.8125rem;
    animation: shake 0.42s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  form { display: flex; flex-direction: column; gap: 0.75rem; }

  .field { position: relative; }

  .field-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    color: var(--text-muted);
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .field input {
    width: 100%;
    height: 50px;
    padding: 0 46px 0 41px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, background 0.2s ease;
  }

  .field input::placeholder { color: var(--text-muted); letter-spacing: normal; }

  /* 焦点：边框变主色 + 双层光晕 + 图标点亮 */
  .field input:focus {
    background: rgba(41, 151, 255, 0.06);
    border-color: var(--primary);
    box-shadow:
      0 0 0 4px rgba(41, 151, 255, 0.14),
      0 0 26px -6px rgba(41, 151, 255, 0.65);
  }

  .field input:focus ~ .field-icon,
  .field input:focus + .field-icon { color: var(--primary); }

  .field:focus-within .field-icon { color: var(--primary); }

  .toggle-eye {
    position: absolute;
    right: 7px;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .toggle-eye:hover { color: var(--text); background: rgba(255, 255, 255, 0.07); }
  .toggle-eye .eye-off { display: none; }
  .toggle-eye.on .eye-open { display: none; }
  .toggle-eye.on .eye-off { display: block; }

  .login-btn {
    position: relative;
    height: 50px;
    display: grid;
    place-items: center;
    border: none;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 12px 30px -12px rgba(41, 151, 255, 0.75);
    transition: transform 0.2s ease, box-shadow 0.25s ease, filter 0.2s ease;
  }

  .login-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.07);
    box-shadow: 0 16px 38px -12px rgba(41, 151, 255, 0.9);
  }

  .login-btn:active { transform: translateY(0) scale(0.994); }

  .login-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(41, 151, 255, 0.35), 0 16px 38px -12px rgba(41, 151, 255, 0.9);
  }

  .login-btn.loading { cursor: progress; filter: saturate(0.75) brightness(0.95); }
  .login-btn.loading .btn-text { display: none; }

  .spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .login-btn.loading .spinner { display: block; }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    margin-top: 1.375rem;
    padding-top: 1.125rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-muted);
    transition: color 0.18s ease, gap 0.18s ease;
  }

  .back-link:hover { color: var(--primary); gap: 0.4375rem; }
  .foot-dot, .foot-note { color: var(--text-muted); opacity: 0.65; }

  /* 浅色主题适配 */
  :global(:root.light) .login-card {
    background: rgba(255, 255, 255, 0.72);
    border-color: rgba(0, 0, 0, 0.07);
    box-shadow: 0 32px 64px -28px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  :global(:root.light) .card-aurora { opacity: 0.5; }
  :global(:root.light) .field input { background: rgba(0, 0, 0, 0.02); border-color: rgba(0, 0, 0, 0.1); }
  :global(:root.light) .field input:focus { background: rgba(0, 113, 227, 0.05); }
  :global(:root.light) .card-foot { border-top-color: rgba(0, 0, 0, 0.06); }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(14px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  @keyframes shake {
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-4px); }
    40%, 60% { transform: translateX(4px); }
  }

  /* 空密码提交的抖动由 Web Animations API 负责（避免覆盖 cardIn 入场动画） */

  @media (max-width: 420px) {
    .login-card { padding: 2.125rem 1.5rem 1.375rem; border-radius: 16px; }
    h1 { font-size: 1.3125rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .login-card, .error, .spinner { animation: none; }
    .login-btn, .back-link { transition: none; }
  }
</style>

<script>
  const pwd = document.getElementById('pwd') as HTMLInputElement | null
  const toggle = document.getElementById('toggle')
  const form = document.getElementById('login-form')
  const submitBtn = document.getElementById('submit-btn')

  toggle?.addEventListener('click', () => {
    if (!pwd) return
    const show = pwd.type === 'password'
    pwd.type = show ? 'text' : 'password'
    toggle.classList.toggle('on', show)
    toggle.setAttribute('aria-label', show ? '隐藏密码' : '显示密码')
    pwd.focus()
  })

  form?.addEventListener('submit', (e) => {
    // 表单用了 novalidate（避免原生提示气泡破坏视觉），空值在这里兜住
    if (pwd && !pwd.value.trim()) {
      e.preventDefault()
      pwd.focus()
      // 用 WAAPI 而不是 CSS 类：卡片本身有 cardIn 入场动画，
      // 换成 class 会覆盖 animation 属性，移除后入场动画会重播一次
      document.querySelector('.login-card')?.animate(
        [
          { transform: 'translateX(0)' },
          { transform: 'translateX(-7px)' },
          { transform: 'translateX(6px)' },
          { transform: 'translateX(-4px)' },
          { transform: 'translateX(3px)' },
          { transform: 'translateX(0)' },
        ],
        { duration: 420, easing: 'cubic-bezier(0.36, 0.07, 0.19, 0.97)' }
      )
      return
    }
    // 原生 POST 提交，加 loading 态防止重复提交
    submitBtn?.classList.add('loading')
    if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true
  })
</script>
