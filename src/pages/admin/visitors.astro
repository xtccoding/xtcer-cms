---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'
import { supabase } from '../../lib/supabase'

const runtimeEnv = (Astro.locals as any)?.runtime?.env
const ADMIN_PASSWORD = runtimeEnv?.ADMIN_PASSWORD || import.meta.env.ADMIN_PASSWORD
if (!ADMIN_PASSWORD) return new Response('ADMIN_PASSWORD not configured', { status: 500 })
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')

const { data: blacklist } = await supabase.from('blacklist').select('*').order('created_at', { ascending: false })
---

<Layout title="访客管理 - XTCer">
  <div class="admin-layout">
    <Sidebar active="visitors" />
    <div class="admin-main">
      <header class="admin-header">
        <div>
          <h1>访客管理</h1>
          <p class="admin-subtitle">实时访客统计与黑名单管理</p>
        </div>
        <div class="range-btns">
          <button class="btn btn-ghost btn-sm" data-range="1d">今天</button>
          <button class="btn btn-ghost btn-sm active" data-range="7d">7天</button>
          <button class="btn btn-ghost btn-sm" data-range="30d">30天</button>
        </div>
      </header>

      <div class="stats-grid">
        <div class="stat-card glass-card">
          <div class="stat-label">总访问</div>
          <div class="stat-value" id="stat-total">-</div>
        </div>
        <div class="stat-card glass-card">
          <div class="stat-label">独立访客</div>
          <div class="stat-value" id="stat-unique">-</div>
        </div>
        <div class="stat-card glass-card">
          <div class="stat-label">热门页面</div>
          <div class="stat-value" id="stat-top">-</div>
        </div>
      </div>

      <div class="panels-grid">
        <section class="panel glass-card">
          <h2>热门页面</h2>
          <div id="top-pages" class="top-list"></div>
        </section>
        <section class="panel glass-card">
          <h2>访问趋势</h2>
          <div id="hourly-chart" class="chart"></div>
        </section>
      </div>

      <section class="panel glass-card" style="margin-top:1rem">
        <div class="panel-header">
          <h2>访问记录</h2>
          <div class="search-bar">
            <input type="text" id="ip-search" class="input" placeholder="搜索 IP..." style="width:180px" />
            <button class="btn btn-ghost btn-sm" id="search-btn">搜索</button>
            <button class="btn btn-ghost btn-sm" id="reset-btn" style="display:none">重置</button>
          </div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>IP</th><th>页面</th><th>来源</th><th>时间</th><th>操作</th></tr></thead>
            <tbody id="visitors-tbody"></tbody>
          </table>
        </div>
        <div class="pagination" id="pagination"></div>
      </section>

      <section class="panel glass-card" style="margin-top:1rem">
        <div class="panel-header">
          <h2>黑名单</h2>
          <button class="btn btn-ghost btn-sm" id="add-blacklist-btn">添加 IP</button>
        </div>
        <div id="blacklist-add" style="display:none;margin-bottom:1rem">
          <div style="display:flex;gap:0.5rem">
            <input type="text" id="bl-ip" class="input" placeholder="IP 地址" style="max-width:200px" />
            <input type="text" id="bl-reason" class="input" placeholder="原因（可选）" style="max-width:250px" />
            <button class="btn btn-primary btn-sm" id="bl-save">添加</button>
          </div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>IP</th><th>原因</th><th>添加时间</th><th>操作</th></tr></thead>
            <tbody id="blacklist-tbody">
              {blacklist?.map((item) => (
                <tr data-bl-id={item.id}>
                  <td><code>{item.ip}</code></td>
                  <td>{item.reason || '-'}</td>
                  <td>{new Date(item.created_at).toLocaleDateString('zh-CN')}</td>
                  <td><button class="btn btn-danger btn-sm bl-remove" data-id={item.id}>移除</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>

  <script>
    let currentRange = '7d'
    let currentPage = 1
    let currentSearch = ''

    async function loadStats(range, page = 1, ip = '') {
      currentRange = range
      currentPage = page
      currentSearch = ip

      const params = new URLSearchParams({ range, page: String(page), limit: '50' })
      if (ip) params.set('ip', ip)

      const res = await fetch(`/api/visitors?${params}`)
      const data = await res.json()

      document.getElementById('stat-total')!.textContent = (data.total || 0).toLocaleString()
      document.getElementById('stat-unique')!.textContent = (data.unique || 0).toLocaleString()
      document.getElementById('stat-top')!.textContent = data.topPages?.[0]?.path || '-'

      const topEl = document.getElementById('top-pages')!
      topEl.innerHTML = (data.topPages || []).map(p =>
        `<div class="top-item"><span class="top-path">${p.path}</span><span class="top-count">${p.count}</span></div>`
      ).join('') || '<div class="top-item"><span class="top-path">暂无数据</span></div>'

      const maxH = Math.max(...Object.values(data.hourlyCounts || {}) as number[], 1)
      const chartEl = document.getElementById('hourly-chart')!
      chartEl.innerHTML = Array.from({ length: 24 }, (_, i) => {
        const count = (data.hourlyCounts || {})[i] || 0
        const pct = Math.round((count / maxH) * 100)
        return `<div class="bar-col"><div class="bar" style="height:${pct}%"></div><span class="bar-label">${i}</span></div>`
      }).join('')

      const tbody = document.getElementById('visitors-tbody')!
      tbody.innerHTML = (data.recent || []).map((v: any) =>
        `<tr>
          <td><code>${v.ip || '-'}</code></td>
          <td class="td-path">${v.path}</td>
          <td class="td-muted">${v.referer ? v.referer.substring(0, 30) + '...' : '-'}</td>
          <td class="td-muted td-time">${new Date(v.created_at).toLocaleString('zh-CN')}</td>
          <td><button class="btn btn-danger btn-sm bl-add-from-visit" data-ip="${v.ip}">拉黑</button></td>
        </tr>`
      ).join('') || '<tr><td colspan="5" class="td-muted" style="text-align:center;padding:2rem">暂无数据</td></tr>'

      // Pagination
      const paginationEl = document.getElementById('pagination')!
      const totalPages = data.totalPages || 1
      if (totalPages <= 1) {
        paginationEl.innerHTML = ''
        return
      }

      let paginationHtml = `<span class="page-info">第 ${data.page}/${totalPages} 页，共 ${data.total} 条</span><div class="page-btns">`
      if (data.page > 1) {
        paginationHtml += `<button class="btn btn-ghost btn-sm page-btn" data-page="${data.page - 1}">上一页</button>`
      }
      if (data.page < totalPages) {
        paginationHtml += `<button class="btn btn-ghost btn-sm page-btn" data-page="${data.page + 1}">下一页</button>`
      }
      paginationHtml += `</div>`
      paginationEl.innerHTML = paginationHtml
    }

    // Range buttons
    document.querySelectorAll('[data-range]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-range]').forEach(b => b.classList.remove('active'))
        btn.classList.add('active')
        loadStats((btn as HTMLElement).dataset.range!, 1, currentSearch)
      })
    })

    // IP search
    const searchInput = document.getElementById('ip-search') as HTMLInputElement
    const searchBtn = document.getElementById('search-btn')!
    const resetBtn = document.getElementById('reset-btn')!

    searchBtn.addEventListener('click', () => {
      const ip = searchInput.value.trim()
      if (ip) {
        resetBtn.style.display = ''
        loadStats(currentRange, 1, ip)
      }
    })

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchBtn.click()
    })

    resetBtn.addEventListener('click', () => {
      searchInput.value = ''
      resetBtn.style.display = 'none'
      loadStats(currentRange, 1)
    })

    // Pagination clicks
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      if (target.classList.contains('page-btn')) {
        const page = parseInt(target.dataset.page || '1')
        loadStats(currentRange, page, currentSearch)
        document.getElementById('pagination')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }
    })

    // Blacklist
    document.getElementById('add-blacklist-btn')?.addEventListener('click', () => {
      const el = document.getElementById('blacklist-add')!
      el.style.display = el.style.display === 'none' ? 'block' : 'none'
    })

    document.getElementById('bl-save')?.addEventListener('click', async () => {
      const ip = (document.getElementById('bl-ip') as HTMLInputElement)?.value.trim()
      const reason = (document.getElementById('bl-reason') as HTMLInputElement)?.value.trim()
      if (!ip) return
      const res = await fetch('/api/blacklist', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ip, reason }) })
      if (res.ok) location.reload()
    })

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement
      if (target.classList.contains('bl-add-from-visit')) {
        const ip = target.dataset.ip
        if (!ip || ip === 'unknown') return
        await fetch('/api/blacklist', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ip }) })
        location.reload()
      }
      if (target.classList.contains('bl-remove')) {
        const id = target.dataset.id
        await fetch(`/api/blacklist?id=${id}`, { method: 'DELETE' })
        target.closest('tr')?.remove()
      }
    })

    loadStats('7d')
  </script>
</Layout>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: 200px; padding: 1.5rem; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .admin-header h1 { font-size: 1.5rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.125rem; }
  .range-btns { display: flex; gap: 0.25rem; }
  .range-btns .btn.active { background: var(--primary); color: white; border-color: var(--primary); }

  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 1rem; }
  .stat-card { padding: 1.25rem; }
  .stat-label { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.375rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .stat-value { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; }

  .panels-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 0.75rem; }
  .panel { padding: 1.25rem; }
  .panel h2 { font-size: 0.9375rem; font-weight: 600; margin-bottom: 1rem; }
  .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem; }
  .panel-header h2 { margin-bottom: 0; }

  .search-bar { display: flex; gap: 0.5rem; align-items: center; }

  .top-list { display: flex; flex-direction: column; gap: 0.375rem; }
  .top-item { display: flex; justify-content: space-between; align-items: center; padding: 0.375rem 0; border-bottom: 1px solid var(--border); }
  .top-path { font-size: 0.8125rem; color: var(--text-secondary); }
  .top-count { font-size: 0.8125rem; font-weight: 600; color: var(--primary); }

  .chart { display: flex; align-items: flex-end; gap: 0.25rem; height: 120px; }
  .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; height: 100%; justify-content: flex-end; }
  .bar { width: 100%; background: var(--primary); border-radius: 2px 2px 0 0; min-height: 2px; transition: height 0.3s; opacity: 0.7; }
  .bar-label { font-size: 0.625rem; color: var(--text-muted); }

  .table-wrap { overflow-x: auto; }
  .table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  .table th { text-align: left; padding: 0.625rem 0.75rem; color: var(--text-muted); font-weight: 500; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); }
  .table td { padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--border); }
  .table td code { font-size: 0.75rem; background: rgba(255,255,255,0.04); padding: 0.125rem 0.375rem; border-radius: 3px; }
  .td-muted { color: var(--text-muted); }
  .td-path { max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .td-time { white-space: nowrap; }

  .pagination { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .page-info { font-size: 0.75rem; color: var(--text-muted); }
  .page-btns { display: flex; gap: 0.5rem; }

  @media (max-width: 768px) {
    .admin-main { margin-left: 0; padding: 1rem; }
    .admin-header { flex-direction: column; gap: 0.75rem; }
    .stats-grid { grid-template-columns: 1fr; }
    .panels-grid { grid-template-columns: 1fr; }
    .search-bar { width: 100%; }
    .search-bar .input { flex: 1; width: auto; }
    .panel-header { flex-direction: column; align-items: stretch; }
    .td-path { max-width: 120px; }
    .td-time { font-size: 0.6875rem; }
    .pagination { flex-direction: column; gap: 0.5rem; }
  }
</style>
