---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase'

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || 'xtcer2024'
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) return Astro.redirect('/admin/login')

const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false })
---

<Layout title="文章管理 - XTCer">
  <div class="admin-layout">
    <aside class="sidebar glass-card">
      <div class="sidebar-brand">
        <a href="/" class="nav-logo">XTCer</a>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="sidebar-link active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          文章管理
        </a>
        <a href="/admin/new" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14m-7-7h14"/></svg>
          新建文章
        </a>
        <div class="sidebar-divider"></div>
        <a href="/admin" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
          设置
        </a>
        <a href="/admin/logout" class="sidebar-link logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4m7 14l5-5-5-5m5 5H9"/></svg>
          退出
        </a>
      </nav>
    </aside>

    <div class="admin-main">
      <header class="admin-header">
        <div>
          <h1>文章管理</h1>
          <p class="admin-subtitle">{posts?.length || 0} 篇文章</p>
        </div>
        <a href="/admin/new" class="btn btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14m-7-7h14"/></svg>
          新建
        </a>
      </header>

      <div class="search-box glass-card">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search" class="search-input" placeholder="搜索文章..." />
      </div>

      <div class="posts-list" id="posts-list">
        {posts && posts.length > 0 ? posts.map((post) => (
          <div class="post-row glass-card" data-id={post.id} data-title={post.title.toLowerCase()}>
            <div class="post-row-body">
              <h3>{post.title}</h3>
              <p>{post.content?.replace(/<[^>]*>/g, '').substring(0, 100)}</p>
              <div class="post-row-meta">
                <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                <span>·</span>
                <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟阅读</span>
              </div>
            </div>
            <div class="post-row-actions">
              <a href={`/admin/edit/${post.id}`} class="btn btn-ghost btn-sm btn-icon" title="编辑">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              <a href={`/posts/${post.id}`} target="_blank" class="btn btn-ghost btn-sm btn-icon" title="查看">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <button class="btn btn-danger btn-sm btn-icon delete-btn" data-id={post.id} data-title={post.title} title="删除">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
              </button>
            </div>
          </div>
        )) : (
          <div class="empty glass-card">
            <p>还没有文章</p>
            <a href="/admin/new" class="btn btn-primary">创建第一篇</a>
          </div>
        )}
      </div>
    </div>
  </div>

  <div id="delete-modal" class="modal" style="display:none">
    <div class="modal-backdrop"></div>
    <div class="modal-content glass-card">
      <h3>确认删除</h3>
      <p>确定要删除「<span id="delete-title"></span>」吗？</p>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancel-delete">取消</button>
        <button class="btn btn-danger" id="confirm-delete">删除</button>
      </div>
    </div>
  </div>

  <script>
    let deleteId = ''
    document.getElementById('search')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase()
      document.querySelectorAll('.post-row').forEach(el => {
        ;(el as HTMLElement).style.display = (el as HTMLElement).dataset.title!.includes(q) ? '' : 'none'
      })
    })
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        deleteId = (btn as HTMLElement).dataset.id || ''
        document.getElementById('delete-title')!.textContent = (btn as HTMLElement).dataset.title || ''
        document.getElementById('delete-modal')!.style.display = 'flex'
      })
    })
    document.getElementById('cancel-delete')?.addEventListener('click', () => { document.getElementById('delete-modal')!.style.display = 'none' })
    document.querySelector('.modal-backdrop')?.addEventListener('click', () => { document.getElementById('delete-modal')!.style.display = 'none' })
    document.getElementById('confirm-delete')?.addEventListener('click', async () => {
      if (!deleteId) return
      const res = await fetch(`/api/posts/${deleteId}`, { method: 'DELETE' })
      if (res.ok) {
        document.querySelector(`[data-id="${deleteId}"]`)?.remove()
        document.getElementById('delete-modal')!.style.display = 'none'
        deleteId = ''
      }
    })
  </script>
</Layout>

<style>
  .admin-layout {
    display: flex; min-height: 100vh;
  }
  .sidebar {
    width: 220px; flex-shrink: 0; padding: 1.5rem 1rem;
    position: fixed; top: 0; bottom: 0; left: 0;
    border-radius: 0; border-left: none; border-top: none; border-bottom: none;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px);
    display: flex; flex-direction: column;
  }
  .sidebar-brand { padding: 0 0.5rem; margin-bottom: 2rem; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 0.125rem; flex: 1; }
  .sidebar-link {
    display: flex; align-items: center; gap: 0.625rem;
    padding: 0.5rem 0.625rem; border-radius: var(--radius-sm);
    color: var(--text-muted); font-size: 0.8125rem; transition: all 0.15s;
  }
  .sidebar-link:hover { color: var(--text); background: var(--surface); }
  .sidebar-link.active { color: var(--primary); background: rgba(41,151,255,0.08); }
  .sidebar-divider { height: 1px; background: var(--border); margin: 0.5rem 0; }
  .sidebar-link.logout { color: var(--red); margin-top: auto; }
  .sidebar-link.logout:hover { background: rgba(255,69,58,0.08); }

  .admin-main { flex: 1; margin-left: 220px; padding: 2rem; }
  .admin-header {
    display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;
  }
  .admin-header h1 { font-size: 1.5rem; font-weight: 700; }
  .admin-subtitle { color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.125rem; }

  .search-box {
    display: flex; align-items: center; gap: 0.625rem;
    padding: 0.625rem 0.875rem; margin-bottom: 1rem;
  }
  .search-input {
    flex: 1; background: none; border: none; color: var(--text);
    font-size: 0.8125rem; outline: none; font-family: inherit;
  }
  .search-input::placeholder { color: var(--text-muted); }

  .posts-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .post-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 1rem 1.25rem;
  }
  .post-row-body { flex: 1; min-width: 0; }
  .post-row-body h3 {
    font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.25rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .post-row-body p {
    color: var(--text-secondary); font-size: 0.8125rem; margin-bottom: 0.375rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .post-row-meta { display: flex; gap: 0.5rem; font-size: 0.75rem; color: var(--text-muted); }
  .post-row-actions { display: flex; gap: 0.25rem; flex-shrink: 0; }

  .empty { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 4rem; text-align: center; }
  .empty p { color: var(--text-muted); }

  .modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); }
  .modal-content { position: relative; z-index: 1; width: 100%; max-width: 400px; padding: 2rem; }
  .modal-content h3 { font-size: 1.125rem; margin-bottom: 0.75rem; }
  .modal-content p { color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem; }
  .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; }

  @media (max-width: 768px) {
    .sidebar { display: none; }
    .admin-main { margin-left: 0; }
    .post-row { flex-direction: column; align-items: flex-start; }
  }
</style>
