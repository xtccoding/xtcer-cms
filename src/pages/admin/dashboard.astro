---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase'

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || 'xtcer2024'
const cookie = Astro.cookies.get('admin_auth')
if (cookie?.value !== ADMIN_PASSWORD) {
  return Astro.redirect('/admin/login')
}

const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false })
---

<Layout title="文章管理 - XTCer">
  <main class="admin-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/" class="logo">XTCer</a>
        <span class="version">v1.0</span>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="nav-item active">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          仪表盘
        </a>
        <a href="/admin/dashboard" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          文章管理
        </a>
        <a href="/admin/new" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14m-7-7h14"/></svg>
          新建文章
        </a>
        <div class="nav-divider"></div>
        <span class="nav-label">系统</span>
        <a href="/admin" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
          初始化设置
        </a>
        <div class="nav-divider"></div>
        <a href="/admin/logout" class="nav-item logout">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4m7 14l5-5-5-5m5 5H9"/></svg>
          退出登录
        </a>
      </nav>
    </aside>

    <div class="main-content">
      <header class="content-header">
        <div>
          <h1>文章管理</h1>
          <p class="subtitle">共 {posts?.length || 0} 篇文章</p>
        </div>
        <a href="/admin/new" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14m-7-7h14"/></svg>
          新建文章
        </a>
      </header>

      <div class="search-bar glass-card">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search" class="search-input" placeholder="搜索文章..." />
      </div>

      <div class="posts-grid" id="posts-grid">
        {posts && posts.length > 0 ? posts.map((post) => (
          <div class="post-item glass-card" data-id={post.id} data-title={post.title.toLowerCase()}>
            <div class="post-color" style={`background: ${['var(--primary)', 'var(--accent)', 'var(--green)', 'var(--orange)'][Math.floor(Math.random() * 4)]}`}></div>
            <div class="post-info">
              <h3>{post.title}</h3>
              <p>{post.content?.replace(/<[^>]*>/g, '').substring(0, 100)}</p>
              <div class="post-meta">
                <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                <span class="dot">·</span>
                <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟阅读</span>
              </div>
            </div>
            <div class="post-actions">
              <a href={`/admin/edit/${post.id}`} class="btn btn-ghost btn-icon" title="编辑">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              <a href={`/posts/${post.id}`} target="_blank" class="btn btn-ghost btn-icon" title="查看">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <button class="btn btn-danger btn-icon delete-btn" data-id={post.id} data-title={post.title} title="删除">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
              </button>
            </div>
          </div>
        )) : (
          <div class="empty-state glass-card">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="color:var(--text-muted)"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <p>还没有文章</p>
            <a href="/admin/new" class="btn btn-primary">创建第一篇</a>
          </div>
        )}
      </div>
    </div>
  </main>

  <div id="delete-modal" class="modal" style="display:none">
    <div class="modal-backdrop"></div>
    <div class="modal-content glass-card">
      <h3>确认删除</h3>
      <p>确定要删除「<span id="delete-title"></span>」吗？此操作不可撤销。</p>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancel-delete">取消</button>
        <button class="btn btn-danger" id="confirm-delete">删除</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  let deleteId = ''

  document.getElementById('search')?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase()
    document.querySelectorAll('.post-item').forEach(item => {
      const title = (item as HTMLElement).dataset.title || ''
      const el = item as HTMLElement
      el.style.display = title.includes(query) ? 'flex' : 'none'
    })
  })

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      deleteId = (btn as HTMLElement).dataset.id || ''
      const title = (btn as HTMLElement).dataset.title || ''
      document.getElementById('delete-title')!.textContent = title
      document.getElementById('delete-modal')!.style.display = 'flex'
    })
  })

  document.getElementById('cancel-delete')?.addEventListener('click', () => {
    document.getElementById('delete-modal')!.style.display = 'none'
  })

  document.querySelector('.modal-backdrop')?.addEventListener('click', () => {
    document.getElementById('delete-modal')!.style.display = 'none'
  })

  document.getElementById('confirm-delete')?.addEventListener('click', async () => {
    if (!deleteId) return
    const btn = document.getElementById('confirm-delete') as HTMLButtonElement
    btn.textContent = '删除中...'
    btn.disabled = true

    const res = await fetch(`/api/posts/${deleteId}`, { method: 'DELETE' })
    if (res.ok) {
      const el = document.querySelector(`[data-id="${deleteId}"]`)
      el?.classList.add('fade-out')
      setTimeout(() => el?.remove(), 300)
      document.getElementById('delete-modal')!.style.display = 'none'
    }
    btn.textContent = '删除'
    btn.disabled = false
    deleteId = ''
  })
</script>

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .sidebar {
    width: 240px; flex-shrink: 0; background: rgba(0,0,0,0.5);
    backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px);
    border-right: 1px solid var(--glass-border); padding: 1.5rem 0;
    position: fixed; top: 0; bottom: 0; left: 0; z-index: 50;
  }
  .sidebar-header { padding: 0 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem; }
  .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); }
  .version { font-size: 0.6875rem; color: var(--text-muted); background: var(--surface); padding: 0.125rem 0.5rem; border-radius: 999px; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 0.125rem; padding: 0 0.75rem; }
  .nav-item {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.5rem 0.75rem; border-radius: var(--radius-sm);
    color: var(--text-muted); font-size: 0.875rem; transition: all 0.15s;
  }
  .nav-item:hover { color: var(--text); background: var(--surface); }
  .nav-item.active { color: var(--primary); background: rgba(41,151,255,0.1); }
  .nav-label { font-size: 0.6875rem; color: var(--text-muted); padding: 0.5rem 0.75rem 0.25rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .nav-divider { height: 1px; background: var(--border); margin: 0.5rem 0; }
  .nav-item.logout { color: var(--red); }
  .nav-item.logout:hover { background: rgba(255,69,58,0.1); }

  .main-content { flex: 1; margin-left: 240px; padding: 2rem; }
  .content-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .content-header h1 { font-size: 1.75rem; font-weight: 700; }
  .subtitle { color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem; }

  .search-bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; margin-bottom: 1rem; }
  .search-input {
    flex: 1; background: none; border: none; color: var(--text); font-size: 0.875rem;
    outline: none; font-family: inherit;
  }
  .search-input::placeholder { color: var(--text-muted); }

  .posts-grid { display: flex; flex-direction: column; gap: 0.5rem; }
  .post-item {
    display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem;
  }
  .post-color { width: 4px; height: 40px; border-radius: 2px; flex-shrink: 0; }
  .post-info { flex: 1; min-width: 0; }
  .post-info h3 { font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .post-info p { color: var(--text-muted); font-size: 0.8125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 0.375rem; }
  .post-meta { display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--text-muted); }
  .dot { opacity: 0.5; }
  .post-actions { display: flex; gap: 0.375rem; flex-shrink: 0; }
  .btn-icon { padding: 0.5rem; }

  .empty-state { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 4rem 2rem; text-align: center; }
  .empty-state p { color: var(--text-muted); }

  .modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); }
  .modal-content { position: relative; z-index: 1; width: 100%; max-width: 400px; padding: 2rem; }
  .modal-content h3 { font-size: 1.125rem; margin-bottom: 0.75rem; }
  .modal-content p { color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem; }
  .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; }

  :global(.fade-out) { opacity: 0; transform: translateX(20px); transition: all 0.3s; }

  @media (max-width: 768px) {
    .sidebar { display: none; }
    .main-content { margin-left: 0; }
    .post-item { flex-direction: column; align-items: flex-start; }
    .post-color { width: 100%; height: 3px; }
  }
</style>
