---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase'

const { id } = Astro.params
const { data: post } = await supabase
  .from('posts')
  .select('*')
  .eq('id', id)
  .single()

if (!post) {
  return Astro.redirect('/')
}
---

<Layout title={`${post.title} - XTCer`}>
  <main>
    <nav class="glass-nav">
      <div class="nav-content">
        <a href="/" class="logo">XTCer</a>
      </div>
    </nav>

    <article class="post">
      <header>
        <a href="/" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          返回
        </a>
        <h1>{post.title}</h1>
        <div class="post-meta">
          <time>{new Date(post.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span>·</span>
          <span>{Math.ceil((post.content?.replace(/<[^>]*>/g, '').length || 0) / 400)} 分钟阅读</span>
        </div>
      </header>
      <div class="content markdown-body" set:html={post.content}>
      </div>
    </article>
  </main>
</Layout>

<style>
  .glass-nav {
    position: fixed; top: 1rem; left: 50%; transform: translateX(-50%);
    width: calc(100% - 2rem); max-width: 600px;
    background: rgba(255,255,255,0.05); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08); border-radius: 999px;
    z-index: 100; padding: 0.75rem 1.5rem;
  }
  .nav-content { display: flex; justify-content: center; }
  .logo { font-size: 1rem; font-weight: 600; color: var(--text); }

  .post { max-width: 640px; margin: 0 auto; padding: 8rem 2rem 4rem; }

  .back-link {
    display: inline-flex; align-items: center; gap: 0.375rem;
    color: var(--text-muted); font-size: 0.8125rem; margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }

  header h1 {
    font-size: 2.25rem; font-weight: 700; margin-bottom: 0.75rem;
    letter-spacing: -0.02em; line-height: 1.2;
  }

  .post-meta {
    display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-muted);
    padding-bottom: 2rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem;
  }

  .content {
    font-size: 1.0625rem; line-height: 1.8; color: var(--text-muted);
  }

  .content :global(h2) {
    font-size: 1.5rem; color: var(--text); margin: 2.5rem 0 1rem;
    letter-spacing: -0.01em;
  }
  .content :global(h3) {
    font-size: 1.25rem; color: var(--text); margin: 2rem 0 0.75rem;
  }
  .content :global(p) { margin-bottom: 1.25rem; }
  .content :global(a) { color: var(--primary); }
  .content :global(strong) { color: var(--text); font-weight: 600; }
  .content :global(ul), .content :global(ol) { margin: 1.25rem 0; padding-left: 1.5rem; }
  .content :global(li) { margin-bottom: 0.5rem; }
  .content :global(blockquote) {
    border-left: 3px solid var(--primary); padding-left: 1.25rem; margin: 1.5rem 0;
    font-style: italic;
  }
  .content :global(code) {
    background: rgba(255,255,255,0.06); padding: 0.15rem 0.4rem;
    border-radius: 4px; font-size: 0.875em;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .content :global(pre) {
    background: rgba(0,0,0,0.4); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 1.25rem; overflow-x: auto;
    margin: 1.5rem 0;
  }
  .content :global(pre code) { background: none; padding: 0; }
  .content :global(hr) {
    border: none; height: 1px; background: var(--border); margin: 2rem 0;
  }
  .content :global(img) {
    max-width: 100%; border-radius: var(--radius-sm); margin: 1.5rem 0;
  }
</style>
