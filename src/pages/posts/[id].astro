---
import Layout from '../../layouts/Layout.astro'
import { supabase } from '../../lib/supabase'
import { marked } from 'marked'

const { id } = Astro.params
const { data: post } = await supabase
  .from('posts')
  .select('*')
  .eq('id', id)
  .single()

if (!post) return Astro.redirect('/')

const htmlContent = marked.parse(post.content || '')
const plainText = (post.content || '').replace(/[#*_`~\[\]>|]/g, '').replace(/\n+/g, ' ').trim()
const wordCount = plainText.length
const readTime = Math.max(1, Math.ceil(wordCount / 400))
const description = plainText.substring(0, 160)
const views = post.views || 0
---

<Layout title={`${post.title} - XTCer`} description={description}>
  <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">XTCer</a>
      </div>
  </nav>

  <main class="article-page">
    <article class="article container">
      <header class="article-header">
        <a href="/" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          返回首页
        </a>
        <h1>{post.title}</h1>
        <div class="article-meta">
          <time>{new Date(post.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span>·</span>
          <span>{readTime} 分钟阅读</span>
          <span>·</span>
          <span>{wordCount} 字</span>
          <span>·</span>
          <span id="view-count">{views} 次浏览</span>
        </div>
      </header>
      <div class="article-content markdown-body" set:html={htmlContent}></div>

      <section class="comments-section">
        <h2>评论</h2>
        <div class="giscus"></div>
      </section>
    </article>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <span>© 2026 XTCer</span>
        <div class="footer-links">
          <a href="/privacy">隐私政策</a>
          <a href="/tos">服务条款</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const postId = window.location.pathname.split('/').pop()
    fetch('/api/posts/views', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: postId }),
    }).then(r => r.json()).then(data => {
      if (data.views) document.getElementById('view-count')!.textContent = data.views + ' 次浏览'
    }).catch(() => {})

    const script = document.createElement('script')
    script.src = 'https://giscus.app/client.js'
    script.setAttribute('data-repo', 'xtccoding/xtcer-cms')
    script.setAttribute('data-repo-id', '')
    script.setAttribute('data-category', 'Announcements')
    script.setAttribute('data-category-id', '')
    script.setAttribute('data-mapping', 'pathname')
    script.setAttribute('data-strict', '0')
    script.setAttribute('data-reactions-enabled', '1')
    script.setAttribute('data-emit-metadata', '0')
    script.setAttribute('data-input-position', 'top')
    script.setAttribute('data-theme', 'dark')
    script.setAttribute('data-lang', 'zh-CN')
    script.setAttribute('crossorigin', 'anonymous')
    script.async = true
    document.querySelector('.giscus')?.appendChild(script)
  </script>
</Layout>

<style>
  .article-page { padding: 2rem 0 4rem; }

  .article-header {
    margin-bottom: 3rem; padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .back-link {
    display: inline-flex; align-items: center; gap: 0.375rem;
    color: var(--text-muted); font-size: 0.8125rem; margin-bottom: 1.5rem;
  }
  .back-link:hover { color: var(--text); }
  .article-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 1rem;
  }
  .article-meta {
    display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-muted);
  }

  .article-content {
    max-width: 720px; font-size: 1.0625rem; line-height: 1.85; color: var(--text-secondary);
  }
  .article-content :global(h1) { font-size: 1.75rem; color: var(--text); margin: 2rem 0 0.75rem; }
  .article-content :global(h2) {
    font-size: 1.5rem; color: var(--text); margin: 2.5rem 0 1rem; letter-spacing: -0.01em;
  }
  .article-content :global(h3) { font-size: 1.25rem; color: var(--text); margin: 2rem 0 0.75rem; }
  .article-content :global(h4) { font-size: 1.125rem; color: var(--text); margin: 1.5rem 0 0.5rem; }
  .article-content :global(p) { margin-bottom: 1.25rem; }
  .article-content :global(strong) { color: var(--text); font-weight: 600; }
  .article-content :global(em) { font-style: italic; }
  .article-content :global(a) { color: var(--primary); text-decoration: underline; text-underline-offset: 2px; }
  .article-content :global(ul), .article-content :global(ol) { margin: 1.25rem 0; padding-left: 1.5rem; }
  .article-content :global(li) { margin-bottom: 0.5rem; }
  .article-content :global(blockquote) {
    border-left: 3px solid var(--primary); padding-left: 1.25rem; margin: 1.5rem 0; font-style: italic;
  }
  .article-content :global(code) {
    background: rgba(255,255,255,0.06); padding: 0.15rem 0.4rem;
    border-radius: 4px; font-size: 0.875em;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
  .article-content :global(pre) {
    background: rgba(255,255,255,0.03); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 1.25rem; overflow-x: auto; margin: 1.5rem 0;
  }
  .article-content :global(pre code) { background: none; padding: 0; font-size: 0.8125rem; }
  .article-content :global(hr) { border: none; height: 1px; background: var(--border); margin: 2rem 0; }
  .article-content :global(img) { max-width: 100%; border-radius: var(--radius-sm); margin: 1.5rem 0; }
  .article-content :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
  .article-content :global(th), .article-content :global(td) { padding: 0.625rem 0.875rem; border: 1px solid var(--border); text-align: left; }
  .article-content :global(th) { background: rgba(255,255,255,0.03); font-weight: 600; color: var(--text); }
  .article-content :global(td) { color: var(--text-secondary); }

  .comments-section {
    max-width: 720px; margin-top: 3rem; padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .comments-section h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem; }

  .footer { border-top: 1px solid var(--border); padding: 2rem 0; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-muted); }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); }

  @media (max-width: 640px) {
    .article-page { padding: 1rem 0 3rem; }
    .article-meta { flex-wrap: wrap; }
    .footer-inner { flex-direction: column; gap: 1rem; }
  }
</style>
